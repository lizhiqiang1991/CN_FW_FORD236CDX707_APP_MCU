                  <addressOffset>0x78</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>CLOCKCOUNTEROVERFLOW</name>
                      <description>This bit is set if ClockCounter overflows.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>IBOACTIVECOUNTER</name>
                  <description>One of BlitEng Utilization Measurement registers.</description>
                  <addressOffset>0x7C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>IBOACTIVECOUNTER</name>
                      <description>The internal LBO counter is incremented with each 16th clock cycle when BlitEng is executing IBO operation and when BlitEngUtilizationMeasurementEn is set. This field is updated with SaveAndResetMeasurements pulse and internal counter is reset.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LBOACTIVECOUNTER</name>
                  <description>One of BlitEng Utilization Measurement registers.</description>
                  <addressOffset>0x80</addressOffset>
