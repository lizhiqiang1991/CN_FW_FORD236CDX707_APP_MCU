                        <enumeratedValue>
                          <name>EXTDST1</name>
                          <description>layerblend5 module is used from extdst1 processing path</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>EXTDST5</name>
