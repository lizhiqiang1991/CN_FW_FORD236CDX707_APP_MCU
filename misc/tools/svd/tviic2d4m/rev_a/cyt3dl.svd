                <resetValue>0x0</resetValue>
                <resetMask>0x0</resetMask>
                <fields>
                  <field>
                    <name>TASKBUFFERDONE</name>
                    <description>Each bit corresponds to one task buffer. '1' means that the ExecOffset equals to the StopOffset</description>
                    <bitRange>[7:0]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>TASKBUFFERSYNC</name>
                    <description>Each bit corresponds to one task buffer. '1' means that the scheduling of corresponding TB is blocked until some SW or HW state is reached.</description>
                    <bitRange>[15:8]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>SCHEDULERACTIVETB</name>
                    <description>Task buffer being executed in scheduler. If scheduler is in idle state, the value of this field is not valid.</description>
                    <bitRange>[18:16]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>SCHEDULERIDLE</name>
                    <description>Scheduler is not processing any instructions and there are no outstanding AXI transactions.</description>
                    <bitRange>[19:19]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>FETCHEDACTIVETB</name>
                    <description>Task buffer being fetch last in programmer. If programmer is in idle state, the value of this field is not valid.</description>
                    <bitRange>[22:20]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>REQUESTEDAXITRANSACTIONS</name>
                    <description>There are some outstanding axi transactions that have been requested but are not received yet.</description>
                    <bitRange>[23:23]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>PROGRAMMERSTATE</name>
                    <description>Execution state of programmer</description>
                    <bitRange>[25:24]</bitRange>
                    <access>read-only</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>IDLE</name>
                        <description>When all fetched instructions have been executed and there are no functions scheduled for the execution</description>
                        <value>0</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>SYNC</name>
                        <description>During execution of the SYNC instruction</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>ACTIVE</name>
                        <description>Execution of instructions</description>
                        <value>2</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>AXI_WAIT</name>
                        <description>There is function scheduled for the execution, but the internal instruction buffer is empty.</description>
                        <value>3</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>CMDSEQIDLE</name>
