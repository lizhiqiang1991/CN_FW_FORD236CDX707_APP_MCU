                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>KICK</name>
                      <description>Software kick, forces a kick signal independent of KICK_MODE. Write 1 to send kick.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>STATUS</name>
                  <description>External Destination Unit current status</description>
                  <addressOffset>0xC</addressOffset>
