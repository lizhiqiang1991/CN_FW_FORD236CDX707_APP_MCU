                          <name>SECONDARY</name>
                          <description>Load shadows with shadow load token on secondary input (foreground plane).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BOTH</name>
                          <description>Load shadows with shadow load token on any input.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>SHDTOKSEL</name>
                      <description>Controls when a shadow load token is generated on the output port, which controls shadow load in subsequent processing units.</description>
                      <bitRange>[4:3]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PRIMARY</name>
