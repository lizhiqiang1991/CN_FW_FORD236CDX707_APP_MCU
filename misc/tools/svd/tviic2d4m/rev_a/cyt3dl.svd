                        </enumeratedValue>
                        <enumeratedValue>
                          <name>AUTO</name>
                          <description>Reconfig pipeline after every kick when idle</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
