                      <description>Disable bits for R/Y, G/U, B/V and A channels of secondary input when row index is even and column index is odd. R/Y is MSBit, A is LSBit.</description>
                      <bitRange>[17:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SECODDROWEVENCOLDIS</name>
                      <description>Disable bits for R/Y, G/U, B/V and A channels of secondary input when row index is odd and column index is even. R/Y is MSBit, A is LSBit.</description>
                      <bitRange>[21:18]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SECODDROWODDCOLDIS</name>
                      <description>Disable bits for R/Y, G/U, B/V and A channels of secondary input when row and column index is odd. R/Y is MSBit, A is LSBit.</description>
                      <bitRange>[25:22]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BLENDCONTROL</name>
                  <description>Options for blend operations</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x1010</resetValue>
                  <resetMask>0xFF7777</resetMask>
                  <fields>
                    <field>
                      <name>PRIM_C_BLD_FUNC</name>
                      <description>Primary (background) input color blending function</description>
                      <bitRange>[2:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ZERO</name>
                          <description>Cout = Cin * 0</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE</name>
                          <description>Cout = Cin * 1</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_ALPHA</name>
                          <description>Cout = Cin * ALPHA_prim</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_PRIM_ALPHA</name>
                          <description>Cout = Cin * (1 - ALPHA_prim)</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SEC_ALPHA</name>
                          <description>Cout = Cin * ALPHA_sec</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_SEC_ALPHA</name>
                          <description>Cout = Cin * (1 - ALPHA_sec)</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>CONST_ALPHA</name>
                          <description>Cout = Cin * ALPHA_const</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_CONST_ALPHA</name>
                          <description>Cout = Cin * (1 - ALPHA_const)</description>
                          <value>7</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>SEC_C_BLD_FUNC</name>
                      <description>Secondary (overlay) input color blending function</description>
                      <bitRange>[6:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ZERO</name>
                          <description>Cout = Cin * 0</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE</name>
                          <description>Cout = Cin * 1</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_ALPHA</name>
                          <description>Cout = Cin * ALPHA_prim</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_PRIM_ALPHA</name>
                          <description>Cout = Cin * (1 - ALPHA_prim)</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SEC_ALPHA</name>
                          <description>Cout = Cin * ALPHA_sec</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_SEC_ALPHA</name>
                          <description>Cout = Cin * (1 - ALPHA_sec)</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>CONST_ALPHA</name>
                          <description>Cout = Cin * ALPHA_const</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_CONST_ALPHA</name>
                          <description>Cout = Cin * (1 - ALPHA_const)</description>
                          <value>7</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>PRIM_A_BLD_FUNC</name>
                      <description>Primary (background) input alpha blending function</description>
                      <bitRange>[10:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ZERO</name>
                          <description>Aout = Ain * 0</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE</name>
                          <description>Aout = Ain * 1</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_ALPHA</name>
                          <description>Aout = Ain * ALPHA_prim</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_PRIM_ALPHA</name>
                          <description>Aout = Ain * (1 - ALPHA_prim)</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SEC_ALPHA</name>
                          <description>Aout = Ain * ALPHA_sec</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_SEC_ALPHA</name>
                          <description>Aout = Ain * (1 - ALPHA_sec)</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>CONST_ALPHA</name>
                          <description>Aout = Ain * ALPHA_const</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_CONST_ALPHA</name>
                          <description>Aout = Ain * (1 - ALPHA_const)</description>
                          <value>7</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>SEC_A_BLD_FUNC</name>
                      <description>Secondary (overlay) input alpha blending function</description>
                      <bitRange>[14:12]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ZERO</name>
                          <description>Aout = Ain * 0</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE</name>
                          <description>Aout = Ain * 1</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_ALPHA</name>
                          <description>Aout = Ain * ALPHA_prim</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_PRIM_ALPHA</name>
                          <description>Aout = Ain * (1 - ALPHA_prim)</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SEC_ALPHA</name>
                          <description>Aout = Ain * ALPHA_sec</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_SEC_ALPHA</name>
                          <description>Aout = Ain * (1 - ALPHA_sec)</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>CONST_ALPHA</name>
                          <description>Aout = Ain * ALPHA_const</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ONE_MINUS_CONST_ALPHA</name>
                          <description>Aout = Ain * (1 - ALPHA_const)</description>
                          <value>7</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>BLENDALPHA</name>
                      <description>Constant alpha value, used for constant alpha blending</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>POSITION</name>
                  <description>Position of secondary (overlay) input frame</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>XPOS</name>
                      <description>horizontal position, first pixel is at 0, format s15 (twos complement)
(format is signed integer)</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YPOS</name>
                      <description>vertical position, first pixel is at 0, format s15 (twos complement)
(format is signed integer)</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>EXTSRC8</name>
                <description>ExtSrc #8 (Display)</description>
                <addressOffset>0x00008C00</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>ExtSrc static control register</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x101</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>STARTSEL</name>
                      <description>Start select selects the mode to start processing operations.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>INPUT</name>
                          <description>Free running mode, use the incoming command word as trigger to start processing.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LOCAL</name>
                          <description>Keep to local start configuration, use external kick or SW trigger to start processing. The behavior is similar to fetch units.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWOFFSET</name>
                  <description>Clip window offset, to generate a clipping of the frame. It has to be within the input frame.</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWXOFFSET</name>
                      <description>Clip window offset in X direction, relative to the frame origin.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWYOFFSET</name>
                      <description>Clip window offset in Y direction, relative to the frame origin.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWDIMENSION</name>
                  <description>Define the clip window dimension. If the clip window feature is enabled this dimension is used for the new frame dimension. Note that the clip window has to be smaller or equal to the original frame dimensions. The new frame has to be within the active area of the original frame.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWWIDTH</name>
                      <description>Clip window width in pixels minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWHEIGHT</name>
                      <description>Clip window height in pixels minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS</name>
                  <description>Color component size of raw input data. Please note that the width must be equal or lower than the output width.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0x8F0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA</name>
                      <description>Component size of alpha channel [0-8].</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE</name>
                      <description>Component size of blue channel [0-10].</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN</name>
                      <description>Component size of green channel [0-10].</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED</name>
                      <description>Component size of red channel [0-10].</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ITUFORMAT</name>
                      <description>When ComponentBitsRed/Green/Blue is set to 10 and this mode enabled (value 1), then input format is considered 8.2 instead of 10.0 bits (max color is 1020 instead of 1023). This is compliant to ITU 656 standard.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT</name>
                  <description>Color component offset of raw input data.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x10080018</resetValue>
                  <resetMask>0x3F3F3F3F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA</name>
                      <description>Offset for alpha component.</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE</name>
                      <description>Offset for blue component.</description>
                      <bitRange>[13:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN</name>
                      <description>Offset for green component.</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED</name>
                      <description>Offset for red component.</description>
                      <bitRange>[29:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONSTANTCOLOR</name>
                  <description>Constant color register</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>CONSTANTALPHA</name>
                      <description>Alpha.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTBLUE</name>
                      <description>Blue or V (chroma).</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTGREEN</name>
                      <description>Green or U (chroma).</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTRED</name>
                      <description>Red or Y (luma).</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Common control settings.</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x1000</resetValue>
                  <resetMask>0x17FF1</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWENABLE</name>
                      <description>Value 1 enables the clip window feature.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RASTERMODE</name>
                      <description>Selects a method how generate output samples from input stream.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>Input stream is RGB(A) or YUV 4:4:4.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV422</name>
                          <description>Input stream is packed YUV 4:2:2.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUV422UPSAMPLINGMODE</name>
                      <description>Selects a method for horizontal up-sampling when RasterMode is YUV422.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>REPLICATE</name>
                          <description>Replicate mode for interspersed samples (UV samples between Y samples).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INTERPOLATE</name>
                          <description>Interpolate mode for coaligned samples (UV samples at Y sample positions).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE</name>
                      <description>Enables different kind of YUV to RGB conversions.</description>
                      <bitRange>[7:6]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion. Input data must be RGB.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RGBALPHASRCENABLE</name>
                      <description>Value 1 enables source alpha (extracted from input stream) for RGB pre-multiply. When disabled source alpha is set to 1.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHACONSTENABLE</name>
                      <description>Value 1 enables constant alpha (ConstAlpha field) for RGB pre-multiply. When disabled constant alpha is set to 1.</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHATRANSENABLE</name>
                      <description>Value 1 enables transparent alpha (0 or 1 depending on RGB matching ConstantColor setting) for RGB pre-multiply. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PREMULCONSTRGB</name>
                      <description>When enabled (value 1) the values given by ConstantRed/Green/Blue are used instead of alpha for source RGB pre-multiply. Settings RGBAlphaSrc/Const/TransEnable have no effect then.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHASRCENABLE</name>
                      <description>Value 1 enables source alpha for computing the output alpha. When disabled source alpha is set to 1.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHACONSTENABLE</name>
                      <description>Value 1 enables constant alpha for computing the output alpha. When disabled constant alpha is set to 1.</description>
                      <bitRange>[13:13]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHATRANSENABLE</name>
                      <description>Value 1 enables transparent alpha for computing the output alpha. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>GAMMAREMOVEENABLE</name>
                      <description>Value 1 enables the stage to remove a gamma from RGB components.</description>
                      <bitRange>[16:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROLTRIGGER</name>
                  <description>ExtSrc unit trigger token generation</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>SHDTOKGEN</name>
                      <description>Write a 1 to this field for the extsrc unit to perform a shadow load with the next start of operation and set the rld bit in the start of frame control word (generate shadow load token for subsequent units).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>START</name>
                  <description>ExtSrc unit start register</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>START</name>
                      <description>Writing a one starts processing, use this only for debug purposes.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
            </cluster>
          </cluster>
          <cluster>
            <name>DISENG0</name>
            <description>Display Engine</description>
            <addressOffset>0x00020000</addressOffset>
            <cluster>
              <name>DISENGCFG0</name>
              <description>Top-Level Configuration</description>
              <addressOffset>0x00000000</addressOffset>
              <register>
                <name>CTL</name>
                <description>Display engine control register.</description>
                <addressOffset>0x0</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x1</resetValue>
                <resetMask>0x1</resetMask>
                <fields>
                  <field>
                    <name>DSPCLKDIVIDE</name>
                    <description>Controls generation of display clock signals for display stream.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>DIV1</name>
                        <description>External display clock signal has pixel clock frequency.</description>
                        <value>0</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>DIV2</name>
                        <description>External display clock signal has twice the pixel clock frequency.</description>
                        <value>1</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                </fields>
              </register>
              <register>
                <name>POLARITYCTRL</name>
                <description>Polarity control for TCon input and corresponding top-level output (TCon by-pass port).</description>
                <addressOffset>0x4</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x4</resetValue>
                <resetMask>0xF</resetMask>
                <fields>
                  <field>
                    <name>POLHS</name>
