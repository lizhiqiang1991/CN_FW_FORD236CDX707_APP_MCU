              <register>
                <name>MAPBIT23_20</name>
                <description>Mapping of 24 bit RGB or Timing Generator TSig[5-0] to bit 20 .. 23</description>
                <addressOffset>0x424</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x17161514</resetValue>
                <resetMask>0x1F1F1F1F</resetMask>
                <fields>
                  <field>
                    <name>MAPBIT20</name>
                    <description>map bit[ 20 ] from [ Blue, Green, Red ] or from TSig[5-0]. If MapBit20 in [ 23..0 ] =&gt; bit[ 20 ] = [ Blue, Green, Red ] [ MapBit20 ]; if MapBit20 in [29 .. 24] =&gt; bit[ 20 ] in { TSig[5] .. TSig[0] } ; If MapBit20 = 31 =&gt; bit[ 20 ] = 0 ; if MapBit20= 30 =&gt;  bit[ 20 ] = 1</description>
                    <bitRange>[4:0]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>MAPBIT21</name>
                    <description>map bit[ 21 ] from [ Blue, Green, Red ] or from TSig[5-0]. If MapBit21 in [ 23..0 ] =&gt; bit[ 21 ] = [ Blue, Green, Red ] [ MapBit21 ]; if MapBit21 in [29 .. 24] =&gt; bit[ 21 ] in { TSig[5] .. TSig[0] } ; If MapBit21 = 31 =&gt; bit[ 21 ] = 0 ; if MapBit21= 30 =&gt;  bit[ 21 ] = 1</description>
                    <bitRange>[12:8]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>MAPBIT22</name>
                    <description>map bit[ 22 ] from [ Blue, Green, Red ] or from TSig[5-0]. If MapBit22 in [ 23..0 ] =&gt; bit[ 22 ] = [ Blue, Green, Red ] [ MapBit22 ]; if MapBit22 in [29 .. 24] =&gt; bit[ 22 ] in { TSig[5] .. TSig[0] } ; If MapBit22 = 31 =&gt; bit[ 22 ] = 0 ; if MapBit22= 30 =&gt;  bit[ 22 ] = 1</description>
                    <bitRange>[20:16]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>MAPBIT23</name>
                    <description>map bit[ 23 ] from [ Blue, Green, Red ] or from TSig[5-0]. If MapBit23 in [ 23..0 ] =&gt; bit[ 23 ] = [ Blue, Green, Red ] [ MapBit23 ]; if MapBit23 in [29 .. 24] =&gt; bit[ 23 ] in { TSig[5] .. TSig[0] } ; If MapBit23 = 31 =&gt; bit[ 23 ] = 0 ; if MapBit23= 30 =&gt;  bit[ 23 ] = 1</description>
                    <bitRange>[28:24]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
