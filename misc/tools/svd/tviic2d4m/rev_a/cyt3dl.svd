                  <name>SOURCEBUFFERDIMENSION0</name>
                  <description>Source buffer dimension of layer 0.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3FFF3FFF</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>LINEWIDTH0</name>
                      <description>Width of the source buffer of the layer in pixels minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINECOUNT0</name>
                      <description>Number of lines of the source buffer of the layer minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS0</name>
                  <description>Size of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0x8F0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ITUFORMAT0</name>
                      <description>When ComponentBitsRed/Green/Blue is set to 10 and this mode enabled (value 1), then input format is considered 8.2 instead of 10.0 bits (max color is 1020 instead of 1023). This is compliant to ITU 656 standard.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT0</name>
                  <description>Bit position of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x18100800</resetValue>
                  <resetMask>0x1F1F1F1F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[4:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[20:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[28:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYEROFFSET0</name>
                  <description>Position of layer 0 within the destination frame.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>LAYERXOFFSET0</name>
                      <description>Horizontal offset (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LAYERYOFFSET0</name>
                      <description>Vertical offset (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWOFFSET0</name>
                  <description>Clip window position for layer 0.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWXOFFSET0</name>
                      <description>Horizontal position (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWYOFFSET0</name>
                      <description>Vertical position (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWDIMENSIONS0</name>
                  <description>Clip window size for layer 0.</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWWIDTH0</name>
                      <description>Width.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWHEIGHT0</name>
                      <description>Height.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONSTANTCOLOR0</name>
                  <description>Constant color for layer 0.</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>CONSTANTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTRED0</name>
                      <description>Red and Y (luma).</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYERPROPERTY0</name>
                  <description>Common properties of layer 0.</description>
                  <addressOffset>0x38</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xB8000008</resetValue>
                  <resetMask>0xFFFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>PALETTEENABLE0</name>
                      <description>Enables (value = 1) a color palette with 8 bits input and 24 bits output. Lower bits of the lookup index are read from memory (PaletteIdWidth0), upper bits are set to index of this layer. Palette output is extended by upper bits of index word read from memory (e.g. to store alpha together with index). Result is mapped to color channels according to ColorComponentBits/Shift settings.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILEMODE0</name>
                      <description>Select the tile mode for pixels outside the source buffer. Clip color (0,0,0,0) takes precedence if a pixel becomes subject to both tiling and clipping.</description>
                      <bitRange>[2:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TILE_FILL_ZERO</name>
                          <description>Use zero value</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_FILL_CONSTANT</name>
                          <description>Use constant color register value</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD</name>
                          <description>Use closest pixel from source buffer. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD_ZERO</name>
                          <description>Use closest pixel from source buffer but zero for alpha component. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha for computing the output alpha. When disabled source alpha is set to 1.</description>
                      <bitRange>[3:3]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha for computing the output alpha. When disabled constant alpha is set to 1.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHAMASKENABLE0</name>
                      <description>Value 1 enables mask alpha for computing the output alpha. When disabled mask alpha is set to 1.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha for computing the output alpha. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[6:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha (stored together with color component in the source buffer) for RGB pre-multiply. When disabled source alpha is set to 1.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha (ConstAlpha fields) for RGB pre-multiply. When disabled constant alpha is set to 1.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHAMASKENABLE0</name>
                      <description>Value 1 enables mask alpha (read by another Fetch unit from a separate alpha layer) for RGB pre-multiply. When disabled mask alpha is set to 1. Alpha mask input must be enabled for this field to have effect.</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha (0 or 1 depending on RGB matching ConstantColor setting) for RGB pre-multiply. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PREMULCONSTRGB0</name>
                      <description>When enabled (value 1) the values given by ConstantRed/Green/Blue are used instead of alpha for source RGB pre-multiply. Settings RGBAlphaSrc/Const/Mask/TransEnable have no effect then.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE0</name>
                      <description>Enables different kind of YUV to RGB conversions.</description>
                      <bitRange>[13:12]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GAMMAREMOVEENABLE0</name>
                      <description>Value 1 enables the stage to remove a gamma from RGB components.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEOFFSET0</name>
                      <description>Palette may contain multiple areas. This offset shows to the starting position of the currently used area.</description>
                      <bitRange>[26:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEIDWIDTH0</name>
                      <description>Number minus one of least significant bits of pixel data read from the source buffer that are used as index value for color palette look-up.</description>
                      <bitRange>[29:27]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWENABLE0</name>
                      <description>Value 1 enables the clip window for this layer. Pixels outside the clip window get the clip color, pixels inside the source or tiling color.</description>
                      <bitRange>[30:30]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SOURCEBUFFERENABLE0</name>
                      <description>Value 1 enables the source buffer for this layer. When disabled the tiling color is used only (TileMode TILE_PAD not allowed).</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMEDIMENSIONS</name>
                  <description>Output frame dimension.</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xEF013F</resetValue>
                  <resetMask>0xBFFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>FRAMEWIDTH</name>
                      <description>Frame width minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FRAMEHEIGHT</name>
                      <description>Frame height minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>EMPTYFRAME</name>
                      <description>When enabled output frame is empty. FrameWidth/Height settings have no effect then. Can be used to load shadows or to generate synchronization signals only (frame/sequence complete). If enabled, InputSelect must be set to INACTIVE.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMERESAMPLING</name>
                  <description>Resampling options for output frame.</description>
                  <addressOffset>0x40</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x104000</resetValue>
                  <resetMask>0x1FFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>STARTX</name>
                      <description>X coordinate of first sample point relative to origin.
(format is signed fix-point 4.2)</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>STARTY</name>
                      <description>Y coordinate of first sample point relative to origin.
(format is signed fix-point 4.2)</description>
                      <bitRange>[11:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DELTAX</name>
                      <description>Increment of X coordinate for horizontal step in destination frame.
(format is signed fix-point 4.2)</description>
                      <bitRange>[17:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DELTAY</name>
                      <description>Increment of Y coordinate for vertical step in destination frame.
(format is signed fix-point 4.2)</description>
                      <bitRange>[23:18]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SWAPDIRECTION</name>
                      <description>Swaps X and Y directions for re-sampling. When enabled (= 1) DeltaY is applied for horizontal and DeltaX for vertical step on destination frame.</description>
                      <bitRange>[24:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DECODECONTROL</name>
                  <description>Control options for RLAD decompression.</description>
                  <addressOffset>0x44</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x88880001</resetValue>
                  <resetMask>0xFFFF0003</resetMask>
                  <fields>
                    <field>
                      <name>COMPRESSIONMODE</name>
                      <description>Algorithm that the encoder used for compression.</description>
                      <bitRange>[1:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>RLAD</name>
                          <description>Run-Length Adaptive Dithering (lossy compression).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLAD_UNIFORM</name>
                          <description>Run-Length Adaptive Dithering (lossy compression; uniform package size).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLA</name>
                          <description>Run-Length Adaptive (lossless compression).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RL</name>
                          <description>Standard Run-Length. In contrary to other modes is in big endian format.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RLADCOMPBITSRED</name>
                      <description>Maximum for average number of bits per compressed pixel for Red or Y (luma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSGREEN</name>
                      <description>Maximum for average number of bits per compressed pixel for Green or U (chroma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[23:20]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSBLUE</name>
                      <description>Maximum for average number of bits per compressed pixel for Blue or V (chroma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSALPHA</name>
                      <description>Maximum for average number of bits per compressed pixel for Alpha channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[31:28]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERLENGTH</name>
                  <description>Source buffer length for compressed data.</description>
                  <addressOffset>0x48</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RLEWORDS</name>
                      <description>Number of 32-bit words minus one that are required to decode the run length encoded source buffer.</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Shared common control settings for all layers.</description>
                  <addressOffset>0x4C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x10000</resetValue>
                  <resetMask>0x100BF</resetMask>
                  <fields>
                    <field>
                      <name>RASTERMODE</name>
                      <description>Selects a method how to generate source buffer sample points.</description>
                      <bitRange>[2:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>[IBO only, for LBO use PERSPECTIVE with corresponding Geometry] First sample at StartX/Y relative to origin. Hor/ver increments using DeltaX/Y and DeltaSwap setup.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DECODE</name>
                          <description>[FetchDecode/FetchBlit only] Source buffer is an encoded bit stream. First sample at origin (0,0). Hor/ver increments = (1,0)/(0,1).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ARBITRARY</name>
                          <description>[FetchBlit/Warp only] Arbitrary warping (filter is active). Coordinates are read from frame input port. InputSelect must be set to COORDINATE. ArbStartX/Y and ArbDeltaXX/XY/YX/YY must be setup.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSPECTIVE</name>
                          <description>[FetchBlit only] Affine/Perspective warping (filter is active). First sample at PerspStartX/Y/W. Hor/ver increments using PerspDeltaXX/XY/YX/YY/WX/WY. Homogeneous coordinates. See also field Geometry to reduce coordinate amount.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV422</name>
                          <description>[FetchBlit/Decode only] Source buffer is packed YUV 422. First sample at origin (0,0). Hor/ver increments = (1,0)/(0,1). All correllated window widths and horizontal offsets must be even.</description>
                          <value>4</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>INPUTSELECT</name>
                      <description>Selects function for the frame input port.</description>
                      <bitRange>[4:3]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>INACTIVE</name>
                          <description>Not used.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COMPPACK</name>
                          <description>Used for component packing (e.g. UV or source alpha buffer).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ALPHAMASK</name>
                          <description>Used for RGB and alpha pre-multiply stage (mask alpha buffer).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COORDINATE</name>
                          <description>Used for arbitrary warping (coordinate buffer).</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUV422UPSAMPLINGMODE</name>
                      <description>Selects a method for horizontal up-sampling of YUV 422/420 input data.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>REPLICATE</name>
                          <description>Replicate mode for interspersed samples (UV samples between Y samples).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INTERPOLATE</name>
                          <description>Interpolate mode for coaligned samples (UV samples at Y sample positions).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RAWPIXEL</name>
                      <description>Raw pixel mode. If enabled (value = 1), the ComponentBits/Shift settings are replaced for all layers by fixed values that allow passing the pixel data read from memory unchanged to subsequent units (e.g. for reading coordinate layers). Multiply stages and transparent color are deactivated. Skip and Tile pixels are not affected by this setting.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPCOLOR</name>
                      <description>Selects which color to take for pixels that do not lie inside the clip window of any layer.</description>
                      <bitRange>[16:16]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NULL</name>
                          <description>Null color.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYER</name>
                          <description>Color of layer number given by ClipLayer (or layer 0 when Fetch unit has one layer only). The color is then the layer's source or tiling color.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROLTRIGGER</name>
                  <description>Shadow load trigger.</description>
                  <addressOffset>0x50</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>SHDTOKGEN</name>
                      <description>Writing a 1 to this will load shadow registers into the active configuration with the next start of frame and send a shadow load token to subsequent units.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>START</name>
                  <description>Frame start trigger.</description>
                  <addressOffset>0x54</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>START</name>
                      <description>Writing a 1 to this field will start generating one frame (for debugging purposes only).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FETCHTYPE</name>
                  <description>Fetch unit type.</description>
                  <addressOffset>0x58</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>FETCHTYPE</name>
                      <description>This field can be used to determine what kind of fetch unit this is.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-only</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DECODE</name>
                          <description>Fetch unit with RL and RLAD decoder.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYER</name>
                          <description>Fetch unit with fractional plane (8 layers).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>WARP</name>
                          <description>Fetch unit with arbitrary warping and fractional plane (8 layers).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ECO</name>
                          <description>Fetch unit with minimum feature set for alpha, chroma and coordinate planes.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSP</name>
                          <description>Fetch unit with affine, perspective and arbitrary warping.</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROT</name>
                          <description>Fetch unit with affine and arbitrary warping.</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DECODEL</name>
                          <description>Fetch unit with RL and RLAD decoder, reduced feature set.</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYERL</name>
                          <description>Fetch unit with fractional plane (8 layers), reduced feature set.</description>
                          <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROTL</name>
                          <description>Fetch unit with affine and arbitrary warping, reduced feature set.</description>
                          <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ECOL</name>
                          <description>Fetch unit with reduced minimum feature set for alpha, chroma and coordinate planes.</description>
                          <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLIT</name>
                          <description>Fetch unit with DECODE and PERSP capabilities.</description>
                          <value>10</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
