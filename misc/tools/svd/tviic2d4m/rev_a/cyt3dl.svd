                      <name>COEFF_V1</name>
                      <description>Vertical coefficient 1.
(format is signed integer)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V0</name>
                      <description>Vertical coefficient 0.
(format is signed integer)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COEFFICIENTSV1</name>
                  <description>Vertical coefficients for filter_mode FIR.</description>
                  <addressOffset>0x48</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>COEFF_V7</name>
                      <description>Vertical coefficient 7.
(format is signed integer)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V6</name>
                      <description>Vertical coefficient 6.
(format is signed integer)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V5</name>
                      <description>Vertical coefficient 5.
(format is signed integer)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V4</name>
                      <description>Vertical coefficient 4.
(format is signed integer)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COEFFICIENTSV2</name>
                  <description>Vertical coefficients for filter_mode FIR.</description>
                  <addressOffset>0x4C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>COEFF_V11</name>
                      <description>Vertical coefficient 11.
(format is signed integer)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V10</name>
                      <description>Vertical coefficient 10.
(format is signed integer)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V9</name>
                      <description>Vertical coefficient 9.
(format is signed integer)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V8</name>
                      <description>Vertical coefficient 8.
(format is signed integer)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COEFFICIENTSV3</name>
                  <description>Vertical coefficients for filter_mode FIR.</description>
                  <addressOffset>0x50</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFF00</resetMask>
                  <fields>
                    <field>
                      <name>COEFF_V14</name>
                      <description>Vertical coefficient 14. The bottommost coefficient regardless of the filter height. In contrast to the coeff_v0 this coefficient has to be always programmed.
(format is signed integer)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V13</name>
                      <description>Vertical coefficient 13.
(format is signed integer)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COEFF_V12</name>
                      <description>Vertical coefficient 12.
(format is signed integer)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>HISTOGRAM4</name>
                <description>Video Processing Block #0 Histogram (Capture)</description>
                <addressOffset>0x00007400</addressOffset>
                <register>
                  <name>CONTROL</name>
                  <description>Controls some settings concerning input components and alpha mask.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3331</resetMask>
                  <fields>
                    <field>
                      <name>CLIP_EN</name>
                      <description>Switch for clip window. If enabled all pixels outside the clip window are not taken into account.
(format is unsigned integer)</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>Clip window is switched off.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENABLE</name>
                          <description>Clip window is switched on.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>COLOR_SPACE_MODE</name>
                      <description>Assuming that YUV(YCrCb) color components according to BT.601 or BT.709 are provided at histogram input the appropriate conversion to RGB components in [0,255] range can be selected here.
(format is unsigned integer)</description>
                      <bitRange>[5:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NO_CONV</name>
                          <description>No color space conversion of input components is applied.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV2RGB_BT601</name>
                          <description>YUV input components as described in BT.601 are converted to RGB in [0,255] range.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV2RGB_BT709</name>
                          <description>YUV input components as described in BT.709 are converted to RGB in [0,255] range.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>LUM_MODE</name>
                      <description>If a histogram for luma or luminance is required, the conversion formula for luma (Y component according to BT.601) or luminance (Y component according to BT.709) can be selected here. Luma or luminance calculation should only be applied if RGB components in range [0..255] are delivered directly at histogram input or when YCrCb components are converted to RGB by the appropriate setting of register field color_space_mode. Luma or luminance counting is delivered in first (component0) histogram.
(format is unsigned integer)</description>
                      <bitRange>[9:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NO_CONV</name>
                          <description>Component0 for first histogram is counted as it is.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LUMA</name>
                          <description>Component0 for first histogram is replaced by luma, which is calculated from RGB input components according to BT.601.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LUMINANCE</name>
                          <description>Component0 for first histogram is replaced by luminance, which is calculated from RGB input components according to BT.709.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAMASK</name>
                      <description>Value 1 enables the alpha mask mode. In this mode only pixels with an alpha value larger than 0.5 are affecting the histogram bins.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHAINVERT</name>
                      <description>Value 1 inverts the effect of the alpha mask mode when enabled (pixels with alpha value smaller or equal 0.5 are affecting the histogram bins).</description>
                      <bitRange>[13:13]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BINPROPERTIES</name>
                  <description>Configures the histogram bins.</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3</resetValue>
                  <resetMask>0x117</resetMask>
                  <fields>
                    <field>
                      <name>BINNUM_WIDTH</name>
                      <description>2**binnum_width is the number of bins in a histogram.
(format is unsigned integer)</description>
                      <bitRange>[2:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>BINS_8</name>
                          <description>There are  8 bins, addressable with 3bit.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BINS_16</name>
                          <description>There are 16 bins, addressable with 4bit.</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BINS_32</name>
                          <description>There are 32 bins, addressable with 5bit.</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BINS_64</name>
                          <description>There are 64 bins, addressable with 6bit.</description>
                          <value>6</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>CNT_MODE</name>
                      <description>Counter mode, which controls the way the bin values are accumulated.
(format is unsigned integer)</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEAREST</name>
                          <description>Counter of nearest bin is incremented.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LINEAR</name>
                          <description>Counters of the 2 nearest bins are increased by one minus the distance to bin center (normalized between 0 and 1), it works only for first (component0) histogram, reading of component1/2 histogram results in undefined data.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>BINCNT_RD_MODE</name>
                      <description>The field controls if the actual bin count or the sum of all bin counts up to actual bin count is provided in registers RsltComp0Bincnt, RsltComp1Bincnt and RsltComp2Bincnt.
(format is unsigned integer)</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>BINCNT</name>
                          <description>Actual bin cnt is provided.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BINCNT_ACCU</name>
                          <description>Bin count sum is provided.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BINCNTTHRESH</name>
                  <description>Bin counter threshold value.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BINCNT_THRESH</name>
                      <description>Bin counters below this threshold will be reported as 0. This threshold value will also affect the BINCNT_ACCU mode where 0 will be added for all bin counters below the threshold.
(format is unsigned integer)</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINUPPERLEFT</name>
                  <description>Coordinates of upper left corner of clip window.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIP_X</name>
                      <description>X coordinate of upper left corner of clip window.
(format is unsigned integer)</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIP_Y</name>
                      <description>Y coordinate of upper left corner of clip window.
(format is unsigned integer)</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINSIZE</name>
                  <description>Dimensions of clip window.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIP_WIDTH</name>
                      <description>Width of clip window, given minus one.
(format is unsigned integer)</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIP_HEIGHT</name>
                      <description>Height of clip window, given minus one.
(format is unsigned integer)</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTRDY</name>
                  <description>Measurement result status.</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>RSLT_RDY</name>
                      <description>A one indicates that measurement results (in registers Rslt...) are valid and can be read.
(format is unsigned integer)</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTFRMINF</name>
                  <description>Additional information on the measurement results.</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x100FF</resetMask>
                  <fields>
                    <field>
                      <name>FRM_IDX</name>
                      <description>Each frame passing the histogram unit gets an index, which is the value of a wrapped around counter, which counts the frames independent from how the histogram unit is configured. The index of the frame of the ongoing readout can be read here. In display stream context, if the display operation ends (framegen is switched off and sequence complete occurs) this frame index is reset to 0.
(format is unsigned integer)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>FLD_POLARITY</name>
                      <description>Returns field polarity of the measured frame. This read value of this field is undefined in display stream context; use in storage, content or safety stream context only.
(format is unsigned integer)</description>
                      <bitRange>[16:16]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP0BINIDX</name>
                  <description>Results of frame measurement for component 0.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3F003F</resetMask>
                  <fields>
                    <field>
                      <name>COMP0_BINIDX_MAXCNT</name>
                      <description>The index of the bin of the component 0 histogram, which contains the highest counter value, which were read until now for the ongoing readout. In the case of RGB pixels, component 0 means the red value, in the case of YUV pixels, component0 means the Y value. If luma/luminance calculation is switched on by field lum_mode component0 is the calculated luma/luminance.
(format is unsigned integer)</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>COMP0_BINIDX_NXT</name>
                      <description>Do not use this filed. The index of the bin, that will be next accessed by register RsltComp0Bincnt. In the case of RGB pixels, component0 means the red value, in the case of YUV pixels, component 0 means the Y value. If luma/luminance calculation is switched on by field lum_mode component0 is the calculated luma/luminance.
(format is unsigned integer)</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP1BINIDX</name>
                  <description>Results of frame measurement for component 1.</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3F003F</resetMask>
                  <fields>
                    <field>
                      <name>COMP1_BINIDX_MAXCNT</name>
                      <description>The index of the bin of the component 1 histogram, which contains the highest counter value, which were read until now for the ongoing readout. In the case of RGB pixels, component 1 means the green value. In the case of YUV pixels, component 1 means the Cb value.
(format is unsigned integer)</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>COMP1_BINIDX_NXT</name>
                      <description>The index of the bin, that will be next accessed by register RsltComp1Bincnt. In the case of RGB pixels, component 1 means the green value. In the case of YUV pixels, component 1 means the Cb value.
(format is unsigned integer)</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP2BINIDX</name>
                  <description>Results of frame measurement for component 2.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3F003F</resetMask>
                  <fields>
                    <field>
                      <name>COMP2_BINIDX_MAXCNT</name>
                      <description>The index of the bin of the component 2 histogram, which contains the highest counter value, which were read until now for the ongoing readout. In the case of RGB pixels, component 2 means the blue value. In the case of YUV pixels, component 2 means the Cr value.
(format is unsigned integer)</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>COMP2_BINIDX_NXT</name>
                      <description>The index of the bin, that will be next accessed by register RsltComp2Bincnt. In the case of RGB pixels, component 2 means the blue value. In the case of YUV pixels, component 2 means the Cr value.
(format is unsigned integer)</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP0SUM</name>
                  <description>Sum of all component 0 values.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>COMP0_SUM</name>
                      <description>Sum of all component 0 values. In the case of RGB pixels, component 0 means the red value, in the case of YUV pixels, component 0 means the Y value. If luma/luminance calculation is switched on by field lum_mode, component 0 is the calculated luma/luminance. If the read value is 0xFFFFFFFF a counter overflow has occurred and the read value should not be used (this can only happen for frame dimensions beyond 2^12 * 2^12).
(format is unsigned integer)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP1SUM</name>
                  <description>Sum of all component 1 values.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>COMP1_SUM</name>
                      <description>Sum of all component 1 values. In the case of RGB pixels, component 1 means the green value. In the case of YUV pixels, component 1 means the Cb value. If the read value is 0xFFFFFFFF a counter overflow has occurred and the read value should not be used (this can only happen for frame dimensions beyond 2^12 * 2^12).
(format is unsigned integer)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP2SUM</name>
                  <description>Sum of all component 2 values.</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>COMP2_SUM</name>
                      <description>Sum of all component 2 values. In the case of RGB pixels, component 2 means the blue value. In the case of YUV pixels, component 2 means the Cr value. If the read value is 0xFFFFFFFF a counter overflow has occurred and the read value should not be used (this can only happen for frame dimensions beyond 2^12 * 2^12).
(format is unsigned integer)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP0BINCNT</name>
                  <description>Bin counters of component 0 histogram. This register do NOT support debugger access followed by software access (they clear on read)</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>COMP0_BINCNT</name>
                      <description>Counter of current bin number in component 0 histogram. In the case of RGB pixels, component 0 means the red value, in the case of YUV pixels, component 0 means the Y value.
(format is unsigned integer)</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP1BINCNT</name>
                  <description>Bin counters of component 1 histogram. This register do NOT support debugger access followed by software access (they clear on read)</description>
                  <addressOffset>0x38</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>COMP1_BINCNT</name>
                      <description>Counter of current bin number in component 1 histogram. In the case of RGB pixels, component 1 means the green value. In the case of YUV pixels, component 1 means the Cb value.
(format is unsigned integer)</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RSLTCOMP2BINCNT</name>
                  <description>Bin counters of component 2 histogram. This register do NOT support debugger access followed by software access (they clear on read)</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>COMP2_BINCNT</name>
                      <description>Counter of current bin index in component 2 histogram. In the case of RGB pixels, component 2 means the blue value. In the case of YUV pixels, component 2 means the Cb value.
(format is unsigned integer)</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRMSTRTTRIG</name>
                  <description>Triggers for loading shadow registers and starting measurement with next input frame.</description>
                  <addressOffset>0x40</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>MSRMNT_STRT_TRIG</name>
                      <description>Writing value 1 into this field initiates the measurement of the next frame.
(format is unsigned integer)</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>LAYERBLEND1</name>
                <description>LayerBlend #1 (Display, Alpha Plane 1)</description>
                <addressOffset>0x00007800</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Static control settings.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x14</resetValue>
                  <resetMask>0x1F</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type fields of this unit (0 = write through, 1 = shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
