                      <description>Enable of layerblend5 clock (this setting has to be the same for all modules of one processing pipeline). If a submodule is enabled and FULL is used, then the register [endpoint_name]_clk must be set to 0x80.</description>
                      <bitRange>[25:24]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>Clock for layerblend5 is disabled</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>AUTOMATIC</name>
                          <description>Clock is enabled if unit is used, frequency is defined by the register setting for this pipeline (see [endpoint_name]_Static register)</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FULL</name>
                          <description>Clock for layerblend5 is without gating</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYERBLEND5_STATUS</name>
                  <description>Status information for pixel engine configuration of layerblend5</description>
