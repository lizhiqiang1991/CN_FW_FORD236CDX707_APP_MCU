                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS1</name>
                  <description>Size of color components for RGB, YUV and index formats (layer 1).</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
