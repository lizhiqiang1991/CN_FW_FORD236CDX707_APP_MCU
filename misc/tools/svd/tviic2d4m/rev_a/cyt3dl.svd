                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>XPOS</name>
                      <description>horizontal position, first pixel is at 0, format s15 (twos complement)
(format is signed integer)</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YPOS</name>
                      <description>vertical position, first pixel is at 0, format s15 (twos complement)
(format is signed integer)</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>LAYERBLEND3</name>
                <description>LayerBlend #3 (Display, Alpha Plane 3)</description>
                <addressOffset>0x00008000</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Static control settings.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x14</resetValue>
                  <resetMask>0x1F</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type fields of this unit (0 = write through, 1 = shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SHDLDSEL</name>
                      <description>Controls when shadow fields of this unit are loaded into the active configuration in case that ShdEn is enabled.</description>
                      <bitRange>[2:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PRIMARY</name>
                          <description>Load shadows with shadow load token on primary input (background plane).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SECONDARY</name>
                          <description>Load shadows with shadow load token on secondary input (foreground plane).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BOTH</name>
                          <description>Load shadows with shadow load token on any input.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>SHDTOKSEL</name>
                      <description>Controls when a shadow load token is generated on the output port, which controls shadow load in subsequent processing units.</description>
                      <bitRange>[4:3]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PRIMARY</name>
                          <description>When a token was received on the primary input (background plane).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SECONDARY</name>
                          <description>When a token was received on the secondary input (foreground plane).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BOTH</name>
                          <description>When a token was received on any input.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Common control settings.</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x1</resetValue>
                  <resetMask>0x3FFFF75</resetMask>
                  <fields>
                    <field>
                      <name>MODE</name>
                      <description>Operation mode.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Module is in neutral mode. Output is same as primary input.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLEND</name>
                          <description>Module is in blending mode.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAMASKENABLE</name>
                      <description>Enables Alpha Mask feature. This will limit possible output alpha values to 0 and 255. Generation of this alpha value will depend on the AlphaMaskMode field.</description>
                      <bitRange>[2:2]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>AlphaMask feature disabled</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENABLE</name>
                          <description>AlphaMask feature enabled</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAMASKMODE</name>
                      <description>AlphaMaskMode determines how the output alpha is generated when AlphaMaskEnable is set to ENABLE</description>
                      <bitRange>[6:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PRIM</name>
                          <description>Areas with primary input alpha &gt; 128 will be mapped to 255 and the rest will have an alpha value of 0</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SEC</name>
                          <description>The area of the secondary input will get an alpha value of 255 and the rest will be 0</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_OR_SEC</name>
                          <description>Behaves as if the output of modes PRIM and SEC would be ORed together</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_AND_SEC</name>
                          <description>Behaves as if the output of modes PRIM and SEC would be ANDed together</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_INV</name>
                          <description>Behaves as if the output of mode PRIM would be inverted</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SEC_INV</name>
                          <description>Behaves as if the output of mode SEC would be inverted</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_OR_SEC_INV</name>
                          <description>Behaves as if the output of modes PRIM and SEC_INV would be ORed together</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_AND_SEC_INV</name>
                          <description>Behaves as if the output of modes PRIM and SEC_INV would be ANDed together</description>
                          <value>7</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>SECLOWPASSEN</name>
                      <description>Enables a horizontal low-pass filter for the secondary input port. Should be used for dual view and dual display mode when the secondary input frame has twice the resolution of one view (= full resolution of the panel interface). Every 2nd pixel only is sampled then.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SECREPLICATEEN</name>
                      <description>Enables horizontal replication of pixels by factor 2 on secondary input port. Must be used for dual display mode when the secondary input frame has the resolution of one display (= half the resolution of the panel interface).</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SECEVENROWEVENCOLDIS</name>
                      <description>Disable bits for R/Y, G/U, B/V and A channels of secondary input when row and column index is even. R/Y is MSBit, A is LSBit.</description>
                      <bitRange>[13:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SECEVENROWODDCOLDIS</name>
                      <description>Disable bits for R/Y, G/U, B/V and A channels of secondary input when row index is even and column index is odd. R/Y is MSBit, A is LSBit.</description>
                      <bitRange>[17:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SECODDROWEVENCOLDIS</name>
                      <description>Disable bits for R/Y, G/U, B/V and A channels of secondary input when row index is odd and column index is even. R/Y is MSBit, A is LSBit.</description>
                      <bitRange>[21:18]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SECODDROWODDCOLDIS</name>
                      <description>Disable bits for R/Y, G/U, B/V and A channels of secondary input when row and column index is odd. R/Y is MSBit, A is LSBit.</description>
                      <bitRange>[25:22]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
