                  <field>
                    <name>MAPBIT0</name>
                    <description>map bit[ 0 ] from [ Blue, Green, Red ] or from TSig[5-0]. If MapBit0 in [ 23..0 ] =&gt; bit[ 0 ] = [ Blue, Green, Red ] [ MapBit0 ]; if MapBit0 in [29 .. 24] =&gt; bit[ 0 ] in { TSig[5] .. TSig[0] }; If MapBit0 = 31 =&gt; bit[ 0 ] = 0 ; if MapBit1= 30 =&gt;  bit[ 0 ] = 1</description>
                    <bitRange>[4:0]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>MAPBIT1</name>
