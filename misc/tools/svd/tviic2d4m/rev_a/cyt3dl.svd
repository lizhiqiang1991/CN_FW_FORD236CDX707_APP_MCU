              <cluster>
                <name>EXTDST0</name>
                <description>ExtDst #0 (Content)</description>
                <addressOffset>0x00002400</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>External Destination static control register</description>
                  <addressOffset>0x0</addressOffset>
