                    </field>
                    <field>
                      <name>COEFF_H4</name>
                      <description>Horizontal coefficient 4.
(format is signed integer)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COEFFICIENTSH2</name>
                  <description>Horizontal coefficients for filter_mode FIR.</description>
                  <addressOffset>0x3C</addressOffset>
