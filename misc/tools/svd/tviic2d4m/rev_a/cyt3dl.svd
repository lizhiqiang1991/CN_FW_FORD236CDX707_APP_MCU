                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>FRAMERENDERING</name>
                          <description>Frame rendering mode (framebuffer).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LINERENDERING</name>
                          <description>Line rendering mode (linebuffer).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>PROXYSELECT</name>
                      <description>Proxy to use for the next operation</description>
                      <bitRange>[10:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>Proxy disabled.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FETCHLBH0</name>
                          <description>Proxy connected to FETCHLBH0.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FETCHLBH1</name>
                          <description>Proxy connected to FETCHLBH1.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FETCHLBH2</name>
                          <description>Proxy connected to FETCHLBH2.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FETCHLBH3</name>
                          <description>Proxy connected to FETCHLBH3.</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FETCHLBH4</name>
