                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS</name>
                  <description>Color component size of raw input data. Please note that the width must be equal or lower than the output width.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0x8F0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA</name>
                      <description>Component size of alpha channel [0-8].</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE</name>
                      <description>Component size of blue channel [0-10].</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN</name>
                      <description>Component size of green channel [0-10].</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED</name>
                      <description>Component size of red channel [0-10].</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ITUFORMAT</name>
                      <description>When ComponentBitsRed/Green/Blue is set to 10 and this mode enabled (value 1), then input format is considered 8.2 instead of 10.0 bits (max color is 1020 instead of 1023). This is compliant to ITU 656 standard.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT</name>
                  <description>Color component offset of raw input data.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x10080018</resetValue>
                  <resetMask>0x3F3F3F3F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA</name>
                      <description>Offset for alpha component.</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE</name>
                      <description>Offset for blue component.</description>
                      <bitRange>[13:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN</name>
                      <description>Offset for green component.</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED</name>
                      <description>Offset for red component.</description>
                      <bitRange>[29:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONSTANTCOLOR</name>
                  <description>Constant color register</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>CONSTANTALPHA</name>
                      <description>Alpha.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTBLUE</name>
                      <description>Blue or V (chroma).</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTGREEN</name>
                      <description>Green or U (chroma).</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTRED</name>
                      <description>Red or Y (luma).</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Common control settings.</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x1000</resetValue>
                  <resetMask>0x17FF1</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWENABLE</name>
                      <description>Value 1 enables the clip window feature.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RASTERMODE</name>
                      <description>Selects a method how generate output samples from input stream.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>Input stream is RGB(A) or YUV 4:4:4.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV422</name>
                          <description>Input stream is packed YUV 4:2:2.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUV422UPSAMPLINGMODE</name>
                      <description>Selects a method for horizontal up-sampling when RasterMode is YUV422.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>REPLICATE</name>
                          <description>Replicate mode for interspersed samples (UV samples between Y samples).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INTERPOLATE</name>
                          <description>Interpolate mode for coaligned samples (UV samples at Y sample positions).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE</name>
                      <description>Enables different kind of YUV to RGB conversions.</description>
                      <bitRange>[7:6]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion. Input data must be RGB.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RGBALPHASRCENABLE</name>
                      <description>Value 1 enables source alpha (extracted from input stream) for RGB pre-multiply. When disabled source alpha is set to 1.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHACONSTENABLE</name>
                      <description>Value 1 enables constant alpha (ConstAlpha field) for RGB pre-multiply. When disabled constant alpha is set to 1.</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHATRANSENABLE</name>
                      <description>Value 1 enables transparent alpha (0 or 1 depending on RGB matching ConstantColor setting) for RGB pre-multiply. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PREMULCONSTRGB</name>
                      <description>When enabled (value 1) the values given by ConstantRed/Green/Blue are used instead of alpha for source RGB pre-multiply. Settings RGBAlphaSrc/Const/TransEnable have no effect then.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHASRCENABLE</name>
                      <description>Value 1 enables source alpha for computing the output alpha. When disabled source alpha is set to 1.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHACONSTENABLE</name>
                      <description>Value 1 enables constant alpha for computing the output alpha. When disabled constant alpha is set to 1.</description>
                      <bitRange>[13:13]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHATRANSENABLE</name>
                      <description>Value 1 enables transparent alpha for computing the output alpha. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>GAMMAREMOVEENABLE</name>
                      <description>Value 1 enables the stage to remove a gamma from RGB components.</description>
                      <bitRange>[16:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROLTRIGGER</name>
                  <description>ExtSrc unit trigger token generation</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>SHDTOKGEN</name>
                      <description>Write a 1 to this field for the extsrc unit to perform a shadow load with the next start of operation and set the rld bit in the start of frame control word (generate shadow load token for subsequent units).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>START</name>
                  <description>ExtSrc unit start register</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>START</name>
                      <description>Writing a one starts processing, use this only for debug purposes.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>STORE4</name>
                <description>Store #0 (Capture)</description>
                <addressOffset>0x00004400</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Store unit static control register.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x111</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SINGLEFRAMEOPERATION</name>
                      <description>If this field and ShdEn are enabled, only frames with reload bit in command word are written to AXI, other frames are still consumed. If disabled all frames are writen to AXI</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BASEADDRESSAUTOUPDATE</name>
                      <description>If enabled (value 1) the base address is automatically updated at the start of each frame. This update is then executed independently of the ShdEn setting. When disabled ShdEn controls the update of the base address operation register.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERMANAGEMENT</name>
                  <description>Burst Buffer setup register.</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x400</resetValue>
                  <resetMask>0x1F00</resetMask>
                  <fields>
                    <field>
                      <name>SETBURSTLENGTH</name>
                      <description>Set this to the burst length that should be used on the AXI interface. Please note that SetBurstLength has to be smaller or equal to MaxBurstLength. Only a power of two may be specified as burst length. Please set this to at least 2 for 64bit pixels, otherwise performance will suffer.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RINGBUFSTARTADDR</name>
                  <description>Ring buffer setup for destination.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RINGBUFSTARTADDR</name>
                      <description>Start address of the ring buffer. Must be aligned to SetBurstLength x 8 bytes.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RINGBUFWRAPADDR</name>
                  <description>Ring buffer setup for destination.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RINGBUFWRAPADDR</name>
                      <description>End address of the ring buffer (last byte of the buffer plus one).</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BASEADDRESS</name>
                  <description>Destination buffer base address.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BASEADDRESS</name>
                      <description>Byte aligned start address of the destination buffer. For 32 bit pixels BaseAddress[1:0] must be set 0 and for 16 bit pixels BaseAddress[0] must be set 0.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DESTINATIONBUFFERATTRIBUTES</name>
                  <description>Destination buffer attributes.</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x200004FF</resetValue>
                  <resetMask>0x7F01FFFF</resetMask>
                  <fields>
                    <field>
                      <name>STRIDE</name>
                      <description>Destination buffer stride in bytes minus one, used for address generation. For a pixel width of 32 bits Stride has to be dividable by 4 and given minus one and for a pixel width of 16 bit Stride has to be dividable by two and given minus one.</description>
                      <bitRange>[16:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BITSPERPIXEL</name>
                      <description>Size of a pixel in the destination buffer in bits. Has to be a power of two, 18 or 24. When 64 bit is selected, input pixels are converted into a 32 bit value that is replicated into low and high word of the 64 bit output. Set SetBurstLength at least to 2 in that case to get best possible performance.</description>
                      <bitRange>[30:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DESTINATIONBUFFERDIMENSION</name>
                  <description>Destination buffer dimension.</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3FFF3FFF</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>LINEWIDTH</name>
                      <description>Width of the destination buffer in pixels minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINECOUNT</name>
                      <description>Number of lines of the destination buffer in pixels minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMEOFFSET</name>
                  <description>Offset between destination frame and buffer.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>FRAMEXOFFSET</name>
                      <description>Horizontal offset (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FRAMEYOFFSET</name>
                      <description>Vertical offset (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS</name>
                  <description>Color component size of destination buffer</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0xF0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA</name>
                      <description>Alpha component bits.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE</name>
                      <description>Blue/V component bits.</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN</name>
                      <description>Green/U component bits.</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED</name>
                      <description>Red/Y component bits.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT</name>
                  <description>Color component offset of destination buffer.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x18100800</resetValue>
                  <resetMask>0x1F1F1F1F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA</name>
                      <description>Alpha component shift.</description>
                      <bitRange>[4:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE</name>
                      <description>Blue/V component shift.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN</name>
                      <description>Green/U component shift.</description>
                      <bitRange>[20:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED</name>
                      <description>Red/Y component shift.</description>
                      <bitRange>[28:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Store unit dynamic control register</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3F10F3</resetMask>
                  <fields>
                    <field>
                      <name>COLORDITHERENABLE</name>
                      <description>Controls whether spatial dithering (value 1) or LSB truncation (value 0) is used when ComponentBitsRed/Green/Blue is smaller than 10 bits.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHADITHERENABLE</name>
                      <description>Controls whether spatial dithering (value 1) or LSB truncation (value 0) is used when ComponentBitsAlpha is smaller than 8 bits.</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DITHEROFFSET</name>
                      <description>Dither offset that is additionally applied to the spatial offset, which is internally generated from the pixel position. Can be used by SW to generate image sequences with temporal dithering.</description>
                      <bitRange>[7:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>GAMMAAPPLYENABLE</name>
                      <description>Enable gamma conversion stage to apply gamma function. This gamma function converts the pixel data from linear color space to non-linear color space before writing it to AXI.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE</name>
                      <description>Enables different kind of RGB to YUV conversions.</description>
                      <bitRange>[17:16]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion. Input data must be RGB.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RASTERMODE</name>
                      <description>Selects a method for destination buffer data from input pixels.</description>
                      <bitRange>[19:18]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>RGBA or YUV 4:4:4 pixel buffer.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV422</name>
                          <description>Packed YUV 4:2:2 pixel buffer. Effect is that U samples are written for pixels with even and V samples for odd column index only. So BitsPerPixel must be set to the size that a pair of YU or YV has in memory (most typically 16 bits). All correlated widths and horizontal offsets must be even.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENCODE</name>
                          <description>RLAD compressed bit stream.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUV422DOWNSAMPLINGMODE</name>
                      <description>Selects a method for horizontal down-sampling when RasterMode is YUV422.</description>
                      <bitRange>[21:20]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEAREST</name>
                          <description>Nearest mode. Discards all odd samples, outputs even samples.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COALIGNED</name>
                          <description>Linear coaligned mode. 3 nearest UV samples are combined in linear filter to get one output sample.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INTERSPERSED</name>
                          <description>Linear interspersed mode. 2 nearest UV samples are combined in linear filter to get one output sample.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ENCODECONTROL</name>
                  <description>Control options for RLAD compression.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x88880001</resetValue>
                  <resetMask>0xFFFF0001</resetMask>
                  <fields>
                    <field>
                      <name>COMPRESSIONMODE</name>
                      <description>Algorithm to use for compression.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>RLAD</name>
                          <description>Run-Length Adaptive Dithering (lossy compression).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLAD_UNIFORM</name>
                          <description>Run-Length Adaptive Dithering (lossy compression; uniform package size).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RLADCOMPBITSRED</name>
                      <description>Maximum for average number of bits per compressed pixel for Red or Y (luma) channel.</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSGREEN</name>
                      <description>Maximum for average number of bits per compressed pixel for Green or U (chroma) channel.</description>
                      <bitRange>[23:20]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSBLUE</name>
                      <description>Maximum for average number of bits per compressed pixel for Blue or V (chroma) channel.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSALPHA</name>
                      <description>Maximum for average number of bits per compressed pixel for Alpha channel.</description>
                      <bitRange>[31:28]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DESTINATIONBUFFERLENGTH</name>
                  <description>Destination buffer length for compressed data.</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RLEWORDSMAX</name>
                      <description>N/A</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>START</name>
                  <description>Store unit start register</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>START</name>
                      <description>Writing a one starts processing of the pixel engine.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ENCODERSTATUS</name>
                  <description>Status information of the RLAD encoder.</description>
                  <addressOffset>0x38</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x1FFFFFFF</resetValue>
                  <resetMask>0x9FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RLEWORDS</name>
                      <description>Number of 32-bit words minus one that was used for the compressed buffer.</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>BUFFERTOOSMALL</name>
                      <description>The buffer size given by RLEWordsMax is too small. Not the complete input frame could be encoded.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>WRITEADDRESS</name>
                  <description>Ring buffer synchronization.</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>WRITEADDRESS</name>
                      <description>Last burst address that was written to the destination buffer.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMEPROPERTIES</name>
                  <description>Ring buffer synchronization.</description>
                  <addressOffset>0x40</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>FIELDID</name>
                      <description>Field identifier for interlaced video streams (0/1 = even/odd line indices of progressive frame). Status is updated with begin of a new field.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERPROPERTIES</name>
                  <description>Burst Buffer Property register</description>
                  <addressOffset>0x44</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>MAXBURSTLENGTH</name>
                      <description>Maximum Burst Length that can be configured.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LASTCONTROLWORD</name>
                  <description>Shows the last control word received</description>
                  <addressOffset>0x48</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>L_VAL</name>
                      <description>Shows the last control word received from the pixel engine. If a 39 bit pixel channel is connected, the mapping is as follows: l_val[31:0] = { data[37:22], data[19:12], data[9:2] }. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERFCOUNTER</name>
                  <description>Performance counter result</description>
                  <addressOffset>0x4C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERFRESULT</name>
                      <description>Returns the performance counter value. Please note that a sw reset during a frame can potentially produce invalid results in the first frame afterwards. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>FETCHLAYER0</name>
                <description>FetchLayer #0 (Display)</description>
                <addressOffset>0x00004800</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Common static control options.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xFF000002</resetValue>
                  <resetMask>0xFFFF0003</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LBHSHDEN</name>
                      <description>Enables shadowing of LBH configuration signals.</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BASEADDRESSAUTOUPDATE</name>
                      <description>Enable flag for continuous shadow load of BaseAddress field for each layer (layer index = bit index). When set to 1 the active BaseAddress configuration is loaded from shadow at start of each frame. This update is then executed independently from other RWS type fields. ShdEn must be enabled for this mode.
When the flag is enabled for layer 0, also the FieldId0 shadow is automatically loaded.</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SHDLDREQSTICKY</name>
                      <description>Shadow load request flags for each layer (always load). See description of register TriggerEnable for further information.</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERMANAGEMENT</name>
                  <description>AXI interface buffer management register</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x204</resetValue>
                  <resetMask>0x80001FFF</resetMask>
                  <fields>
                    <field>
                      <name>SETNUMBUFFERS</name>
                      <description>Set this to the number of bursts that should be buffered. SetNumBuffers has to be smaller or equal to ManagedBurstBuffers and SetNumBuffers * SetBurstLength has to be smaller or equal to ManagedBurstBuffers * BurstLengthForMaxBuffers. Must be a power of 2. The minimum allowed settings is 4 except for the FetchEco derivate which has a minimum allowed setting of 2.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SETBURSTLENGTH</name>
                      <description>Set this to the burst length that should be used on the AXI interface. SetNumBuffers * SetBurstLength has to be smaller or equal to ManagedBurstBuffers * BurstLengthForMaxBuffers and that bursts larger than 16 are not possible on the axi interface. Only a power of two may be specified as burst length.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINEMODE</name>
                      <description>Fetch buffer cache control.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISPLAY</name>
                          <description>Mandatory setting for operation in the Display Controller. Works also for Blit Engine with marginal performance impact.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLIT</name>
                          <description>Recommended setting for operation in the Blit Engine.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BASEADDRESS0</name>
                  <description>Source buffer base address of layer 0.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BASEADDRESS0</name>
                      <description>Byte aligned start address of the layer source buffer. For a pixel width of 32 bits or DECODE operations BaseAddress bits 1 downto 0 have to be 0 and for a pixel width of 16 bit BaseAddress[0] has to be 0.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERATTRIBUTES0</name>
                  <description>Source buffer attributes for layer 0.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x2004FF</resetValue>
                  <resetMask>0x3FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>STRIDE0</name>
                      <description>Source buffer stride of the layer in bytes minus one, used for address generation. For a pixel width of 32 bits Stride has to be dividable by 4 and given minus one and for a pixel width of 16 bit Stride has to be dividable by two and given minus one.</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BITSPERPIXEL0</name>
                      <description>Number of bits per pixel in the source buffer. Must be 1, 2, 4, 8, 16, 18, 24 or 32. [Exception] FetchEco does not support 18 and 24.</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERDIMENSION0</name>
                  <description>Source buffer dimension of layer 0.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3FFF3FFF</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>LINEWIDTH0</name>
                      <description>Width of the source buffer of the layer in pixels minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINECOUNT0</name>
                      <description>Number of lines of the source buffer of the layer minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS0</name>
                  <description>Size of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0x8F0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ITUFORMAT0</name>
                      <description>When ComponentBitsRed/Green/Blue is set to 10 and this mode enabled (value 1), then input format is considered 8.2 instead of 10.0 bits (max color is 1020 instead of 1023). This is compliant to ITU 656 standard.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT0</name>
                  <description>Bit position of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x18100800</resetValue>
                  <resetMask>0x1F1F1F1F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[4:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[20:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[28:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYEROFFSET0</name>
                  <description>Position of layer 0 within the destination frame.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>LAYERXOFFSET0</name>
                      <description>Horizontal offset (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LAYERYOFFSET0</name>
                      <description>Vertical offset (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWOFFSET0</name>
                  <description>Clip window position for layer 0.</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWXOFFSET0</name>
                      <description>Horizontal position (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWYOFFSET0</name>
                      <description>Vertical position (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWDIMENSIONS0</name>
                  <description>Clip window size for layer 0.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWWIDTH0</name>
                      <description>Width.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWHEIGHT0</name>
                      <description>Height.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONSTANTCOLOR0</name>
                  <description>Constant color for layer 0.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>CONSTANTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTRED0</name>
                      <description>Red and Y (luma).</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYERPROPERTY0</name>
                  <description>Common properties of layer 0.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xB8000008</resetValue>
                  <resetMask>0xFFFF7DDF</resetMask>
                  <fields>
                    <field>
                      <name>PALETTEENABLE0</name>
                      <description>Enables (value = 1) a color palette with 8 bits input and 24 bits output. Lower bits of the lookup index are read from memory (PaletteIdWidth0), upper bits are set to index of this layer. Palette output is extended by upper bits of index word read from memory (e.g. to store alpha together with index). Result is mapped to color channels according to ColorComponentBits/Shift settings.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILEMODE0</name>
                      <description>Select the tile mode for pixels outside the source buffer. Clip color (0,0,0,0) takes precedence if a pixel becomes subject to both tiling and clipping.</description>
                      <bitRange>[2:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TILE_FILL_ZERO</name>
                          <description>Use zero value</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_FILL_CONSTANT</name>
                          <description>Use constant color register value</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD</name>
                          <description>Use closest pixel from source buffer. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD_ZERO</name>
                          <description>Use closest pixel from source buffer but zero for alpha component. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha for computing the output alpha. When disabled source alpha is set to 1.</description>
                      <bitRange>[3:3]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha for computing the output alpha. When disabled constant alpha is set to 1.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha for computing the output alpha. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[6:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha (stored together with color component in the source buffer) for RGB pre-multiply. When disabled source alpha is set to 1.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha (ConstAlpha fields) for RGB pre-multiply. When disabled constant alpha is set to 1.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha (0 or 1 depending on RGB matching ConstantColor setting) for RGB pre-multiply. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PREMULCONSTRGB0</name>
                      <description>When enabled (value 1) the values given by ConstantRed/Green/Blue are used instead of alpha for source RGB pre-multiply. Settings RGBAlphaSrc/Const/Mask/TransEnable have no effect then.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE0</name>
                      <description>Enables different kind of YUV to RGB conversions.</description>
                      <bitRange>[13:12]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GAMMAREMOVEENABLE0</name>
                      <description>Value 1 enables the stage to remove a gamma from RGB components.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
