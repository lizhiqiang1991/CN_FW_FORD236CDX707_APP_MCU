                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DUAL</name>
                      <description>FPDlink 0 and 1 are operating synchronously, both driven by Display Engine 0.</description>
                      <value>1</value>
                    </enumeratedValue>
