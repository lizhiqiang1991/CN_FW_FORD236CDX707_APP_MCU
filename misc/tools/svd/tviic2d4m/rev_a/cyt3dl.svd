                <register>
                  <dim>2048</dim>
                  <dimIncrement>4</dimIncrement>
                  <name>PALETTE[%s]</name>
                  <description>Shared Palette Memory.</description>
                  <addressOffset>0x2000</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PALETTEENTRY</name>
                      <description>Shared palette entry with 24-bit. Color format can be defined by Fetch configuration.</description>
                      <bitRange>[23:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>FETCHSRC</name>
                <description>Fetch SRC</description>
                <addressOffset>0x00004000</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Common static control options.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFF0001</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BASEADDRESSAUTOUPDATE</name>
                      <description>Enable flag for continuous shadow load of BaseAddress field for each layer (layer index = bit index). When set to 1 the active BaseAddress configuration is loaded from shadow at start of each frame. This update is then executed independently from other RWS type fields. ShdEn must be enabled for this mode.
When the flag is enabled for layer 0, also the FieldId0 shadow is automatically loaded.</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERMANAGEMENT</name>
                  <description>AXI interface buffer management register</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x204</resetValue>
                  <resetMask>0x80001FFF</resetMask>
                  <fields>
                    <field>
                      <name>SETNUMBUFFERS</name>
                      <description>Set this to the number of bursts that should be buffered. SetNumBuffers has to be smaller or equal to ManagedBurstBuffers and SetNumBuffers * SetBurstLength has to be smaller or equal to ManagedBurstBuffers * BurstLengthForMaxBuffers. Must be a power of 2. The minimum allowed settings is 4 except for the FetchEco derivate which has a minimum allowed setting of 2.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SETBURSTLENGTH</name>
                      <description>Set this to the burst length that should be used on the AXI interface. SetNumBuffers * SetBurstLength has to be smaller or equal to ManagedBurstBuffers * BurstLengthForMaxBuffers and that bursts larger than 16 are not possible on the axi interface. Only a power of two may be specified as burst length.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINEMODE</name>
                      <description>Fetch buffer cache control.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISPLAY</name>
                          <description>Mandatory setting for operation in the Display Controller. Works also for Blit Engine with marginal performance impact.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLIT</name>
                          <description>Recommended setting for operation in the Blit Engine.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BASEADDRESS0</name>
                  <description>Source buffer base address of layer 0.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BASEADDRESS0</name>
                      <description>Byte aligned start address of the layer source buffer. For a pixel width of 32 bits or DECODE operations BaseAddress bits 1 downto 0 have to be 0 and for a pixel width of 16 bit BaseAddress[0] has to be 0.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERATTRIBUTES0</name>
                  <description>Source buffer attributes for layer 0.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x2004FF</resetValue>
                  <resetMask>0x3FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>STRIDE0</name>
                      <description>Source buffer stride of the layer in bytes minus one, used for address generation. For a pixel width of 32 bits Stride has to be dividable by 4 and given minus one and for a pixel width of 16 bit Stride has to be dividable by two and given minus one.</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BITSPERPIXEL0</name>
                      <description>Number of bits per pixel in the source buffer. Must be 1, 2, 4, 8, 16, 18, 24 or 32. [Exception] FetchEco does not support 18 and 24.</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERDIMENSION0</name>
                  <description>Source buffer dimension of layer 0.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3FFF3FFF</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>LINEWIDTH0</name>
                      <description>Width of the source buffer of the layer in pixels minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINECOUNT0</name>
                      <description>Number of lines of the source buffer of the layer minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS0</name>
                  <description>Size of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0x8F0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ITUFORMAT0</name>
                      <description>When ComponentBitsRed/Green/Blue is set to 10 and this mode enabled (value 1), then input format is considered 8.2 instead of 10.0 bits (max color is 1020 instead of 1023). This is compliant to ITU 656 standard.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT0</name>
                  <description>Bit position of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x18100800</resetValue>
                  <resetMask>0x1F1F1F1F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[4:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[20:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[28:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYEROFFSET0</name>
                  <description>Position of layer 0 within the destination frame.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>LAYERXOFFSET0</name>
                      <description>Horizontal offset (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LAYERYOFFSET0</name>
                      <description>Vertical offset (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWOFFSET0</name>
                  <description>Clip window position for layer 0.</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWXOFFSET0</name>
                      <description>Horizontal position (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWYOFFSET0</name>
                      <description>Vertical position (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWDIMENSIONS0</name>
                  <description>Clip window size for layer 0.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWWIDTH0</name>
                      <description>Width.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWHEIGHT0</name>
                      <description>Height.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONSTANTCOLOR0</name>
                  <description>Constant color for layer 0.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>CONSTANTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTRED0</name>
                      <description>Red and Y (luma).</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYERPROPERTY0</name>
                  <description>Common properties of layer 0.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xB8000008</resetValue>
                  <resetMask>0xFFFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>PALETTEENABLE0</name>
                      <description>Enables (value = 1) a color palette with 8 bits input and 24 bits output. Lower bits of the lookup index are read from memory (PaletteIdWidth0), upper bits are set to index of this layer. Palette output is extended by upper bits of index word read from memory (e.g. to store alpha together with index). Result is mapped to color channels according to ColorComponentBits/Shift settings.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILEMODE0</name>
                      <description>Select the tile mode for pixels outside the source buffer. Clip color (0,0,0,0) takes precedence if a pixel becomes subject to both tiling and clipping.</description>
                      <bitRange>[2:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TILE_FILL_ZERO</name>
                          <description>Use zero value</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_FILL_CONSTANT</name>
                          <description>Use constant color register value</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD</name>
                          <description>Use closest pixel from source buffer. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD_ZERO</name>
                          <description>Use closest pixel from source buffer but zero for alpha component. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha for computing the output alpha. When disabled source alpha is set to 1.</description>
                      <bitRange>[3:3]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha for computing the output alpha. When disabled constant alpha is set to 1.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHAMASKENABLE0</name>
                      <description>Value 1 enables mask alpha for computing the output alpha. When disabled mask alpha is set to 1.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha for computing the output alpha. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[6:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha (stored together with color component in the source buffer) for RGB pre-multiply. When disabled source alpha is set to 1.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha (ConstAlpha fields) for RGB pre-multiply. When disabled constant alpha is set to 1.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHAMASKENABLE0</name>
                      <description>Value 1 enables mask alpha (read by another Fetch unit from a separate alpha layer) for RGB pre-multiply. When disabled mask alpha is set to 1. Alpha mask input must be enabled for this field to have effect.</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha (0 or 1 depending on RGB matching ConstantColor setting) for RGB pre-multiply. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PREMULCONSTRGB0</name>
                      <description>When enabled (value 1) the values given by ConstantRed/Green/Blue are used instead of alpha for source RGB pre-multiply. Settings RGBAlphaSrc/Const/Mask/TransEnable have no effect then.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE0</name>
                      <description>Enables different kind of YUV to RGB conversions.</description>
                      <bitRange>[13:12]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GAMMAREMOVEENABLE0</name>
                      <description>Value 1 enables the stage to remove a gamma from RGB components.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEOFFSET0</name>
                      <description>Palette may contain multiple areas. This offset shows to the starting position of the currently used area.</description>
                      <bitRange>[26:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEIDWIDTH0</name>
                      <description>Number minus one of least significant bits of pixel data read from the source buffer that are used as index value for color palette look-up.</description>
                      <bitRange>[29:27]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWENABLE0</name>
                      <description>Value 1 enables the clip window for this layer. Pixels outside the clip window get the clip color, pixels inside the source or tiling color.</description>
                      <bitRange>[30:30]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SOURCEBUFFERENABLE0</name>
                      <description>Value 1 enables the source buffer for this layer. When disabled the tiling color is used only (TileMode TILE_PAD not allowed).</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMEDIMENSIONS</name>
                  <description>Output frame dimension.</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xEF013F</resetValue>
                  <resetMask>0xBFFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>FRAMEWIDTH</name>
                      <description>Frame width minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FRAMEHEIGHT</name>
                      <description>Frame height minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>EMPTYFRAME</name>
                      <description>When enabled output frame is empty. FrameWidth/Height settings have no effect then. Can be used to load shadows or to generate synchronization signals only (frame/sequence complete). If enabled, InputSelect must be set to INACTIVE.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMERESAMPLING</name>
                  <description>Resampling options for output frame.</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x104000</resetValue>
                  <resetMask>0x1FFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>STARTX</name>
                      <description>X coordinate of first sample point relative to origin.
(format is signed fix-point 4.2)</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>STARTY</name>
                      <description>Y coordinate of first sample point relative to origin.
(format is signed fix-point 4.2)</description>
                      <bitRange>[11:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DELTAX</name>
                      <description>Increment of X coordinate for horizontal step in destination frame.
(format is signed fix-point 4.2)</description>
                      <bitRange>[17:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DELTAY</name>
                      <description>Increment of Y coordinate for vertical step in destination frame.
(format is signed fix-point 4.2)</description>
                      <bitRange>[23:18]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SWAPDIRECTION</name>
                      <description>Swaps X and Y directions for re-sampling. When enabled (= 1) DeltaY is applied for horizontal and DeltaX for vertical step on destination frame.</description>
                      <bitRange>[24:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>WARPCONTROL</name>
                  <description>Warping control options.</description>
                  <addressOffset>0x38</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x20</resetValue>
                  <resetMask>0x133F</resetMask>
                  <fields>
                    <field>
                      <name>WARPBITSPERPIXEL</name>
                      <description>Number of bits per pixel in the coordinate layer, which is read by another Fetch unit. Has to be 1, 2, 4, 8, 16 or 32.</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>WARPCOORDINATEMODE</name>
                      <description>Content of pixel data in the coordinate layer.</description>
                      <bitRange>[9:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PNT</name>
                          <description>x and y (sample points).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>D_PNT</name>
                          <description>dx and dy (vectors between adjacent sample points).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DD_PNT</name>
                          <description>ddx and ddy (deltas between adjacent vectors).</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>WARPSYMMETRICOFFSET</name>
                      <description>Value 1 enables symmetric range for negative and positive coordinate values by adding an offset of +0.03125 internally to all coordinate input values. Recommended for small coordinate formats in DD_PNT mode.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTX</name>
                  <description>Start value X for affine/perspective warping.</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTX</name>
                      <description>Start value for homogenous X coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTY</name>
                  <description>Start value Y for affine/perspective warping.</description>
                  <addressOffset>0x40</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTY</name>
                      <description>Start value for homogenous Y coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXX</name>
                  <description>DeltaXX increment for affine/perspective warping.</description>
                  <addressOffset>0x44</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXX</name>
                      <description>Increment of homogenous X coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYY</name>
                  <description>DeltaYY increment for affine/perspective warping.</description>
                  <addressOffset>0x48</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYY</name>
                      <description>Increment of homogenous Y coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXY</name>
                  <description>DeltaXY increment for affine/perspective warping.</description>
                  <addressOffset>0x4C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXY</name>
                      <description>Increment of homogenous Y coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYX</name>
                  <description>DeltaYX increment for affine/perspective warping.</description>
                  <addressOffset>0x50</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYX</name>
                      <description>Increment of homogenous X coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTW</name>
                  <description>Start value W for perspective warping.</description>
                  <addressOffset>0x54</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTW</name>
                      <description>Start value for homogenous W coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXW</name>
                  <description>DeltaWX increment for perspective warping.</description>
                  <addressOffset>0x58</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXW</name>
                      <description>Increment of homogenous W coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYW</name>
                  <description>DeltaWY increment for perspective warping.</description>
                  <addressOffset>0x5C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYW</name>
                      <description>Increment of homogenous W coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBSTARTX</name>
                  <description>Start value X for arbitrary warping.</description>
                  <addressOffset>0x60</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBSTARTX</name>
                      <description>Start point for sample-point interpolation (X coordinate).
(format is signed fix-point 16.5)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBSTARTY</name>
                  <description>Start value Y for arbitrary warping.</description>
                  <addressOffset>0x64</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBSTARTY</name>
                      <description>Start point for sample-point interpolation (Y coordinate).
(format is signed fix-point 16.5)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBDELTA</name>
                  <description>Start values for delta incrementation of arbitrary warping.</description>
                  <addressOffset>0x68</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBDELTAXX</name>
                      <description>X coordinate of vector between first and second sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAXY</name>
                      <description>Y coordinate of vector between first and second sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAYX</name>
                      <description>X coordinate of vector between start and first sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAYY</name>
                      <description>Y coordinate of vector between start and first sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FIRPOSITIONS</name>
                  <description>FIR sequence control register.</description>
                  <addressOffset>0x6C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xA965</resetValue>
                  <resetMask>0xFFFF</resetMask>
                  <fields>
                    <field>
                      <name>FIR0POSITION</name>
                      <description>Position of first pixel.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR1POSITION</name>
                      <description>Position of second pixel.</description>
                      <bitRange>[7:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR2POSITION</name>
                      <description>Position of third pixel.</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR3POSITION</name>
                      <description>Position of fourth pixel.</description>
                      <bitRange>[15:12]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FIRCOEFFICIENTS</name>
                  <description>FIR coefficients register.</description>
                  <addressOffset>0x70</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x20</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>FIR0COEFFICIENT</name>
                      <description>First coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR1COEFFICIENT</name>
                      <description>Second coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR2COEFFICIENT</name>
                      <description>Third coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR3COEFFICIENT</name>
                      <description>Fourth coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DECODECONTROL</name>
                  <description>Control options for RLAD decompression.</description>
                  <addressOffset>0x74</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x88880001</resetValue>
                  <resetMask>0xFFFF0003</resetMask>
                  <fields>
                    <field>
                      <name>COMPRESSIONMODE</name>
                      <description>Algorithm that the encoder used for compression.</description>
                      <bitRange>[1:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>RLAD</name>
                          <description>Run-Length Adaptive Dithering (lossy compression).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLAD_UNIFORM</name>
                          <description>Run-Length Adaptive Dithering (lossy compression; uniform package size).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLA</name>
                          <description>Run-Length Adaptive (lossless compression).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RL</name>
                          <description>Standard Run-Length. In contrary to other modes is in big endian format.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RLADCOMPBITSRED</name>
                      <description>Maximum for average number of bits per compressed pixel for Red or Y (luma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSGREEN</name>
                      <description>Maximum for average number of bits per compressed pixel for Green or U (chroma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[23:20]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSBLUE</name>
                      <description>Maximum for average number of bits per compressed pixel for Blue or V (chroma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSALPHA</name>
                      <description>Maximum for average number of bits per compressed pixel for Alpha channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[31:28]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERLENGTH</name>
                  <description>Source buffer length for compressed data.</description>
                  <addressOffset>0x78</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RLEWORDS</name>
                      <description>Number of 32-bit words minus one that are required to decode the run length encoded source buffer.</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Shared common control settings for all layers.</description>
                  <addressOffset>0x7C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x30010000</resetValue>
                  <resetMask>0x307100BF</resetMask>
                  <fields>
                    <field>
                      <name>RASTERMODE</name>
                      <description>Selects a method how to generate source buffer sample points.</description>
                      <bitRange>[2:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>[IBO only, for LBO use PERSPECTIVE with corresponding Geometry] First sample at StartX/Y relative to origin. Hor/ver increments using DeltaX/Y and DeltaSwap setup.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DECODE</name>
                          <description>[FetchDecode/FetchBlit only] Source buffer is an encoded bit stream. First sample at origin (0,0). Hor/ver increments = (1,0)/(0,1).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ARBITRARY</name>
                          <description>[FetchBlit/Warp only] Arbitrary warping (filter is active). Coordinates are read from frame input port. InputSelect must be set to COORDINATE. ArbStartX/Y and ArbDeltaXX/XY/YX/YY must be setup.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSPECTIVE</name>
                          <description>[FetchBlit only] Affine/Perspective warping (filter is active). First sample at PerspStartX/Y/W. Hor/ver increments using PerspDeltaXX/XY/YX/YY/WX/WY. Homogeneous coordinates. See also field Geometry to reduce coordinate amount.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV422</name>
                          <description>[FetchBlit/Decode only] Source buffer is packed YUV 422. First sample at origin (0,0). Hor/ver increments = (1,0)/(0,1). All correllated window widths and horizontal offsets must be even.</description>
                          <value>4</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>INPUTSELECT</name>
                      <description>Selects function for the frame input port.</description>
                      <bitRange>[4:3]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>INACTIVE</name>
                          <description>Not used.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COMPPACK</name>
                          <description>Used for component packing (e.g. UV or source alpha buffer).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ALPHAMASK</name>
                          <description>Used for RGB and alpha pre-multiply stage (mask alpha buffer).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COORDINATE</name>
                          <description>Used for arbitrary warping (coordinate buffer).</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUV422UPSAMPLINGMODE</name>
                      <description>Selects a method for horizontal up-sampling of YUV 422/420 input data.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>REPLICATE</name>
                          <description>Replicate mode for interspersed samples (UV samples between Y samples).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INTERPOLATE</name>
                          <description>Interpolate mode for coaligned samples (UV samples at Y sample positions).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RAWPIXEL</name>
                      <description>Raw pixel mode. If enabled (value = 1), the ComponentBits/Shift settings are replaced for all layers by fixed values that allow passing the pixel data read from memory unchanged to subsequent units (e.g. for reading coordinate layers). Multiply stages and transparent color are deactivated. Skip and Tile pixels are not affected by this setting.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPCOLOR</name>
                      <description>Selects which color to take for pixels that do not lie inside the clip window of any layer.</description>
                      <bitRange>[16:16]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NULL</name>
                          <description>Null color.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYER</name>
                          <description>Color of layer number given by ClipLayer (or layer 0 when Fetch unit has one layer only). The color is then the layer's source or tiling color.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>FILTERMODE</name>
                      <description>Use this to select between nearest and bilinear filtering. Only has an effect if rastermode == ARBITRARY or rastermode == PERSPECTIVE or rastermode == AFFINE.</description>
                      <bitRange>[22:20]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEAREST</name>
                          <description>Chooses pixel closest to sample point</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BILINEAR</name>
                          <description>Calculates result from 4 pixels closest to sample point</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FIR2</name>
                          <description>FIR mode with 2 programmable pixel positions and coefficients</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FIR4</name>
                          <description>FIR mode with 4 programmable pixel positions and coefficients</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>HOR_LINEAR</name>
                          <description>Calculates result from 2 pixels closest to the sample point and on the same line</description>
                          <value>4</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GEOMETRY</name>
                      <description>Control the geomety settings (PerspStartX/Y/W and PerspDeltaXX/XY/YX/YY/XW/YW usage) for the raster mode PERSPECTIVE.</description>
                      <bitRange>[29:28]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TRANSLATE</name>
                          <description>PerspStartX/Y are used. (PerspDeltaXY/YX/XW/YW are 0. PerspDeltaXX/YY and PerspStartW are 1.)</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SCALE</name>
                          <description>PerspStartX/Y and PerspDeltaXX/YY are used. (PerspDeltaXY/YX/XW/YW are 0. PerspStartW is 1.)</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROTATION</name>
                          <description>PerspStartX/Y and PerspDeltaXX/XY/YX/YY are used. (PerspDeltaXW/YW are 0. PerspStartW is 1.)</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSPECTIVE</name>
                          <description>All values PerspStartX/Y/W and PerspDeltaXX/XY/YX/YY/XW/YW are used</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROLTRIGGER</name>
                  <description>Shadow load trigger.</description>
                  <addressOffset>0x80</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>SHDTOKGEN</name>
                      <description>Writing a 1 to this will load shadow registers into the active configuration with the next start of frame and send a shadow load token to subsequent units.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>START</name>
                  <description>Frame start trigger.</description>
                  <addressOffset>0x84</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>START</name>
                      <description>Writing a 1 to this field will start generating one frame (for debugging purposes only).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FETCHTYPE</name>
                  <description>Fetch unit type.</description>
                  <addressOffset>0x88</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>FETCHTYPE</name>
                      <description>This field can be used to determine what kind of fetch unit this is.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-only</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DECODE</name>
                          <description>Fetch unit with RL and RLAD decoder.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYER</name>
                          <description>Fetch unit with fractional plane (8 layers).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>WARP</name>
                          <description>Fetch unit with arbitrary warping and fractional plane (8 layers).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ECO</name>
                          <description>Fetch unit with minimum feature set for alpha, chroma and coordinate planes.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSP</name>
                          <description>Fetch unit with affine, perspective and arbitrary warping.</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROT</name>
                          <description>Fetch unit with affine and arbitrary warping.</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DECODEL</name>
                          <description>Fetch unit with RL and RLAD decoder, reduced feature set.</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYERL</name>
                          <description>Fetch unit with fractional plane (8 layers), reduced feature set.</description>
                          <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROTL</name>
                          <description>Fetch unit with affine and arbitrary warping, reduced feature set.</description>
                          <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ECOL</name>
                          <description>Fetch unit with reduced minimum feature set for alpha, chroma and coordinate planes.</description>
                          <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLIT</name>
                          <description>Fetch unit with DECODE and PERSP capabilities.</description>
                          <value>10</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DECODERSTATUS</name>
                  <description>Status information of the RLAD decoder.</description>
                  <addressOffset>0x8C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3</resetMask>
                  <fields>
                    <field>
                      <name>BUFFERTOOSMALL</name>
                      <description>The buffer size given by RLEWords is too small. No complete output frame could be decoded.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BUFFERTOOLARGE</name>
                      <description>The buffer size given by RLEWords is too large. A complete output frame could be decoded, but more data was read than necessary.</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERPROPERTIES</name>
                  <description>Burst buffer properties.</description>
                  <addressOffset>0x90</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>MANAGEDBURSTBUFFERS</name>
                      <description>Maximum number of burst buffers that can be administrated in the AXI interface.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>BURSTLENGTHFORMAXBUFFERS</name>
                      <description>Maximum Burst Length that can be used when ManagedBurstBuffers burst buffers are used.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>FETCHDST</name>
                <description>Fetch DST (only for IBO)</description>
                <addressOffset>0x00004400</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Common static control options.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFF0001</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BASEADDRESSAUTOUPDATE</name>
                      <description>Enable flag for continuous shadow load of BaseAddress field for each layer (layer index = bit index). When set to 1 the active BaseAddress configuration is loaded from shadow at start of each frame. This update is then executed independently from other RWS type fields. ShdEn must be enabled for this mode.
When the flag is enabled for layer 0, also the FieldId0 shadow is automatically loaded.</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERMANAGEMENT</name>
                  <description>AXI interface buffer management register</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x204</resetValue>
                  <resetMask>0x80001FFF</resetMask>
                  <fields>
                    <field>
                      <name>SETNUMBUFFERS</name>
                      <description>Set this to the number of bursts that should be buffered. SetNumBuffers has to be smaller or equal to ManagedBurstBuffers and SetNumBuffers * SetBurstLength has to be smaller or equal to ManagedBurstBuffers * BurstLengthForMaxBuffers. Must be a power of 2. The minimum allowed settings is 4 except for the FetchEco derivate which has a minimum allowed setting of 2.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SETBURSTLENGTH</name>
                      <description>Set this to the burst length that should be used on the AXI interface. SetNumBuffers * SetBurstLength has to be smaller or equal to ManagedBurstBuffers * BurstLengthForMaxBuffers and that bursts larger than 16 are not possible on the axi interface. Only a power of two may be specified as burst length.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINEMODE</name>
                      <description>Fetch buffer cache control.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISPLAY</name>
                          <description>Mandatory setting for operation in the Display Controller. Works also for Blit Engine with marginal performance impact.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLIT</name>
                          <description>Recommended setting for operation in the Blit Engine.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BASEADDRESS0</name>
                  <description>Source buffer base address of layer 0.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BASEADDRESS0</name>
                      <description>Byte aligned start address of the layer source buffer. For a pixel width of 32 bits or DECODE operations BaseAddress bits 1 downto 0 have to be 0 and for a pixel width of 16 bit BaseAddress[0] has to be 0.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERATTRIBUTES0</name>
                  <description>Source buffer attributes for layer 0.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x2004FF</resetValue>
                  <resetMask>0x3FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>STRIDE0</name>
                      <description>Source buffer stride of the layer in bytes minus one, used for address generation. For a pixel width of 32 bits Stride has to be dividable by 4 and given minus one and for a pixel width of 16 bit Stride has to be dividable by two and given minus one.</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BITSPERPIXEL0</name>
                      <description>Number of bits per pixel in the source buffer. Must be 1, 2, 4, 8, 16, 18, 24 or 32. [Exception] FetchEco does not support 18 and 24.</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERDIMENSION0</name>
                  <description>Source buffer dimension of layer 0.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3FFF3FFF</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>LINEWIDTH0</name>
                      <description>Width of the source buffer of the layer in pixels minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINECOUNT0</name>
                      <description>Number of lines of the source buffer of the layer minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS0</name>
                  <description>Size of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0x8F0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ITUFORMAT0</name>
                      <description>When ComponentBitsRed/Green/Blue is set to 10 and this mode enabled (value 1), then input format is considered 8.2 instead of 10.0 bits (max color is 1020 instead of 1023). This is compliant to ITU 656 standard.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT0</name>
                  <description>Bit position of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x18100800</resetValue>
                  <resetMask>0x1F1F1F1F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[4:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[20:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[28:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYEROFFSET0</name>
                  <description>Position of layer 0 within the destination frame.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>LAYERXOFFSET0</name>
                      <description>Horizontal offset (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LAYERYOFFSET0</name>
                      <description>Vertical offset (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWOFFSET0</name>
                  <description>Clip window position for layer 0.</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWXOFFSET0</name>
                      <description>Horizontal position (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWYOFFSET0</name>
                      <description>Vertical position (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWDIMENSIONS0</name>
                  <description>Clip window size for layer 0.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWWIDTH0</name>
                      <description>Width.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWHEIGHT0</name>
                      <description>Height.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONSTANTCOLOR0</name>
                  <description>Constant color for layer 0.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>CONSTANTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTRED0</name>
                      <description>Red and Y (luma).</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYERPROPERTY0</name>
                  <description>Common properties of layer 0.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xB8000008</resetValue>
                  <resetMask>0xFFFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>PALETTEENABLE0</name>
                      <description>Enables (value = 1) a color palette with 8 bits input and 24 bits output. Lower bits of the lookup index are read from memory (PaletteIdWidth0), upper bits are set to index of this layer. Palette output is extended by upper bits of index word read from memory (e.g. to store alpha together with index). Result is mapped to color channels according to ColorComponentBits/Shift settings.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILEMODE0</name>
                      <description>Select the tile mode for pixels outside the source buffer. Clip color (0,0,0,0) takes precedence if a pixel becomes subject to both tiling and clipping.</description>
                      <bitRange>[2:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TILE_FILL_ZERO</name>
                          <description>Use zero value</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_FILL_CONSTANT</name>
                          <description>Use constant color register value</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD</name>
                          <description>Use closest pixel from source buffer. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD_ZERO</name>
                          <description>Use closest pixel from source buffer but zero for alpha component. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha for computing the output alpha. When disabled source alpha is set to 1.</description>
                      <bitRange>[3:3]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha for computing the output alpha. When disabled constant alpha is set to 1.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHAMASKENABLE0</name>
                      <description>Value 1 enables mask alpha for computing the output alpha. When disabled mask alpha is set to 1.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha for computing the output alpha. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[6:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha (stored together with color component in the source buffer) for RGB pre-multiply. When disabled source alpha is set to 1.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha (ConstAlpha fields) for RGB pre-multiply. When disabled constant alpha is set to 1.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHAMASKENABLE0</name>
                      <description>Value 1 enables mask alpha (read by another Fetch unit from a separate alpha layer) for RGB pre-multiply. When disabled mask alpha is set to 1. Alpha mask input must be enabled for this field to have effect.</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha (0 or 1 depending on RGB matching ConstantColor setting) for RGB pre-multiply. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PREMULCONSTRGB0</name>
                      <description>When enabled (value 1) the values given by ConstantRed/Green/Blue are used instead of alpha for source RGB pre-multiply. Settings RGBAlphaSrc/Const/Mask/TransEnable have no effect then.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE0</name>
                      <description>Enables different kind of YUV to RGB conversions.</description>
                      <bitRange>[13:12]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GAMMAREMOVEENABLE0</name>
                      <description>Value 1 enables the stage to remove a gamma from RGB components.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEOFFSET0</name>
                      <description>Palette may contain multiple areas. This offset shows to the starting position of the currently used area.</description>
                      <bitRange>[26:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEIDWIDTH0</name>
                      <description>Number minus one of least significant bits of pixel data read from the source buffer that are used as index value for color palette look-up.</description>
                      <bitRange>[29:27]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWENABLE0</name>
                      <description>Value 1 enables the clip window for this layer. Pixels outside the clip window get the clip color, pixels inside the source or tiling color.</description>
                      <bitRange>[30:30]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SOURCEBUFFERENABLE0</name>
                      <description>Value 1 enables the source buffer for this layer. When disabled the tiling color is used only (TileMode TILE_PAD not allowed).</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMEDIMENSIONS</name>
                  <description>Output frame dimension.</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xEF013F</resetValue>
                  <resetMask>0xBFFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>FRAMEWIDTH</name>
                      <description>Frame width minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FRAMEHEIGHT</name>
                      <description>Frame height minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>EMPTYFRAME</name>
                      <description>When enabled output frame is empty. FrameWidth/Height settings have no effect then. Can be used to load shadows or to generate synchronization signals only (frame/sequence complete). If enabled, InputSelect must be set to INACTIVE.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMERESAMPLING</name>
                  <description>Resampling options for output frame.</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x104000</resetValue>
                  <resetMask>0x1FFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>STARTX</name>
                      <description>X coordinate of first sample point relative to origin.
(format is signed fix-point 4.2)</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>STARTY</name>
                      <description>Y coordinate of first sample point relative to origin.
(format is signed fix-point 4.2)</description>
                      <bitRange>[11:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DELTAX</name>
                      <description>Increment of X coordinate for horizontal step in destination frame.
(format is signed fix-point 4.2)</description>
                      <bitRange>[17:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DELTAY</name>
                      <description>Increment of Y coordinate for vertical step in destination frame.
(format is signed fix-point 4.2)</description>
                      <bitRange>[23:18]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SWAPDIRECTION</name>
                      <description>Swaps X and Y directions for re-sampling. When enabled (= 1) DeltaY is applied for horizontal and DeltaX for vertical step on destination frame.</description>
                      <bitRange>[24:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>WARPCONTROL</name>
                  <description>Warping control options.</description>
                  <addressOffset>0x38</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x20</resetValue>
                  <resetMask>0x133F</resetMask>
                  <fields>
                    <field>
                      <name>WARPBITSPERPIXEL</name>
                      <description>Number of bits per pixel in the coordinate layer, which is read by another Fetch unit. Has to be 1, 2, 4, 8, 16 or 32.</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>WARPCOORDINATEMODE</name>
                      <description>Content of pixel data in the coordinate layer.</description>
                      <bitRange>[9:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PNT</name>
                          <description>x and y (sample points).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>D_PNT</name>
                          <description>dx and dy (vectors between adjacent sample points).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DD_PNT</name>
                          <description>ddx and ddy (deltas between adjacent vectors).</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>WARPSYMMETRICOFFSET</name>
                      <description>Value 1 enables symmetric range for negative and positive coordinate values by adding an offset of +0.03125 internally to all coordinate input values. Recommended for small coordinate formats in DD_PNT mode.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTX</name>
                  <description>Start value X for affine/perspective warping.</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTX</name>
                      <description>Start value for homogenous X coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTY</name>
                  <description>Start value Y for affine/perspective warping.</description>
                  <addressOffset>0x40</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTY</name>
                      <description>Start value for homogenous Y coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXX</name>
                  <description>DeltaXX increment for affine/perspective warping.</description>
                  <addressOffset>0x44</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXX</name>
                      <description>Increment of homogenous X coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYY</name>
                  <description>DeltaYY increment for affine/perspective warping.</description>
                  <addressOffset>0x48</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYY</name>
                      <description>Increment of homogenous Y coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXY</name>
                  <description>DeltaXY increment for affine/perspective warping.</description>
                  <addressOffset>0x4C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXY</name>
                      <description>Increment of homogenous Y coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYX</name>
                  <description>DeltaYX increment for affine/perspective warping.</description>
                  <addressOffset>0x50</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYX</name>
                      <description>Increment of homogenous X coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTW</name>
                  <description>Start value W for perspective warping.</description>
                  <addressOffset>0x54</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTW</name>
                      <description>Start value for homogenous W coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXW</name>
                  <description>DeltaWX increment for perspective warping.</description>
                  <addressOffset>0x58</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXW</name>
                      <description>Increment of homogenous W coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYW</name>
                  <description>DeltaWY increment for perspective warping.</description>
                  <addressOffset>0x5C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYW</name>
                      <description>Increment of homogenous W coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBSTARTX</name>
                  <description>Start value X for arbitrary warping.</description>
                  <addressOffset>0x60</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBSTARTX</name>
                      <description>Start point for sample-point interpolation (X coordinate).
(format is signed fix-point 16.5)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBSTARTY</name>
                  <description>Start value Y for arbitrary warping.</description>
                  <addressOffset>0x64</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBSTARTY</name>
                      <description>Start point for sample-point interpolation (Y coordinate).
(format is signed fix-point 16.5)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBDELTA</name>
                  <description>Start values for delta incrementation of arbitrary warping.</description>
                  <addressOffset>0x68</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBDELTAXX</name>
                      <description>X coordinate of vector between first and second sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAXY</name>
                      <description>Y coordinate of vector between first and second sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAYX</name>
                      <description>X coordinate of vector between start and first sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAYY</name>
                      <description>Y coordinate of vector between start and first sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FIRPOSITIONS</name>
                  <description>FIR sequence control register.</description>
                  <addressOffset>0x6C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xA965</resetValue>
                  <resetMask>0xFFFF</resetMask>
                  <fields>
                    <field>
                      <name>FIR0POSITION</name>
                      <description>Position of first pixel.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR1POSITION</name>
                      <description>Position of second pixel.</description>
                      <bitRange>[7:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR2POSITION</name>
                      <description>Position of third pixel.</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR3POSITION</name>
                      <description>Position of fourth pixel.</description>
                      <bitRange>[15:12]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FIRCOEFFICIENTS</name>
                  <description>FIR coefficients register.</description>
                  <addressOffset>0x70</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x20</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>FIR0COEFFICIENT</name>
                      <description>First coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR1COEFFICIENT</name>
                      <description>Second coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR2COEFFICIENT</name>
                      <description>Third coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR3COEFFICIENT</name>
                      <description>Fourth coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DECODECONTROL</name>
                  <description>Control options for RLAD decompression.</description>
                  <addressOffset>0x74</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x88880001</resetValue>
                  <resetMask>0xFFFF0003</resetMask>
                  <fields>
                    <field>
                      <name>COMPRESSIONMODE</name>
                      <description>Algorithm that the encoder used for compression.</description>
                      <bitRange>[1:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>RLAD</name>
                          <description>Run-Length Adaptive Dithering (lossy compression).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLAD_UNIFORM</name>
                          <description>Run-Length Adaptive Dithering (lossy compression; uniform package size).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLA</name>
                          <description>Run-Length Adaptive (lossless compression).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RL</name>
                          <description>Standard Run-Length. In contrary to other modes is in big endian format.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RLADCOMPBITSRED</name>
                      <description>Maximum for average number of bits per compressed pixel for Red or Y (luma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSGREEN</name>
                      <description>Maximum for average number of bits per compressed pixel for Green or U (chroma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[23:20]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSBLUE</name>
                      <description>Maximum for average number of bits per compressed pixel for Blue or V (chroma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSALPHA</name>
                      <description>Maximum for average number of bits per compressed pixel for Alpha channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[31:28]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERLENGTH</name>
                  <description>Source buffer length for compressed data.</description>
                  <addressOffset>0x78</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RLEWORDS</name>
                      <description>Number of 32-bit words minus one that are required to decode the run length encoded source buffer.</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Shared common control settings for all layers.</description>
                  <addressOffset>0x7C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x30010000</resetValue>
                  <resetMask>0x307100BF</resetMask>
                  <fields>
                    <field>
                      <name>RASTERMODE</name>
                      <description>Selects a method how to generate source buffer sample points.</description>
                      <bitRange>[2:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>[IBO only, for LBO use PERSPECTIVE with corresponding Geometry] First sample at StartX/Y relative to origin. Hor/ver increments using DeltaX/Y and DeltaSwap setup.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DECODE</name>
                          <description>[FetchDecode/FetchBlit only] Source buffer is an encoded bit stream. First sample at origin (0,0). Hor/ver increments = (1,0)/(0,1).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ARBITRARY</name>
                          <description>[FetchBlit/Warp only] Arbitrary warping (filter is active). Coordinates are read from frame input port. InputSelect must be set to COORDINATE. ArbStartX/Y and ArbDeltaXX/XY/YX/YY must be setup.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSPECTIVE</name>
                          <description>[FetchBlit only] Affine/Perspective warping (filter is active). First sample at PerspStartX/Y/W. Hor/ver increments using PerspDeltaXX/XY/YX/YY/WX/WY. Homogeneous coordinates. See also field Geometry to reduce coordinate amount.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV422</name>
                          <description>[FetchBlit/Decode only] Source buffer is packed YUV 422. First sample at origin (0,0). Hor/ver increments = (1,0)/(0,1). All correllated window widths and horizontal offsets must be even.</description>
                          <value>4</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>INPUTSELECT</name>
                      <description>Selects function for the frame input port.</description>
                      <bitRange>[4:3]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>INACTIVE</name>
                          <description>Not used.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COMPPACK</name>
                          <description>Used for component packing (e.g. UV or source alpha buffer).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ALPHAMASK</name>
                          <description>Used for RGB and alpha pre-multiply stage (mask alpha buffer).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COORDINATE</name>
                          <description>Used for arbitrary warping (coordinate buffer).</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUV422UPSAMPLINGMODE</name>
                      <description>Selects a method for horizontal up-sampling of YUV 422/420 input data.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>REPLICATE</name>
                          <description>Replicate mode for interspersed samples (UV samples between Y samples).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INTERPOLATE</name>
                          <description>Interpolate mode for coaligned samples (UV samples at Y sample positions).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RAWPIXEL</name>
                      <description>Raw pixel mode. If enabled (value = 1), the ComponentBits/Shift settings are replaced for all layers by fixed values that allow passing the pixel data read from memory unchanged to subsequent units (e.g. for reading coordinate layers). Multiply stages and transparent color are deactivated. Skip and Tile pixels are not affected by this setting.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPCOLOR</name>
                      <description>Selects which color to take for pixels that do not lie inside the clip window of any layer.</description>
                      <bitRange>[16:16]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NULL</name>
                          <description>Null color.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYER</name>
                          <description>Color of layer number given by ClipLayer (or layer 0 when Fetch unit has one layer only). The color is then the layer's source or tiling color.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>FILTERMODE</name>
                      <description>Use this to select between nearest and bilinear filtering. Only has an effect if rastermode == ARBITRARY or rastermode == PERSPECTIVE or rastermode == AFFINE.</description>
                      <bitRange>[22:20]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEAREST</name>
                          <description>Chooses pixel closest to sample point</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BILINEAR</name>
                          <description>Calculates result from 4 pixels closest to sample point</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FIR2</name>
                          <description>FIR mode with 2 programmable pixel positions and coefficients</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FIR4</name>
                          <description>FIR mode with 4 programmable pixel positions and coefficients</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>HOR_LINEAR</name>
                          <description>Calculates result from 2 pixels closest to the sample point and on the same line</description>
                          <value>4</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GEOMETRY</name>
                      <description>Control the geomety settings (PerspStartX/Y/W and PerspDeltaXX/XY/YX/YY/XW/YW usage) for the raster mode PERSPECTIVE.</description>
                      <bitRange>[29:28]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TRANSLATE</name>
                          <description>PerspStartX/Y are used. (PerspDeltaXY/YX/XW/YW are 0. PerspDeltaXX/YY and PerspStartW are 1.)</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SCALE</name>
                          <description>PerspStartX/Y and PerspDeltaXX/YY are used. (PerspDeltaXY/YX/XW/YW are 0. PerspStartW is 1.)</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROTATION</name>
                          <description>PerspStartX/Y and PerspDeltaXX/XY/YX/YY are used. (PerspDeltaXW/YW are 0. PerspStartW is 1.)</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSPECTIVE</name>
                          <description>All values PerspStartX/Y/W and PerspDeltaXX/XY/YX/YY/XW/YW are used</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROLTRIGGER</name>
                  <description>Shadow load trigger.</description>
                  <addressOffset>0x80</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>SHDTOKGEN</name>
                      <description>Writing a 1 to this will load shadow registers into the active configuration with the next start of frame and send a shadow load token to subsequent units.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>START</name>
                  <description>Frame start trigger.</description>
                  <addressOffset>0x84</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>START</name>
                      <description>Writing a 1 to this field will start generating one frame (for debugging purposes only).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FETCHTYPE</name>
                  <description>Fetch unit type.</description>
                  <addressOffset>0x88</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>FETCHTYPE</name>
                      <description>This field can be used to determine what kind of fetch unit this is.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-only</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DECODE</name>
                          <description>Fetch unit with RL and RLAD decoder.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYER</name>
                          <description>Fetch unit with fractional plane (8 layers).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>WARP</name>
                          <description>Fetch unit with arbitrary warping and fractional plane (8 layers).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ECO</name>
                          <description>Fetch unit with minimum feature set for alpha, chroma and coordinate planes.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSP</name>
                          <description>Fetch unit with affine, perspective and arbitrary warping.</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROT</name>
                          <description>Fetch unit with affine and arbitrary warping.</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DECODEL</name>
                          <description>Fetch unit with RL and RLAD decoder, reduced feature set.</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYERL</name>
                          <description>Fetch unit with fractional plane (8 layers), reduced feature set.</description>
                          <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROTL</name>
                          <description>Fetch unit with affine and arbitrary warping, reduced feature set.</description>
                          <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ECOL</name>
                          <description>Fetch unit with reduced minimum feature set for alpha, chroma and coordinate planes.</description>
                          <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLIT</name>
                          <description>Fetch unit with DECODE and PERSP capabilities.</description>
                          <value>10</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DECODERSTATUS</name>
                  <description>Status information of the RLAD decoder.</description>
                  <addressOffset>0x8C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3</resetMask>
                  <fields>
                    <field>
                      <name>BUFFERTOOSMALL</name>
                      <description>The buffer size given by RLEWords is too small. No complete output frame could be decoded.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BUFFERTOOLARGE</name>
                      <description>The buffer size given by RLEWords is too large. A complete output frame could be decoded, but more data was read than necessary.</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERPROPERTIES</name>
                  <description>Burst buffer properties.</description>
                  <addressOffset>0x90</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>MANAGEDBURSTBUFFERS</name>
                      <description>Maximum number of burst buffers that can be administrated in the AXI interface.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>BURSTLENGTHFORMAXBUFFERS</name>
                      <description>Maximum Burst Length that can be used when ManagedBurstBuffers burst buffers are used.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>FETCHMASK</name>
                <description>Fetch MASK (only for IBO)</description>
                <addressOffset>0x00004800</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Common static control options.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFF0001</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BASEADDRESSAUTOUPDATE</name>
                      <description>Enable flag for continuous shadow load of BaseAddress field for each layer (layer index = bit index). When set to 1 the active BaseAddress configuration is loaded from shadow at start of each frame. This update is then executed independently from other RWS type fields. ShdEn must be enabled for this mode.
When the flag is enabled for layer 0, also the FieldId0 shadow is automatically loaded.</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERMANAGEMENT</name>
                  <description>AXI interface buffer management register</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x204</resetValue>
                  <resetMask>0x80001FFF</resetMask>
                  <fields>
                    <field>
                      <name>SETNUMBUFFERS</name>
                      <description>Set this to the number of bursts that should be buffered. SetNumBuffers has to be smaller or equal to ManagedBurstBuffers and SetNumBuffers * SetBurstLength has to be smaller or equal to ManagedBurstBuffers * BurstLengthForMaxBuffers. Must be a power of 2. The minimum allowed settings is 4 except for the FetchEco derivate which has a minimum allowed setting of 2.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SETBURSTLENGTH</name>
                      <description>Set this to the burst length that should be used on the AXI interface. SetNumBuffers * SetBurstLength has to be smaller or equal to ManagedBurstBuffers * BurstLengthForMaxBuffers and that bursts larger than 16 are not possible on the axi interface. Only a power of two may be specified as burst length.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINEMODE</name>
                      <description>Fetch buffer cache control.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISPLAY</name>
                          <description>Mandatory setting for operation in the Display Controller. Works also for Blit Engine with marginal performance impact.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLIT</name>
                          <description>Recommended setting for operation in the Blit Engine.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BASEADDRESS0</name>
                  <description>Source buffer base address of layer 0.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BASEADDRESS0</name>
                      <description>Byte aligned start address of the layer source buffer. For a pixel width of 32 bits or DECODE operations BaseAddress bits 1 downto 0 have to be 0 and for a pixel width of 16 bit BaseAddress[0] has to be 0.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERATTRIBUTES0</name>
                  <description>Source buffer attributes for layer 0.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x2004FF</resetValue>
                  <resetMask>0x3FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>STRIDE0</name>
                      <description>Source buffer stride of the layer in bytes minus one, used for address generation. For a pixel width of 32 bits Stride has to be dividable by 4 and given minus one and for a pixel width of 16 bit Stride has to be dividable by two and given minus one.</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BITSPERPIXEL0</name>
                      <description>Number of bits per pixel in the source buffer. Must be 1, 2, 4, 8, 16, 18, 24 or 32. [Exception] FetchEco does not support 18 and 24.</description>
                      <bitRange>[21:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERDIMENSION0</name>
                  <description>Source buffer dimension of layer 0.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3FFF3FFF</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>LINEWIDTH0</name>
                      <description>Width of the source buffer of the layer in pixels minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINECOUNT0</name>
                      <description>Number of lines of the source buffer of the layer minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS0</name>
                  <description>Size of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0x8F0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ITUFORMAT0</name>
                      <description>When ComponentBitsRed/Green/Blue is set to 10 and this mode enabled (value 1), then input format is considered 8.2 instead of 10.0 bits (max color is 1020 instead of 1023). This is compliant to ITU 656 standard.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT0</name>
                  <description>Bit position of color components for RGB, YUV and index formats (layer 0).</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x18100800</resetValue>
                  <resetMask>0x1F1F1F1F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[4:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[20:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED0</name>
                      <description>Red, Y (luma) and palette index.</description>
                      <bitRange>[28:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYEROFFSET0</name>
                  <description>Position of layer 0 within the destination frame.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>LAYERXOFFSET0</name>
                      <description>Horizontal offset (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LAYERYOFFSET0</name>
                      <description>Vertical offset (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWOFFSET0</name>
                  <description>Clip window position for layer 0.</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWXOFFSET0</name>
                      <description>Horizontal position (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWYOFFSET0</name>
                      <description>Vertical position (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CLIPWINDOWDIMENSIONS0</name>
                  <description>Clip window size for layer 0.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>CLIPWINDOWWIDTH0</name>
                      <description>Width.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWHEIGHT0</name>
                      <description>Height.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONSTANTCOLOR0</name>
                  <description>Constant color for layer 0.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>CONSTANTALPHA0</name>
                      <description>Alpha.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTBLUE0</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTGREEN0</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTRED0</name>
                      <description>Red and Y (luma).</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LAYERPROPERTY0</name>
                  <description>Common properties of layer 0.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xB8000008</resetValue>
                  <resetMask>0xFFFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>PALETTEENABLE0</name>
                      <description>Enables (value = 1) a color palette with 8 bits input and 24 bits output. Lower bits of the lookup index are read from memory (PaletteIdWidth0), upper bits are set to index of this layer. Palette output is extended by upper bits of index word read from memory (e.g. to store alpha together with index). Result is mapped to color channels according to ColorComponentBits/Shift settings.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILEMODE0</name>
                      <description>Select the tile mode for pixels outside the source buffer. Clip color (0,0,0,0) takes precedence if a pixel becomes subject to both tiling and clipping.</description>
                      <bitRange>[2:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TILE_FILL_ZERO</name>
                          <description>Use zero value</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_FILL_CONSTANT</name>
                          <description>Use constant color register value</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD</name>
                          <description>Use closest pixel from source buffer. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD_ZERO</name>
                          <description>Use closest pixel from source buffer but zero for alpha component. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha for computing the output alpha. When disabled source alpha is set to 1.</description>
                      <bitRange>[3:3]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha for computing the output alpha. When disabled constant alpha is set to 1.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHAMASKENABLE0</name>
                      <description>Value 1 enables mask alpha for computing the output alpha. When disabled mask alpha is set to 1.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha for computing the output alpha. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[6:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHASRCENABLE0</name>
                      <description>Value 1 enables source alpha (stored together with color component in the source buffer) for RGB pre-multiply. When disabled source alpha is set to 1.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHACONSTENABLE0</name>
                      <description>Value 1 enables constant alpha (ConstAlpha fields) for RGB pre-multiply. When disabled constant alpha is set to 1.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHAMASKENABLE0</name>
                      <description>Value 1 enables mask alpha (read by another Fetch unit from a separate alpha layer) for RGB pre-multiply. When disabled mask alpha is set to 1. Alpha mask input must be enabled for this field to have effect.</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHATRANSENABLE0</name>
                      <description>Value 1 enables transparent alpha (0 or 1 depending on RGB matching ConstantColor setting) for RGB pre-multiply. When disabled transparent alpha is set to 1.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PREMULCONSTRGB0</name>
                      <description>When enabled (value 1) the values given by ConstantRed/Green/Blue are used instead of alpha for source RGB pre-multiply. Settings RGBAlphaSrc/Const/Mask/TransEnable have no effect then.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE0</name>
                      <description>Enables different kind of YUV to RGB conversions.</description>
                      <bitRange>[13:12]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GAMMAREMOVEENABLE0</name>
                      <description>Value 1 enables the stage to remove a gamma from RGB components.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEOFFSET0</name>
                      <description>Palette may contain multiple areas. This offset shows to the starting position of the currently used area.</description>
                      <bitRange>[26:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEIDWIDTH0</name>
                      <description>Number minus one of least significant bits of pixel data read from the source buffer that are used as index value for color palette look-up.</description>
                      <bitRange>[29:27]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWENABLE0</name>
                      <description>Value 1 enables the clip window for this layer. Pixels outside the clip window get the clip color, pixels inside the source or tiling color.</description>
                      <bitRange>[30:30]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SOURCEBUFFERENABLE0</name>
                      <description>Value 1 enables the source buffer for this layer. When disabled the tiling color is used only (TileMode TILE_PAD not allowed).</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMEDIMENSIONS</name>
                  <description>Output frame dimension.</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xEF013F</resetValue>
                  <resetMask>0xBFFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>FRAMEWIDTH</name>
                      <description>Frame width minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FRAMEHEIGHT</name>
                      <description>Frame height minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>EMPTYFRAME</name>
                      <description>When enabled output frame is empty. FrameWidth/Height settings have no effect then. Can be used to load shadows or to generate synchronization signals only (frame/sequence complete). If enabled, InputSelect must be set to INACTIVE.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMERESAMPLING</name>
                  <description>Resampling options for output frame.</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x104000</resetValue>
                  <resetMask>0x1FFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>STARTX</name>
                      <description>X coordinate of first sample point relative to origin.
(format is signed fix-point 4.2)</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>STARTY</name>
                      <description>Y coordinate of first sample point relative to origin.
(format is signed fix-point 4.2)</description>
                      <bitRange>[11:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DELTAX</name>
                      <description>Increment of X coordinate for horizontal step in destination frame.
(format is signed fix-point 4.2)</description>
                      <bitRange>[17:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DELTAY</name>
                      <description>Increment of Y coordinate for vertical step in destination frame.
(format is signed fix-point 4.2)</description>
                      <bitRange>[23:18]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SWAPDIRECTION</name>
                      <description>Swaps X and Y directions for re-sampling. When enabled (= 1) DeltaY is applied for horizontal and DeltaX for vertical step on destination frame.</description>
                      <bitRange>[24:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>WARPCONTROL</name>
                  <description>Warping control options.</description>
                  <addressOffset>0x38</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x20</resetValue>
                  <resetMask>0x133F</resetMask>
                  <fields>
                    <field>
                      <name>WARPBITSPERPIXEL</name>
                      <description>Number of bits per pixel in the coordinate layer, which is read by another Fetch unit. Has to be 1, 2, 4, 8, 16 or 32.</description>
                      <bitRange>[5:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>WARPCOORDINATEMODE</name>
                      <description>Content of pixel data in the coordinate layer.</description>
                      <bitRange>[9:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PNT</name>
                          <description>x and y (sample points).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>D_PNT</name>
                          <description>dx and dy (vectors between adjacent sample points).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DD_PNT</name>
                          <description>ddx and ddy (deltas between adjacent vectors).</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>WARPSYMMETRICOFFSET</name>
                      <description>Value 1 enables symmetric range for negative and positive coordinate values by adding an offset of +0.03125 internally to all coordinate input values. Recommended for small coordinate formats in DD_PNT mode.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTX</name>
                  <description>Start value X for affine/perspective warping.</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTX</name>
                      <description>Start value for homogenous X coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTY</name>
                  <description>Start value Y for affine/perspective warping.</description>
                  <addressOffset>0x40</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTY</name>
                      <description>Start value for homogenous Y coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXX</name>
                  <description>DeltaXX increment for affine/perspective warping.</description>
                  <addressOffset>0x44</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXX</name>
                      <description>Increment of homogenous X coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYY</name>
                  <description>DeltaYY increment for affine/perspective warping.</description>
                  <addressOffset>0x48</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYY</name>
                      <description>Increment of homogenous Y coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXY</name>
                  <description>DeltaXY increment for affine/perspective warping.</description>
                  <addressOffset>0x4C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXY</name>
                      <description>Increment of homogenous Y coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYX</name>
                  <description>DeltaYX increment for affine/perspective warping.</description>
                  <addressOffset>0x50</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYX</name>
                      <description>Increment of homogenous X coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPSTARTW</name>
                  <description>Start value W for perspective warping.</description>
                  <addressOffset>0x54</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3F800000</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPSTARTW</name>
                      <description>Start value for homogenous W coordinate relative to origin.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAXW</name>
                  <description>DeltaWX increment for perspective warping.</description>
                  <addressOffset>0x58</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAXW</name>
                      <description>Increment of homogenous W coordinate for horizontal step (X) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERSPDELTAYW</name>
                  <description>DeltaWY increment for perspective warping.</description>
                  <addressOffset>0x5C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERSPDELTAYW</name>
                      <description>Increment of homogenous W coordinate for vertical step (Y) in destination frame.
(format is floating-point 1e8m23)</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBSTARTX</name>
                  <description>Start value X for arbitrary warping.</description>
                  <addressOffset>0x60</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBSTARTX</name>
                      <description>Start point for sample-point interpolation (X coordinate).
(format is signed fix-point 16.5)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBSTARTY</name>
                  <description>Start value Y for arbitrary warping.</description>
                  <addressOffset>0x64</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBSTARTY</name>
                      <description>Start point for sample-point interpolation (Y coordinate).
(format is signed fix-point 16.5)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ARBDELTA</name>
                  <description>Start values for delta incrementation of arbitrary warping.</description>
                  <addressOffset>0x68</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>ARBDELTAXX</name>
                      <description>X coordinate of vector between first and second sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAXY</name>
                      <description>Y coordinate of vector between first and second sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAYX</name>
                      <description>X coordinate of vector between start and first sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ARBDELTAYY</name>
                      <description>Y coordinate of vector between start and first sample point.
(format is signed fix-point 3.5)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FIRPOSITIONS</name>
                  <description>FIR sequence control register.</description>
                  <addressOffset>0x6C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xA965</resetValue>
                  <resetMask>0xFFFF</resetMask>
                  <fields>
                    <field>
                      <name>FIR0POSITION</name>
                      <description>Position of first pixel.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR1POSITION</name>
                      <description>Position of second pixel.</description>
                      <bitRange>[7:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR2POSITION</name>
                      <description>Position of third pixel.</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR3POSITION</name>
                      <description>Position of fourth pixel.</description>
                      <bitRange>[15:12]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FIRCOEFFICIENTS</name>
                  <description>FIR coefficients register.</description>
                  <addressOffset>0x70</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x20</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>FIR0COEFFICIENT</name>
                      <description>First coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR1COEFFICIENT</name>
                      <description>Second coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR2COEFFICIENT</name>
                      <description>Third coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FIR3COEFFICIENT</name>
                      <description>Fourth coefficient.
(format is signed fix-point 3.5)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DECODECONTROL</name>
                  <description>Control options for RLAD decompression.</description>
                  <addressOffset>0x74</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x88880001</resetValue>
                  <resetMask>0xFFFF0003</resetMask>
                  <fields>
                    <field>
                      <name>COMPRESSIONMODE</name>
                      <description>Algorithm that the encoder used for compression.</description>
                      <bitRange>[1:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>RLAD</name>
                          <description>Run-Length Adaptive Dithering (lossy compression).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLAD_UNIFORM</name>
                          <description>Run-Length Adaptive Dithering (lossy compression; uniform package size).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLA</name>
                          <description>Run-Length Adaptive (lossless compression).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RL</name>
                          <description>Standard Run-Length. In contrary to other modes is in big endian format.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RLADCOMPBITSRED</name>
                      <description>Maximum for average number of bits per compressed pixel for Red or Y (luma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSGREEN</name>
                      <description>Maximum for average number of bits per compressed pixel for Green or U (chroma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[23:20]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSBLUE</name>
                      <description>Maximum for average number of bits per compressed pixel for Blue or V (chroma) channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSALPHA</name>
                      <description>Maximum for average number of bits per compressed pixel for Alpha channel. This must match the corresponding encoder setting.</description>
                      <bitRange>[31:28]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SOURCEBUFFERLENGTH</name>
                  <description>Source buffer length for compressed data.</description>
                  <addressOffset>0x78</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RLEWORDS</name>
                      <description>Number of 32-bit words minus one that are required to decode the run length encoded source buffer.</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Shared common control settings for all layers.</description>
                  <addressOffset>0x7C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x30010000</resetValue>
                  <resetMask>0x307100BF</resetMask>
                  <fields>
                    <field>
                      <name>RASTERMODE</name>
                      <description>Selects a method how to generate source buffer sample points.</description>
                      <bitRange>[2:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>[IBO only, for LBO use PERSPECTIVE with corresponding Geometry] First sample at StartX/Y relative to origin. Hor/ver increments using DeltaX/Y and DeltaSwap setup.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DECODE</name>
                          <description>[FetchDecode/FetchBlit only] Source buffer is an encoded bit stream. First sample at origin (0,0). Hor/ver increments = (1,0)/(0,1).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ARBITRARY</name>
                          <description>[FetchBlit/Warp only] Arbitrary warping (filter is active). Coordinates are read from frame input port. InputSelect must be set to COORDINATE. ArbStartX/Y and ArbDeltaXX/XY/YX/YY must be setup.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSPECTIVE</name>
                          <description>[FetchBlit only] Affine/Perspective warping (filter is active). First sample at PerspStartX/Y/W. Hor/ver increments using PerspDeltaXX/XY/YX/YY/WX/WY. Homogeneous coordinates. See also field Geometry to reduce coordinate amount.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV422</name>
                          <description>[FetchBlit/Decode only] Source buffer is packed YUV 422. First sample at origin (0,0). Hor/ver increments = (1,0)/(0,1). All correllated window widths and horizontal offsets must be even.</description>
                          <value>4</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>INPUTSELECT</name>
                      <description>Selects function for the frame input port.</description>
                      <bitRange>[4:3]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>INACTIVE</name>
                          <description>Not used.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COMPPACK</name>
                          <description>Used for component packing (e.g. UV or source alpha buffer).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ALPHAMASK</name>
                          <description>Used for RGB and alpha pre-multiply stage (mask alpha buffer).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COORDINATE</name>
                          <description>Used for arbitrary warping (coordinate buffer).</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUV422UPSAMPLINGMODE</name>
                      <description>Selects a method for horizontal up-sampling of YUV 422/420 input data.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>REPLICATE</name>
                          <description>Replicate mode for interspersed samples (UV samples between Y samples).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INTERPOLATE</name>
                          <description>Interpolate mode for coaligned samples (UV samples at Y sample positions).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RAWPIXEL</name>
                      <description>Raw pixel mode. If enabled (value = 1), the ComponentBits/Shift settings are replaced for all layers by fixed values that allow passing the pixel data read from memory unchanged to subsequent units (e.g. for reading coordinate layers). Multiply stages and transparent color are deactivated. Skip and Tile pixels are not affected by this setting.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPCOLOR</name>
                      <description>Selects which color to take for pixels that do not lie inside the clip window of any layer.</description>
                      <bitRange>[16:16]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NULL</name>
                          <description>Null color.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYER</name>
                          <description>Color of layer number given by ClipLayer (or layer 0 when Fetch unit has one layer only). The color is then the layer's source or tiling color.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>FILTERMODE</name>
                      <description>Use this to select between nearest and bilinear filtering. Only has an effect if rastermode == ARBITRARY or rastermode == PERSPECTIVE or rastermode == AFFINE.</description>
                      <bitRange>[22:20]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEAREST</name>
                          <description>Chooses pixel closest to sample point</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BILINEAR</name>
                          <description>Calculates result from 4 pixels closest to sample point</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FIR2</name>
                          <description>FIR mode with 2 programmable pixel positions and coefficients</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FIR4</name>
                          <description>FIR mode with 4 programmable pixel positions and coefficients</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>HOR_LINEAR</name>
                          <description>Calculates result from 2 pixels closest to the sample point and on the same line</description>
                          <value>4</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GEOMETRY</name>
                      <description>Control the geomety settings (PerspStartX/Y/W and PerspDeltaXX/XY/YX/YY/XW/YW usage) for the raster mode PERSPECTIVE.</description>
                      <bitRange>[29:28]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TRANSLATE</name>
                          <description>PerspStartX/Y are used. (PerspDeltaXY/YX/XW/YW are 0. PerspDeltaXX/YY and PerspStartW are 1.)</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SCALE</name>
                          <description>PerspStartX/Y and PerspDeltaXX/YY are used. (PerspDeltaXY/YX/XW/YW are 0. PerspStartW is 1.)</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROTATION</name>
                          <description>PerspStartX/Y and PerspDeltaXX/XY/YX/YY are used. (PerspDeltaXW/YW are 0. PerspStartW is 1.)</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSPECTIVE</name>
                          <description>All values PerspStartX/Y/W and PerspDeltaXX/XY/YX/YY/XW/YW are used</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROLTRIGGER</name>
                  <description>Shadow load trigger.</description>
                  <addressOffset>0x80</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>SHDTOKGEN</name>
                      <description>Writing a 1 to this will load shadow registers into the active configuration with the next start of frame and send a shadow load token to subsequent units.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>START</name>
                  <description>Frame start trigger.</description>
                  <addressOffset>0x84</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>START</name>
                      <description>Writing a 1 to this field will start generating one frame (for debugging purposes only).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FETCHTYPE</name>
                  <description>Fetch unit type.</description>
                  <addressOffset>0x88</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>FETCHTYPE</name>
                      <description>This field can be used to determine what kind of fetch unit this is.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-only</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DECODE</name>
                          <description>Fetch unit with RL and RLAD decoder.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYER</name>
                          <description>Fetch unit with fractional plane (8 layers).</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>WARP</name>
                          <description>Fetch unit with arbitrary warping and fractional plane (8 layers).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ECO</name>
                          <description>Fetch unit with minimum feature set for alpha, chroma and coordinate planes.</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PERSP</name>
                          <description>Fetch unit with affine, perspective and arbitrary warping.</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROT</name>
                          <description>Fetch unit with affine and arbitrary warping.</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DECODEL</name>
                          <description>Fetch unit with RL and RLAD decoder, reduced feature set.</description>
                          <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LAYERL</name>
                          <description>Fetch unit with fractional plane (8 layers), reduced feature set.</description>
                          <value>7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROTL</name>
                          <description>Fetch unit with affine and arbitrary warping, reduced feature set.</description>
                          <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ECOL</name>
                          <description>Fetch unit with reduced minimum feature set for alpha, chroma and coordinate planes.</description>
                          <value>9</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLIT</name>
                          <description>Fetch unit with DECODE and PERSP capabilities.</description>
                          <value>10</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DECODERSTATUS</name>
                  <description>Status information of the RLAD decoder.</description>
                  <addressOffset>0x8C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3</resetMask>
                  <fields>
                    <field>
                      <name>BUFFERTOOSMALL</name>
                      <description>The buffer size given by RLEWords is too small. No complete output frame could be decoded.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BUFFERTOOLARGE</name>
                      <description>The buffer size given by RLEWords is too large. A complete output frame could be decoded, but more data was read than necessary.</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERPROPERTIES</name>
                  <description>Burst buffer properties.</description>
                  <addressOffset>0x90</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>MANAGEDBURSTBUFFERS</name>
                      <description>Maximum number of burst buffers that can be administrated in the AXI interface.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>BURSTLENGTHFORMAXBUFFERS</name>
                      <description>Maximum Burst Length that can be used when ManagedBurstBuffers burst buffers are used.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>ROP</name>
                <description>ROp</description>
                <addressOffset>0x00005000</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Raster Operation static control register</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Raster Operation control register</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7F1</resetMask>
                  <fields>
                    <field>
                      <name>MODE</name>
                      <description>Operation mode for rop</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Neutral mode</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>OPERATION</name>
                          <description>Normal Operation</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAMODE</name>
                      <description>Selects the mode for the alpha component channel, has no effect in NEUTRAL mode</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ROP</name>
                          <description>Normal raster operation mode, using the operation index</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ADD</name>
                          <description>Add mode, adds this component from all enabled inputs, clamps to 1</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>BLUEMODE</name>
                      <description>Selects the mode for the blue component channel, has no effect in NEUTRAL mode</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ROP</name>
                          <description>Normal raster operation mode, using the operation index</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ADD</name>
                          <description>Add mode, adds this component from all enabled inputs, clamps to 1</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GREENMODE</name>
                      <description>Selects the mode for the green component channel, has no effect in NEUTRAL mode</description>
                      <bitRange>[6:6]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ROP</name>
                          <description>Normal raster operation mode, using the operation index</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ADD</name>
                          <description>Add mode, adds this component from all enabled inputs, clamps to 1</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>REDMODE</name>
                      <description>Selects the mode for the red component channel, has no effect in NEUTRAL mode</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ROP</name>
                          <description>Normal raster operation mode, using the operation index</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ADD</name>
                          <description>Add mode, adds this component from all enabled inputs, clamps to 1</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>PRIMDIV2</name>
                      <description>Selects whether to divide the primary input color components by two or not for ADD mode. This field has no effect on a color component in ROP mode.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>BYPASS</name>
                          <description>No change to input</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DIVIDEBY2</name>
                          <description>Input is divided by two/shift to the right by one</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>SECDIV2</name>
                      <description>Selects whether to divide the secondary input color components by two or not for ADD mode. This field has no effect on a color component in ROP mode.</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>BYPASS</name>
                          <description>No change to input</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DIVIDEBY2</name>
                          <description>Input is divided by two/shift to the right by one</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>TERTDIV2</name>
                      <description>Selects whether to divide the tertiary input color components by two or not for ADD mode. This field has no effect on a color component in ROP mode.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>BYPASS</name>
                          <description>No change to input</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>DIVIDEBY2</name>
                          <description>Input is divided by two/shift to the right by one</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RASTEROPERATIONINDICES</name>
                  <description>ROP operation indices</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>OPINDEXALPHA</name>
                      <description>Alpha operation index</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>OPINDEXBLUE</name>
                      <description>Blue operation index</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>OPINDEXGREEN</name>
                      <description>Green operation index</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>OPINDEXRED</name>
                      <description>Red operation index</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PRIMCONTROLWORD</name>
                  <description>Value of last received primary control word</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>P_VAL</name>
                      <description>Value of last received control word on the primary input. If a 39 bit pixel channel is connected, the mapping is as follows: p_val[31:0] = { data[37:22], data[19:12], data[9:2] }. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SECCONTROLWORD</name>
                  <description>Value of last received secondary control word</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>S_VAL</name>
                      <description>Value of last received control word on the secondary input. If a 39 bit pixel channel is connected, the mapping is as follows: s_val[31:0] = { data[37:22], data[19:12], data[9:2] }. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>TERTCONTROLWORD</name>
                  <description>Value of last received tertiary control word</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>T_VAL</name>
                      <description>Value of last received control word on the tertiary input. If a 39 bit pixel channel is connected, the mapping is as follows: t_val[31:0] = { data[37:22], data[19:12], data[9:2] }. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>CLUT</name>
                <description>CLut (only for IBO)</description>
                <addressOffset>0x00005800</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>CLUT static control register</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>UNSHADOWEDCONTROL</name>
                  <description>CLUT unshadowed control register</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7</resetMask>
                  <fields>
                    <field>
                      <name>B_EN</name>
                      <description>Write enable for writing the blue color LUT entry from the host (allows writing a single color entry without a read-modify-write cycle)</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>disable</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENABLE</name>
                          <description>enable</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>G_EN</name>
                      <description>Write enable for writing the green color LUT entry from the host (allows writing a single color entry without a read-modify-write cycle)</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>disable</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENABLE</name>
                          <description>enable</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>R_EN</name>
                      <description>Write enable for writing the red color LUT entry from the host (allows writing a single color entry without a read-modify-write cycle)</description>
                      <bitRange>[2:2]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>disable</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENABLE</name>
                          <description>enable</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>CLUT control register</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x800</resetValue>
                  <resetMask>0xF73</resetMask>
                  <fields>
                    <field>
                      <name>MODE</name>
                      <description>Operation mode for color lookup table</description>
                      <bitRange>[1:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>module in neutral mode, input data is bypassed to the output</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LUT</name>
                          <description>module in color lookup mode (LUT holds a 10bit color value lookup value for each input color)</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INDEX_10BIT</name>
                          <description>module in 10bit color index table mode (LUT holds a 3x10bit color value, indexed with the red input color)</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INDEX_RGBA</name>
                          <description>module in RGBA color index table mode (LUT holds a 3x8bit color value and a 6bit alpha value, indexed with the red input color)</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>COL_8BIT</name>
                      <description>Color (red, green, blue) output bitwidth select</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>color is 10bit output</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENABLE</name>
                          <description>color is 8bit output (dithering of internal 10bit value)</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAMASK</name>
                      <description>Enables the alpha mask mode. This mode disables lookup for all pixels with an alpha component smaller or greater/equal than 128. They are bypassed unchanged.</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>Alpha mask mode disabled</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENABLE</name>
                          <description>Alpha mask mode enabled</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAINVERT</name>
                      <description>Chooses whether to disable lookup for alpha components smaller or greater/equal than 128. For this field to have an effect AlphaMask must be set to ENABLE.</description>
                      <bitRange>[6:6]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>Disable computation for alpha smaller than 128</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INVERT</name>
                          <description>Disable computation for alpha greater than or equal to 128</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>IDX_BITS</name>
                      <description>Number of msb bits of the red color input used for the LUT index input</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>STATUS</name>
                  <description>CLUT status register</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x11</resetMask>
                  <fields>
                    <field>
                      <name>WRITE_TIMEOUT</name>
                      <description>Timeout detected when writing to the LUT</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>READ_TIMEOUT</name>
                      <description>Timeout detected when reading from the LUT</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LASTCONTROLWORD</name>
                  <description>Value of last received control word, for debugging</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>L_VAL</name>
                      <description>Value of last received control word. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <dim>256</dim>
                  <dimIncrement>4</dimIncrement>
                  <name>LUT[%s]</name>
                  <description>Look Up Table</description>
                  <addressOffset>0x400</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>BLUE</name>
                      <description>Blue component</description>
                      <bitRange>[9:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>GREEN</name>
                      <description>Green component</description>
                      <bitRange>[19:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RED</name>
                      <description>Red component</description>
                      <bitRange>[29:20]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>MATRIX</name>
                <description>Matrix</description>
                <addressOffset>0x00006000</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Color Matrix static control register</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Color Matrix control register</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x33</resetMask>
                  <fields>
                    <field>
                      <name>MODE</name>
                      <description>Operation mode for color matrix</description>
                      <bitRange>[1:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Module in neutral mode, input data is bypassed</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>MATRIX</name>
                          <description>Module in matrix mode, input data is multiplied with matrix values</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PREMUL</name>
                          <description>Module in alpha pre-multiplication mode, input color is multiplied with input alpha</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RSVD</name>
                          <description>N/A</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAMASK</name>
                      <description>Value 1 enables the alpha mask mode. In this mode all pixels with an alpha value smaller than 0.5 are by-passed unchanged.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHAINVERT</name>
                      <description>Value 1 inverts the effect of the alpha mask mode when enabled (pixels with alpha value greater or equal 0.5 are by-passed).</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
