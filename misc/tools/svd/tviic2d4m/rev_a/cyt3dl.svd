                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>CW_VAL</name>
                      <description>Value of last received control word</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CURPIXELCNT</name>
                  <description>pixel count of currently running frame</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
