                        <description>Enable inversion control for number of RGB-Bits = 14</description>
                        <value>7</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RGB_16_BITS</name>
                        <description>Enable inversion control for number of RGB-Bits = 16</description>
                        <value>8</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RGB_18_BITS</name>
                        <description>Enable inversion control for number of RGB-Bits = 18</description>
                        <value>9</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RGB_20_BITS</name>
                        <description>Enable inversion control for number of RGB-Bits = 20</description>
                        <value>10</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RGB_22_BITS</name>
                        <description>Enable inversion control for number of RGB-Bits = 22</description>
                        <value>11</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RGB_24_BITS</name>
                        <description>Enable inversion control for number of RGB-Bits = 24</description>
                        <value>12</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RSVD1</name>
                        <description>N/A</description>
                        <value>13</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RSVD2</name>
                        <description>N/A</description>
                        <value>14</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RSVD3</name>
                        <description>N/A</description>
                        <value>15</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>ENLVDS</name>
                    <description>Enable LVDS Mode</description>
                    <bitRange>[8:8]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>ENABLE_LVDS</name>
                        <description>Enable LVDS , TTL and RSDS are disable</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>DISABLE_LVDS</name>
                        <description>Disable LVDS, Enable TTL and RSDS</description>
                        <value>0</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>LVDSMODE</name>
                    <description>Selection the LVDS Mode if EnLVDS = ENABLE_LVDS</description>
                    <bitRange>[9:9]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>MINI_LVDS</name>
                        <description>MiniLVDS</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>LVDS</name>
                        <description>LVDS Mode, refer to OpenLDI</description>
                        <value>0</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>LVDS_BALANCE</name>
                    <description>Operation mode of LVDS-OpenLDI</description>
                    <bitRange>[10:10]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>BALANCED</name>
                        <description>LVDS operates in 24 bits Balanced Mode</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>UNBALANCED</name>
                        <description>LVDS operates in 24 bits Unbalanced Mode</description>
                        <value>0</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>LVDS_CLOCK_INV</name>
                    <description>Inversion the polarity of lvds clock in OpenLDI Mode</description>
                    <bitRange>[11:11]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>INV</name>
                        <description>Invert LVDS Clock</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>NON_INV</name>
                        <description>NON-Invert LVDS Clock</description>
                        <value>0</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>MINILVDS_OPCODE</name>
                    <description>Operation mode of MiniLVDS</description>
                    <bitRange>[14:12]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>MODE_3PAIRS</name>
                        <description>MiniLVDS operates in 6 and 8 bit data, three pairs</description>
                        <value>0</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>MODE_4PAIRS</name>
                        <description>Not Implemented</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>MODE_5PAIRS</name>
                        <description>Not Implemented</description>
                        <value>2</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>MODE_6PAIRS</name>
                        <description>MiniLVDS operates in 6 and 8 bit data, six pairs</description>
                        <value>3</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RSVD1</name>
                        <description>N/A</description>
                        <value>4</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RSVD2</name>
                        <description>N/A</description>
                        <value>5</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RSVD3</name>
                        <description>N/A</description>
                        <value>6</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>RSVD4</name>
                        <description>N/A</description>
                        <value>7</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>DUAL_SWAP</name>
                    <description>pixels of lower/upper channel can be swapped if tcon operates in DUAL-mode (include LVDS/miniLVDS) 
 no effect in SINGLE-mode</description>
                    <bitRange>[15:15]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>SWAP</name>
                        <description>swapping pixels between lower-channel and upper-channel</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>NON_SWAP</name>
                        <description>NON-swapping pixels between lower-channel and upper-channel</description>
                        <value>0</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>SPLITPOSITION</name>
                    <description>Index of first column of right display half when ChannelMode is DUAL_SPLIT. 
- SplitPosition must be less or equal 1280 
- (Hact - SplitPosition)  must be less or equal 1280 
- If (SplitPosition greater than (Hact - SplitPosition)) Htotal greater 2*SplitPosition 
  else Htotal greater (Hact - SplitPosition) 
- NOTE  once setting SplitPosition data_en is needed</description>
                    <bitRange>[29:16]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>RSDSINVCTRL</name>
                <description>Controls inversion of output polarity when connected IO cells operate in RSDS mode</description>
                <addressOffset>0x40C</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFF0FFF</resetMask>
                <fields>
                  <field>
                    <name>RSDS_INV</name>
                    <description>Inversion vector for 1st channel. For i in [ 0 .. 11 ]; if  RSDS_Inv [ i ] == 0 =&gt; NON-Inversion of RSDS [ i ] else Inversion of RSDS [ i ]</description>
                    <bitRange>[11:0]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>RSDS_INV_DUAL</name>
                    <description>Same as RSDS_inv for 2nd channel</description>
                    <bitRange>[27:16]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>MAPBIT3_0</name>
                <description>Mapping of 24 bit RGB or Timing Generator TSig[5-0] to bit 0 .. 3</description>
                <addressOffset>0x410</addressOffset>
