                    </field>
                    <field>
                      <name>COEFF_H0</name>
                      <description>Horizontal coefficient 0.
(format is signed integer)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COEFFICIENTSH1</name>
