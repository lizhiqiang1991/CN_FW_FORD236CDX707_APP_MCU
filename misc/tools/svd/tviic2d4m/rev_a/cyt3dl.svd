                  <field>
                    <name>PIXINV</name>
                    <description>Inversion of RGB data.</description>
                    <bitRange>[3:3]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>NONINV</name>
                        <description>No inversion of pixel data</description>
                        <value>0</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>INV</name>
                        <description>Pixel data inverted (1. complement)</description>
                        <value>1</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                </fields>
              </register>
              <register>
                <name>SIGSELECT</name>
