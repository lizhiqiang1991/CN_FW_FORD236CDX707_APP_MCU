                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERFRESULT</name>
                      <description>Returns the performance counter value. Returns number of cycles of the last frame on the input. To calculate the performance divide the known number of pixels of the frame by this number. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
