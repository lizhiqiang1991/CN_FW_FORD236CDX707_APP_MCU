                  <resetValue>0x38000008</resetValue>
                  <resetMask>0xFFFF7DDF</resetMask>
                  <fields>
                    <field>
                      <name>PALETTEENABLE7</name>
                      <description>See PaletteEnable0.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILEMODE7</name>
                      <description>See TileMode0.</description>
                      <bitRange>[2:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TILE_FILL_ZERO</name>
                          <description>Use zero value</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_FILL_CONSTANT</name>
                          <description>Use constant color register value</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD</name>
                          <description>Use closest pixel from source buffer. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD_ZERO</name>
                          <description>Use closest pixel from source buffer but zero for alpha component. Must not be used for DECODE or YUV422 operations or when SourceBufferEnable is 0.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHASRCENABLE7</name>
                      <description>See AlphaSrcSelect0.</description>
                      <bitRange>[3:3]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHACONSTENABLE7</name>
                      <description>See AlphaConstSelect0.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHATRANSENABLE7</name>
                      <description>See AlphaTransSelect0.</description>
                      <bitRange>[6:6]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHASRCENABLE7</name>
                      <description>See RGBAlphaSrcSelect0.</description>
                      <bitRange>[7:7]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHACONSTENABLE7</name>
                      <description>See RGBAlphaConstSelect0.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RGBALPHATRANSENABLE7</name>
                      <description>See RGBAlphaTransSelect0.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PREMULCONSTRGB7</name>
                      <description>See PremulConstRGB0.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE7</name>
                      <description>See YUVConversionMode0.</description>
                      <bitRange>[13:12]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>GAMMAREMOVEENABLE7</name>
                      <description>See GammaRemoveEnable0.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEOFFSET7</name>
                      <description>see PaletteOffset0.</description>
                      <bitRange>[26:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>PALETTEIDWIDTH7</name>
                      <description>see PaletteIdWidth0.</description>
                      <bitRange>[29:27]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CLIPWINDOWENABLE7</name>
                      <description>See ClipWindowEnable0.</description>
                      <bitRange>[30:30]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SOURCEBUFFERENABLE7</name>
                      <description>See SourceBufferEnable0.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
