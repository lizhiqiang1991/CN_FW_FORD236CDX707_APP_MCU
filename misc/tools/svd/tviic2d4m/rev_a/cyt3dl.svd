                    <bitRange>[13:0]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>FRTGY</name>
                    <description>Coordinated line position starting from VACT inside a total frame generated in timing generator in display clock cycles.
(For debugging purposes only)</description>
                    <bitRange>[27:14]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
            </cluster>
