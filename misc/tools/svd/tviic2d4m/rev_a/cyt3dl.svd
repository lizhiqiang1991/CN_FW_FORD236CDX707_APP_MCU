        <cluster>
          <name>FPDLINK0</name>
          <description>FPD-Link Interface</description>
          <addressOffset>0x000C0000</addressOffset>
          <register>
            <name>CTL</name>
            <description>IP Control register for FPDLink</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x1</resetValue>
            <resetMask>0x80000001</resetMask>
            <fields>
              <field>
                <name>PD_TX</name>
                <description>Power down bit, when high all blocks inside the FPDLink block shall be powered down</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FPDLINK_POWER_DOWN</name>
                    <description>Power down FPDLink, this is the default reset value</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FPDLINK_POWER_UP</name>
                    <description>Power up FPDLink</description>
                    <value>0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>ENABLED</name>
                <description>Enable bit for FPDLink</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DIS</name>
                    <description>Disable the entire mxvideoss_fpdlink</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EN</name>
                    <description>Enable FPDLink</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CMD</name>
            <description>IP Command register for FPDLink</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x1</resetMask>
            <fields>
              <field>
                <name>LVDS_TX_EN</name>
                <description>Enable the serializers and TX drivers for all lanes of FPDLink</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FPDLINK_TX_DRIVER_DISABLED</name>
                    <description>Disable FPDLink TX operation</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FPDLINK_TX_DRIVER_ENABLED</name>
                    <description>Enable FPDLink TX operation</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CLK_GEN_CMD</name>
            <description>Control register for CLK_GEN</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x1</resetMask>
            <fields>
              <field>
                <name>MODE8</name>
                <description>Enable Dual-Pixel (8-Lane Mode)</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MODE4</name>
                    <description>4 Lane LVDS mode</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MODE8</name>
                    <description>8 lane LVDS mode</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>CLK_GEN_CTL</name>
            <description>Configuration register for CKGEN</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x1137733</resetMask>
            <fields>
              <field>
                <name>FRANGE</name>
                <description>Control Output frequency divider, connects to the port CO on the hardIP</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DIV1</name>
                    <description>Internal PLL output divider programmed to 1</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DIV2</name>
                    <description>Internal PLL output divider programmed to 2</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DIV4</name>
                    <description>Internal PLL output divider programmed to 4</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DIV8</name>
                    <description>Internal PLL output divider programmed to 8</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LFCTRL</name>
                <description>Loop filter resistance selection used for low bandwidth feature</description>
                <bitRange>[5:4]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DIV1</name>
                    <description>Default bandwidth as per specification</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DIV2</name>
                    <description>Intermediate bandwidth setting lower than default bandwidth (higher than 0x2 setting)</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DIV4</name>
                    <description>Intermediate bandwidth setting higher than 800kHz (lower than 0x01 setting)</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DIV8</name>
                    <description>Less than 800kHz</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CA</name>
                <description>Driver output current control bits</description>
                <bitRange>[10:8]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>2P4MA</name>
                    <description>Driver output current is 2.4mA</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2P72MA</name>
                    <description>Driver output current is 2.72mA</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>2P88MA</name>
                    <description>Driver output current is 2.88mA</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>3P2MA</name>
                    <description>Driver output current is 3.2mA</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>3P36MA</name>
                    <description>Driver output current is 3.36ma, this is the default value to be programmed</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>3P68MA</name>
                    <description>Driver output current is 3.68mA</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>3P84MA</name>
                    <description>Driver output current is 3.84mA</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>4P32MA</name>
                    <description>Driver output current is 4.32mA</description>
                    <value>7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CCM</name>
                <description>Common mode voltage control bits.</description>
                <bitRange>[14:12]</bitRange>
                <access>read-write</access>
