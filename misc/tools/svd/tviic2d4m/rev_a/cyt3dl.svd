              <fields>
                <field>
                  <name>DIVVAL1</name>
                  <description>Clock Divider Setting (KDIV)</description>
                  <bitRange>[1:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DIV1</name>
                      <description>No division</description>
