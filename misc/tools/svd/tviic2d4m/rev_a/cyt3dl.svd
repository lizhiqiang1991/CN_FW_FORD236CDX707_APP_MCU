              <cluster>
                <name>BLITBLEND</name>
                <description>BlitBlend</description>
                <addressOffset>0x00006800</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>BlitBlend static control register</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>BlitBlend control register</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>MODE</name>
                      <description>Operation mode for BlitBlend</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Neutral mode, only route pixels and commands from primary input to output</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>OPERATION</name>
                          <description>Normal Operation</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>NEUTRALBORDER</name>
                  <description>Neutral border setup register</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7701</resetMask>
                  <fields>
                    <field>
                      <name>NEUTRALBORDERMODE</name>
                      <description>Chooses whether to bypass primary or secondary input pixels</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PRIMARY</name>
                          <description>Bypasses primary pixel</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SECONDARY</name>
                          <description>Bypasses secondary pixel</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>NEUTRALBORDERLEFT</name>
                      <description>Number of neutral left border pixels</description>
                      <bitRange>[10:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>NEUTRALBORDERRIGHT</name>
                      <description>Number of neutral right border pixels</description>
                      <bitRange>[14:12]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONSTANTCOLOR</name>
                  <description>Constant color register</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>CONSTANTALPHA</name>
                      <description>Alpha.</description>
                      <bitRange>[7:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTBLUE</name>
                      <description>Blue and V (chroma).</description>
                      <bitRange>[15:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTGREEN</name>
                      <description>Green and U (chroma).</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTRED</name>
                      <description>Red and Y (luma).</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORREDBLENDFUNCTION</name>
                  <description>Open GL RGB blending factors</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3000300</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BLENDFUNCCOLORREDSRC</name>
                      <description>Red component source blend function</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BLENDFUNCCOLORREDDST</name>
                      <description>Red component destination blend function</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORGREENBLENDFUNCTION</name>
                  <description>Open GL RGB blending factors</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3000300</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BLENDFUNCCOLORGREENSRC</name>
                      <description>Green component source blend function</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BLENDFUNCCOLORGREENDST</name>
                      <description>Green component destination blend function</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORBLUEBLENDFUNCTION</name>
                  <description>Open GL RGB blending factors</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3000300</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BLENDFUNCCOLORBLUESRC</name>
                      <description>Blue component source blend function</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BLENDFUNCCOLORBLUEDST</name>
                      <description>Blue component destination blend function</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ALPHABLENDFUNCTION</name>
                  <description>Open GL alpha blending factors</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3000300</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BLENDFUNCALPHASRC</name>
                      <description>Alpha component source blend function</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BLENDFUNCALPHADST</name>
                      <description>Alpha component destination blend function</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BLENDMODE1</name>
                  <description>Open GL and Open VG blending modes for colors red and green</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x80068006</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BLENDMODECOLORRED</name>
                      <description>Red component blend mode</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BLENDMODECOLORGREEN</name>
                      <description>Green component blend mode</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BLENDMODE2</name>
                  <description>Open GL and Open VG blending modes for color blue and alpha</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x80068006</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BLENDMODECOLORBLUE</name>
                      <description>Blue component blend mode</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BLENDMODEALPHA</name>
                      <description>Alpha component blend mode</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DIRECTSETUP</name>
                  <description>Direct Control of the BlitBlend Datapath multiplexers, do not change</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FF03FF</resetMask>
                  <fields>
                    <field>
                      <name>COLORDEBUG</name>
                      <description>Sets the multiplexers of the color datapath directly, do not change</description>
                      <bitRange>[9:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHADEBUG</name>
                      <description>Sets the multiplexers of the alpha datapath directly, do not change</description>
                      <bitRange>[25:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PRIMCONTROLWORD</name>
                  <description>Value of last received primary control word</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>P_VAL</name>
                      <description>Value of last received control word on primary input. If a 39 bit pixel channel is connected, the mapping is as follows: p_val[31:0] = { data[37:22], data[19:12], data[9:2] }. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SECCONTROLWORD</name>
                  <description>Value of last received secondary control word</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>S_VAL</name>
                      <description>Value of last received control word on secondary input. If a 39 bit pixel channel is connected, the mapping is as follows: s_val[31:0] = { data[37:22], data[19:12], data[9:2] }. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>STORE</name>
                <description>Store</description>
                <addressOffset>0x00006C00</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Store unit static control register.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x111</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>Enables shadowing of all RWS type registers (0=write_through, 1=shadowed).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>SINGLEFRAMEOPERATION</name>
                      <description>If this field and ShdEn are enabled, only frames with reload bit in command word are written to AXI, other frames are still consumed. If disabled all frames are writen to AXI</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BASEADDRESSAUTOUPDATE</name>
                      <description>If enabled (value 1) the base address is automatically updated at the start of each frame. This update is then executed independently of the ShdEn setting. When disabled ShdEn controls the update of the base address operation register.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERMANAGEMENT</name>
                  <description>Burst Buffer setup register.</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x400</resetValue>
                  <resetMask>0x1F00</resetMask>
                  <fields>
                    <field>
                      <name>SETBURSTLENGTH</name>
                      <description>Set this to the burst length that should be used on the AXI interface. Please note that SetBurstLength has to be smaller or equal to MaxBurstLength. Only a power of two may be specified as burst length. Please set this to at least 2 for 64bit pixels, otherwise performance will suffer.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RINGBUFSTARTADDR</name>
                  <description>Ring buffer setup for destination.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RINGBUFSTARTADDR</name>
                      <description>Start address of the ring buffer. Must be aligned to SetBurstLength x 8 bytes.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>RINGBUFWRAPADDR</name>
                  <description>Ring buffer setup for destination.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RINGBUFWRAPADDR</name>
                      <description>End address of the ring buffer (last byte of the buffer plus one).</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BASEADDRESS</name>
                  <description>Destination buffer base address.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>BASEADDRESS</name>
                      <description>Byte aligned start address of the destination buffer. For 32 bit pixels BaseAddress[1:0] must be set 0 and for 16 bit pixels BaseAddress[0] must be set 0.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DESTINATIONBUFFERATTRIBUTES</name>
                  <description>Destination buffer attributes.</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x200004FF</resetValue>
                  <resetMask>0x7F01FFFF</resetMask>
                  <fields>
                    <field>
                      <name>STRIDE</name>
                      <description>Destination buffer stride in bytes minus one, used for address generation. For a pixel width of 32 bits Stride has to be dividable by 4 and given minus one and for a pixel width of 16 bit Stride has to be dividable by two and given minus one.</description>
                      <bitRange>[16:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BITSPERPIXEL</name>
                      <description>Size of a pixel in the destination buffer in bits. Has to be a power of two, 18 or 24. When 64 bit is selected, input pixels are converted into a 32 bit value that is replicated into low and high word of the 64 bit output. Set SetBurstLength at least to 2 in that case to get best possible performance.</description>
                      <bitRange>[30:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DESTINATIONBUFFERDIMENSION</name>
                  <description>Destination buffer dimension.</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x3FFF3FFF</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>LINEWIDTH</name>
                      <description>Width of the destination buffer in pixels minus one.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>LINECOUNT</name>
                      <description>Number of lines of the destination buffer in pixels minus one.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMEOFFSET</name>
                  <description>Offset between destination frame and buffer.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>FRAMEXOFFSET</name>
                      <description>Horizontal offset (X).
(format is signed integer)</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FRAMEYOFFSET</name>
                      <description>Vertical offset (Y).
(format is signed integer)</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTBITS</name>
                  <description>Color component size of destination buffer</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x8080808</resetValue>
                  <resetMask>0xF0F0F0F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTBITSALPHA</name>
                      <description>Alpha component bits.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSBLUE</name>
                      <description>Blue/V component bits.</description>
                      <bitRange>[11:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSGREEN</name>
                      <description>Green/U component bits.</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTBITSRED</name>
                      <description>Red/Y component bits.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COLORCOMPONENTSHIFT</name>
                  <description>Color component offset of destination buffer.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x18100800</resetValue>
                  <resetMask>0x1F1F1F1F</resetMask>
                  <fields>
                    <field>
                      <name>COMPONENTSHIFTALPHA</name>
                      <description>Alpha component shift.</description>
                      <bitRange>[4:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTBLUE</name>
                      <description>Blue/V component shift.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTGREEN</name>
                      <description>Green/U component shift.</description>
                      <bitRange>[20:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COMPONENTSHIFTRED</name>
                      <description>Red/Y component shift.</description>
                      <bitRange>[28:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Store unit dynamic control register</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3F10F3</resetMask>
                  <fields>
                    <field>
                      <name>COLORDITHERENABLE</name>
                      <description>Controls whether spatial dithering (value 1) or LSB truncation (value 0) is used when ComponentBitsRed/Green/Blue is smaller than 10 bits.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ALPHADITHERENABLE</name>
                      <description>Controls whether spatial dithering (value 1) or LSB truncation (value 0) is used when ComponentBitsAlpha is smaller than 8 bits.</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>DITHEROFFSET</name>
                      <description>Dither offset that is additionally applied to the spatial offset, which is internally generated from the pixel position. Can be used by SW to generate image sequences with temporal dithering.</description>
                      <bitRange>[7:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>GAMMAAPPLYENABLE</name>
                      <description>Enable gamma conversion stage to apply gamma function. This gamma function converts the pixel data from linear color space to non-linear color space before writing it to AXI.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>YUVCONVERSIONMODE</name>
                      <description>Enables different kind of RGB to YUV conversions.</description>
                      <bitRange>[17:16]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>No conversion. Input data must be RGB.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6 (standard definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU601_FR</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.601-6, but assuming full range YUV inputs (0..255). Most typically used for computer graphics (e.g. for JPEG encoding).</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU709</name>
                          <description>Conversion from YCbCr (YUV) to RGB according to ITU recommendation BT.709-5 part 2 (high definition TV). Input range is 16..235 for Y and 16..240 for U/V.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RASTERMODE</name>
                      <description>Selects a method for destination buffer data from input pixels.</description>
                      <bitRange>[19:18]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NORMAL</name>
                          <description>RGBA or YUV 4:4:4 pixel buffer.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>YUV422</name>
                          <description>Packed YUV 4:2:2 pixel buffer. Effect is that U samples are written for pixels with even and V samples for odd column index only. So BitsPerPixel must be set to the size that a pair of YU or YV has in memory (most typically 16 bits). All correlated widths and horizontal offsets must be even.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENCODE</name>
                          <description>RLAD compressed bit stream.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>YUV422DOWNSAMPLINGMODE</name>
                      <description>Selects a method for horizontal down-sampling when RasterMode is YUV422.</description>
                      <bitRange>[21:20]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEAREST</name>
                          <description>Nearest mode. Discards all odd samples, outputs even samples.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>COALIGNED</name>
                          <description>Linear coaligned mode. 3 nearest UV samples are combined in linear filter to get one output sample.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INTERSPERSED</name>
                          <description>Linear interspersed mode. 2 nearest UV samples are combined in linear filter to get one output sample.</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ENCODECONTROL</name>
                  <description>Control options for RLAD compression.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x88880001</resetValue>
                  <resetMask>0xFFFF0001</resetMask>
                  <fields>
                    <field>
                      <name>COMPRESSIONMODE</name>
                      <description>Algorithm to use for compression.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>RLAD</name>
                          <description>Run-Length Adaptive Dithering (lossy compression).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>RLAD_UNIFORM</name>
                          <description>Run-Length Adaptive Dithering (lossy compression; uniform package size).</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>RLADCOMPBITSRED</name>
                      <description>Maximum for average number of bits per compressed pixel for Red or Y (luma) channel.</description>
                      <bitRange>[19:16]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSGREEN</name>
                      <description>Maximum for average number of bits per compressed pixel for Green or U (chroma) channel.</description>
                      <bitRange>[23:20]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSBLUE</name>
                      <description>Maximum for average number of bits per compressed pixel for Blue or V (chroma) channel.</description>
                      <bitRange>[27:24]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>RLADCOMPBITSALPHA</name>
                      <description>Maximum for average number of bits per compressed pixel for Alpha channel.</description>
                      <bitRange>[31:28]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>DESTINATIONBUFFERLENGTH</name>
                  <description>Destination buffer length for compressed data.</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RLEWORDSMAX</name>
                      <description>N/A</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>START</name>
                  <description>Store unit start register</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>START</name>
                      <description>Writing a one starts processing of the pixel engine.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ENCODERSTATUS</name>
                  <description>Status information of the RLAD encoder.</description>
                  <addressOffset>0x38</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x1FFFFFFF</resetValue>
                  <resetMask>0x9FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>RLEWORDS</name>
                      <description>Number of 32-bit words minus one that was used for the compressed buffer.</description>
                      <bitRange>[28:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>BUFFERTOOSMALL</name>
                      <description>The buffer size given by RLEWordsMax is too small. Not the complete input frame could be encoded.</description>
                      <bitRange>[31:31]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>WRITEADDRESS</name>
                  <description>Ring buffer synchronization.</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>WRITEADDRESS</name>
                      <description>Last burst address that was written to the destination buffer.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRAMEPROPERTIES</name>
                  <description>Ring buffer synchronization.</description>
                  <addressOffset>0x40</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>FIELDID</name>
                      <description>Field identifier for interlaced video streams (0/1 = even/odd line indices of progressive frame). Status is updated with begin of a new field.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>BURSTBUFFERPROPERTIES</name>
                  <description>Burst Buffer Property register</description>
                  <addressOffset>0x44</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>MAXBURSTLENGTH</name>
                      <description>Maximum Burst Length that can be configured.</description>
                      <bitRange>[12:8]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LASTCONTROLWORD</name>
                  <description>Shows the last control word received</description>
                  <addressOffset>0x48</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>L_VAL</name>
                      <description>Shows the last control word received from the pixel engine. If a 39 bit pixel channel is connected, the mapping is as follows: l_val[31:0] = { data[37:22], data[19:12], data[9:2] }. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>PERFCOUNTER</name>
                  <description>Performance counter result</description>
                  <addressOffset>0x4C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PERFRESULT</name>
                      <description>Returns the performance counter value. Please note that a sw reset during a frame can potentially produce invalid results in the first frame afterwards. For debug purposes only, read when stable only, otherwise read data might be corrupted.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
              </cluster>
            </cluster>
            <cluster>
              <name>DRAWENG</name>
              <description>Drawing Engine</description>
              <addressOffset>0x00030000</addressOffset>
              <register>
                <name>STATICCONTROL</name>
                <description>Drawing Engine static control register</description>
                <addressOffset>0x0</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x30</resetValue>
                <resetMask>0x30</resetMask>
                <fields>
                  <field>
                    <name>SWRESET</name>
                    <description>Puts the Drawing Engine in software reset.</description>
                    <bitRange>[4:4]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>OPERATION</name>
                        <description>Normal Operation</description>
                        <value>0</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>SW_RESET</name>
                        <description>Software Reset</description>
                        <value>1</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>CLOCKDISABLE</name>
                    <description>Deactivates most internal clocks of Drawing Engine. Can only be activated if SWReset field is set to SW_RESET.</description>
                    <bitRange>[5:5]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>OPERATION</name>
                        <description>Normal Operation</description>
                        <value>0</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>POWERDOWN</name>
                        <description>Clocks are off</description>
                        <value>1</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                </fields>
              </register>
              <register>
                <name>STATICBURSTBUFFERMANAGEMENT</name>
                <description>Burst Buffer setup register</description>
                <addressOffset>0x4</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x40004</resetValue>
                <resetMask>0x1F001F</resetMask>
                <fields>
                  <field>
                    <name>SETFETCHBURSTLENGTH</name>
                    <description>Set this to the maximum burst length that should be used on the AXI command fetch interface. Please note that SetFetchBurstLength has to be smaller or equal to MaxFetchBurstLength and it has to be one at the least.</description>
                    <bitRange>[4:0]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>SETSTOREBURSTLENGTH</name>
                    <description>Set this to the burst length that should be used on the AXI alpha store interface. Please note that SetStoreBurstLength has to be smaller or equal to MaxStoreBurstLength. Only a power of two may be specified as burst length.</description>
                    <bitRange>[20:16]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>STATICCMDBUFFERADDRESS</name>
                <description>Lowest command buffer address</description>
                <addressOffset>0x8</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>CMDBUFFERADDRESS</name>
                    <description>Start address of the command buffer. The address is word aligned, keep bits [1:0] zero. Writing this register resets the CmdBufferReadPtr register.</description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>STATICCMDBUFFERSIZE</name>
                <description>Command buffer size</description>
                <addressOffset>0xC</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x1FF</resetValue>
                <resetMask>0x3FFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>CMDBUFFERSIZE</name>
                    <description>Command buffer size in number of 32-bit words. Only power-of-two values are allowed. The value programmed into this field must be one less than the actual number of words.</description>
                    <bitRange>[29:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>CMDBUFFERWRITEPTR</name>
                <description>Buffer end address of command list</description>
                <addressOffset>0x10</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x3FFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>CMDBUFFERWRITEPTR</name>
                    <description>Command buffer write pointer in words. This pointer must be set by the software to one word after the last valid command (start of the next operation).</description>
                    <bitRange>[29:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>TRANSFORMATIONMATRIXA11</name>
                <description>Component A11 of transformation Matrix A</description>
                <addressOffset>0x14</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x40</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>A11</name>
                    <description>A11, given in signed fixed-point 26.6 two's complement notation.
(format is signed fix-point 26.6)</description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>TRANSFORMATIONMATRIXA21</name>
                <description>Component A21 of transformation Matrix A</description>
                <addressOffset>0x18</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>A21</name>
                    <description>A21, given in signed fixed-point 26.6 two's complement notation.
(format is signed fix-point 26.6)</description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>TRANSFORMATIONMATRIXA12</name>
                <description>Component A12 of transformation Matrix A</description>
                <addressOffset>0x1C</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>A12</name>
                    <description>A12, given in signed fixed-point 26.6 two's complement notation.
(format is signed fix-point 26.6)</description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>TRANSFORMATIONMATRIXA22</name>
                <description>Component A22 of transformation Matrix A</description>
                <addressOffset>0x20</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x40</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>A22</name>
                    <description>A22, given in signed fixed-point 26.6 two's complement notation.
(format is signed fix-point 26.6)</description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>TRANSLATIONVECTORX</name>
                <description>Horizontal translation of the alpha frame.</description>
                <addressOffset>0x24</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x3FFFFF</resetMask>
                <fields>
                  <field>
                    <name>TRANSLATIONX</name>
                    <description>Horizontal translation (X), given in signed 16.6 fixed-point format. Fractional part is used for processing. The integer part modifies the XOffset field of the LayerOffset register for subsequent Blit operation.
(format is signed fix-point 16.6)</description>
                    <bitRange>[21:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>TRANSLATIONVECTORY</name>
                <description>Vertical translation of the alpha frame.</description>
                <addressOffset>0x28</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x3FFFFF</resetMask>
                <fields>
                  <field>
                    <name>TRANSLATIONY</name>
                    <description>Vertical translation (Y), given in signed 16.6 fixed-point format. Fractional part is used for processing. The integer part modifies the YOffset field of the LayerOffset register for subsequent Blit operation.
(format is signed fix-point 16.6)</description>
                    <bitRange>[21:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>PROCESSINGCONTROL</name>
                <description>Drawing Engine main processing control register</description>
                <addressOffset>0x2C</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x200008</resetValue>
                <resetMask>0x3F001F</resetMask>
                <fields>
                  <field>
                    <name>SUBPIXELGRID</name>
                    <description>Higher SubPixelGrid (super sampling) results in better anti-aliased output at the cost of processing time.</description>
                    <bitRange>[3:0]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>TOTALBITS_1</name>
                        <description>1 bit per pixel, anti-aliased</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>TOTALBITS_2</name>
                        <description>2 bit per pixel, results in 2 bit anti-aliased intermediate value</description>
                        <value>2</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>TOTALBITS_4</name>
                        <description>4 bit per pixel, results in 4 bit anti-aliased intermediate value</description>
                        <value>4</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>TOTALBITS_8</name>
                        <description>8 bit per pixel, results in 6 bit anti-aliased intermediate value</description>
                        <value>8</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>FILLRULE</name>
                    <description>Set the fill rule.</description>
                    <bitRange>[4:4]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>NONZERO</name>
                        <description>a edge count unequal zero is inside</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>EVENODD</name>
                        <description>an odd edge count is inside, an even edge count is outside</description>
                        <value>0</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>TARGETBITSPERPIXEL</name>
                    <description>Number of bits per pixel in the target buffer for the following blit operation. Must be 1, 2, 4, 8, 16, 18, 24 or 32. This field allows to obtain an aligned bounding box width.</description>
                    <bitRange>[21:16]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>STORECONTROL</name>
                <description>Store unit dynamic control register</description>
                <addressOffset>0x30</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x8</resetValue>
                <resetMask>0x1FFFF0F</resetMask>
                <fields>
                  <field>
                    <name>STOREBITSPERPIXEL</name>
                    <description>The resulting alpha mask can be saved to memory with the following BitsPerPixel settings.</description>
                    <bitRange>[3:0]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>TOTALBITS_1</name>
                        <description>1 bit per pixel</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>TOTALBITS_2</name>
                        <description>2 bit per pixel</description>
                        <value>2</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>TOTALBITS_4</name>
                        <description>4 bit per pixel</description>
                        <value>4</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>TOTALBITS_8</name>
                        <description>8 bit per pixel</description>
                        <value>8</value>
                      </enumeratedValue>
                    </enumeratedValues>
                  </field>
                  <field>
                    <name>STORESTRIDE</name>
                    <description>Destination buffer stride in bytes minus one. Used for address generation.</description>
                    <bitRange>[24:8]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>DESTINATIONBUFFERDIMENSIONS</name>
                <description>Maximum dimensions of the destination buffer. The resulting alpha frame is limited to this dimensions. However, the active area can be smaller and is given by ActiveDimensions register.</description>
                <addressOffset>0x34</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x3FFF3FFF</resetMask>
                <fields>
                  <field>
                    <name>DSTBUFFERWIDTH</name>
                    <description>Maximum width of the destination buffer in pixels minus one.</description>
                    <bitRange>[13:0]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>DSTBUFFERHEIGHT</name>
                    <description>Maximum height of the destination buffer in pixels minus one.</description>
                    <bitRange>[29:16]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>DESTINATIONBUFFER</name>
                <description>Destination buffer base address</description>
                <addressOffset>0x38</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>DSTBASEADDRESS</name>
                    <description>Byte aligned start address of the destination buffer.</description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>START</name>
                <description>Drawing Engine start register</description>
                <addressOffset>0x3C</addressOffset>
                <size>32</size>
                <access>write-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x1</resetMask>
                <fields>
                  <field>
                    <name>START</name>
                    <description>Writing a one starts processing.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>write-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>READACK</name>
                <description>Drawing Engine read acknowledge register</description>
                <addressOffset>0x40</addressOffset>
                <size>32</size>
                <access>write-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x1</resetMask>
                <fields>
                  <field>
                    <name>READACK</name>
                    <description>Writing a one acknowledges the read of the status registers (ActiveDimensions, Offset, Error).</description>
                    <bitRange>[0:0]</bitRange>
                    <access>write-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>CMDBUFFERREADPTR</name>
                <description>Buffer end address of command list</description>
                <addressOffset>0x44</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x3FFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>CMDBUFFERREADPTR</name>
                    <description>Command buffer read pointer in words. This pointer is modified by the Drawing Engine hardware and indicates which words are ultimately consumed.</description>
                    <bitRange>[29:0]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>ACTIVEDIMENSIONS</name>
                <description>Shows active dimensions of the output alpha frame. This register is aligned to the ClipWindowDimensions register of the fetch.</description>
                <addressOffset>0x48</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x3FFF3FFF</resetMask>
                <fields>
                  <field>
                    <name>ACTIVEWIDTH</name>
                    <description>Active width of the resulting alpha frame minus one.</description>
                    <bitRange>[13:0]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>ACTIVEHEIGHT</name>
                    <description>Active height of the resulting alpha frame minus one.</description>
                    <bitRange>[29:16]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>LAYEROFFSET</name>
                <description>Desired position of the alpha frame for the following Blit operation. This register is aligned to the LayerOffset of the fetch and given as signed 16.0 values.</description>
                <addressOffset>0x4C</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>XOFFSET</name>
                    <description>Horizontal offset (X).
(format is signed integer)</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>YOFFSET</name>
                    <description>Vertical offset (Y).
(format is signed integer)</description>
                    <bitRange>[31:16]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>ERROR</name>
                <description>Error status of finished operation. If register is unequal to zero the resulting raster image is most likely corrupted.</description>
                <addressOffset>0x50</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xF</resetMask>
                <fields>
                  <field>
                    <name>FETCHERROR</name>
                    <description>Indicates if an bus error occurred while fetching the command list.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>STOREERROR</name>
                    <description>Indicates if storing the alpha bitmap to memory failed.</description>
                    <bitRange>[1:1]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>INSTRERROR</name>
                    <description>Indicates if the command list contained an illegal or unexpected instruction.</description>
                    <bitRange>[2:2]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>OVERFLOWERROR</name>
                    <description>Indicates if an overflow occurred when truncating to internal data width.</description>
                    <bitRange>[3:3]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>BURSTBUFFERPROPERTIES</name>
                <description>Burst Buffer Property register</description>
                <addressOffset>0x54</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x0</resetMask>
                <fields>
                  <field>
                    <name>MAXFETCHBURSTLENGTH</name>
                    <description>Maximum Burst Length that can be configured for command fetch.</description>
                    <bitRange>[4:0]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>MAXSTOREBURSTLENGTH</name>
                    <description>Maximum Burst Length that can be configured for alpha store.</description>
                    <bitRange>[20:16]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>STATUS</name>
                <description>Status bits.</description>
                <addressOffset>0x58</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x4</resetValue>
                <resetMask>0xF</resetMask>
                <fields>
                  <field>
                    <name>STATUSBUSY</name>
                    <description>Indicates if Drawing Engine is busy with drawing a command list.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>WAITACK</name>
                    <description>Indicates if Drawing Engine is waiting on an read acknowledge.</description>
                    <bitRange>[1:1]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>STATUSDIRTY</name>
                    <description>Indicates if the linebuffer memory requires a clear prior to the next drawing operation.</description>
                    <bitRange>[2:2]</bitRange>
                    <access>read-only</access>
                  </field>
                  <field>
                    <name>STARTPENDING</name>
                    <description>Indicates if another start trigger is pending.</description>
                    <bitRange>[3:3]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>PERFCOUNTERFRONT</name>
                <description>Performance counter result</description>
                <addressOffset>0x5C</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>PERFRESULTFRONT</name>
                    <description>Returns the performance counter value of the front pipeline. For the total cycle count add PerfResultFront and PerfResultBack. For debug purposes only, read when stable only.</description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>PERFCOUNTERBACK</name>
                <description>Performance counter result</description>
                <addressOffset>0x60</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>PERFRESULTBACK</name>
                    <description>Returns the performance counter value of the back pipeline. For the total cycle count add PerfResultFront and PerfResultBack. For debug purposes only, read when stable only.</description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
            </cluster>
          </cluster>
        </cluster>
