                  <description>Matrix values for calculation of the alpha output value.</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFF1FFF</resetMask>
                  <fields>
                    <field>
                      <name>A41</name>
                      <description>Value for red input.
(format is signed fix-point 3.10)</description>
                      <bitRange>[12:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>A42</name>
                      <description>Value for green input.
(format is signed fix-point 3.10)</description>
                      <bitRange>[28:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ALPHA1</name>
                  <description>Matrix values for calculation of the alpha output value.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x4000000</resetValue>
                  <resetMask>0x1FFF1FFF</resetMask>
                  <fields>
                    <field>
                      <name>A43</name>
                      <description>Value for blue input.
(format is signed fix-point 3.10)</description>
                      <bitRange>[12:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>A44</name>
                      <description>Value for alpha input.
(format is signed fix-point 3.10)</description>
                      <bitRange>[28:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>OFFSETVECTOR0</name>
                  <description>Offset vectors for red and green output.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFF1FFF</resetMask>
                  <fields>
                    <field>
                      <name>C1</name>
                      <description>Red output offset.
(format is signed integer)</description>
                      <bitRange>[12:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>C2</name>
                      <description>Green output offset.
(format is signed integer)</description>
                      <bitRange>[28:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>OFFSETVECTOR1</name>
                  <description>Offset vectors for blue and alpha output.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFF1FFF</resetMask>
                  <fields>
                    <field>
                      <name>C3</name>
                      <description>Blue output offset.
(format is signed integer)</description>
                      <bitRange>[12:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>C4</name>
                      <description>Alpha output offset. Note that the 8-bit alpha input is up-scaled to 10-bit, before the matrix and this offset is applied, and down-scaled to 8-bit for output afterwards.
(format is signed integer)</description>
                      <bitRange>[28:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
              </cluster>
              <cluster>
                <name>GPSCALER</name>
                <description>GPScaler (only for IBO)</description>
                <addressOffset>0x00006400</addressOffset>
                <register>
                  <name>STATICCONTROL</name>
                  <description>Static control settings that must typically be setup once only.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>SHDEN</name>
                      <description>If ShdEn==1 shadow registers are loaded when indicated by hardware signal ( a command signal in the data stream at frame start ). If ShdEn==0 shadow registers are loaded each frame start.
(format is unsigned integer)</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CONTROL</name>
                  <description>Global operation control.</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x10F</resetMask>
                  <fields>
                    <field>
                      <name>MODE</name>
                      <description>Controls the sequence of horizontal and vertical operation for all operation modes.
(format is unsigned integer)</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Neutral mode. Pixels are by-passed unchanged, all other settings are ignored.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE_AUTO</name>
                          <description>Automatic mode. Behaves like ACTIVE_VER_FIRST when operation_mode=SCALE and scale_mode_h=UPSCALE, like ACTIVE_HOR_FIRST otherwise.</description>
                          <value>14</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE_HOR_FIRST</name>
                          <description>Horizontal is done before vertical operation.</description>
                          <value>12</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE_VER_FIRST</name>
                          <description>Vertical is done before horizontal operation.</description>
                          <value>13</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE_HOR_ONLY</name>
                          <description>Only horizontal operation is done.</description>
                          <value>8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE_VER_ONLY</name>
                          <description>Only vertical operation is done.</description>
                          <value>5</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>OPERATION_MODE</name>
                      <description>Selects the kind of operation to execute.
(format is unsigned integer)</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>SCALE</name>
                          <description>Scaler is active with the corresponding settings from scaler registers; filter registers are ignored.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FIR</name>
                          <description>FIR-Filter is active with the corresponding settings from filter registers; scaler registers are ignored.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>OUTPUTDIMENSION</name>
                  <description>Dimensions of the output frame or fame slice. This values are required for both FIR filter and scaler, since their output may have other dimension than input. The dimension of scaler's output is defined by the scale factor. The dimension of FIR filter's output depends on the tiling at the begin and the end of the slice.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>OUTPUT_WIDTH</name>
                      <description>Number of output pixel per input line. This number is equal to the width of the output frame minus one.
(format is unsigned integer)</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>OUTPUT_HEIGHT</name>
                      <description>Number of output lines per input frame or slice. This number is equal to the height of the output frame minus one.
(format is unsigned integer)</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCALERCONTROL</name>
                  <description>Scaler operation control.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x20000</resetValue>
                  <resetMask>0xFF31111</resetMask>
                  <fields>
                    <field>
                      <name>SCALE_MODE_H</name>
                      <description>Scale mode for horizontal scaling.
(format is unsigned integer)</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DOWNSCALE</name>
                          <description>Down-scaling (output width is less or equal input width).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>UPSCALE</name>
                          <description>Up-scaling (output width greater or equal input width)</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>SCALE_MODE_V</name>
                      <description>Scale mode for vertical scaling.
(format is unsigned integer)</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DOWNSCALE</name>
                          <description>Down-scaling (output height less or equal input height).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>UPSCALE</name>
                          <description>Up-scaling (output height greater or equal input height)</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>FILTER_MODE_H</name>
                      <description>Selects sampling algorithm for horizontal scaling.
(format is unsigned integer)</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEAREST</name>
                          <description>Nearest filter (point-sampling)</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LINEAR</name>
                          <description>Box filter (linear)</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>FILTER_MODE_V</name>
                      <description>Selects sampling algorithm for vertical scaling.
(format is unsigned integer)</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEAREST</name>
                          <description>Nearest filter (point-sampling)</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LINEAR</name>
                          <description>Box filter (linear)</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>FIELD_MODE</name>
                      <description>Controls generation of output field polarity for vertical scaling.
(format is unsigned integer)</description>
                      <bitRange>[17:16]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ALWAYS0</name>
                          <description>Constant 0 indicates frame or top field.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ALWAYS1</name>
                          <description>Constant 1 indicates bottom field.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>INPUT</name>
                          <description>Output field polarity is taken from input field polarity.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TOGGLE</name>
                          <description>Output field polarity toggles, starting with 0 after reset.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHA_VALUE</name>
                      <description>When 'mode' field is not 'NEUTRAL', then input alpha values are ignore and output alpha set to this constant value for all pixels. This restriction applies to GPScalerL derivative only.
(format is unsigned integer)</description>
                      <bitRange>[27:20]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCALERSETUPH0</name>
                  <description>Phase interpolator setup.</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x80000</resetValue>
                  <resetMask>0xFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>SCALE_FACTOR_H</name>
                      <description>Scale factor has to be greater than 0.0 and less than or equal to 1.0. If scale_mode is UPSCALE then the inverse scale factor has to be programmed.
(format is unsigned fix-point 1.19)</description>
                      <bitRange>[19:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCALERSETUPH1</name>
                  <description>Phase interpolator setup.</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PHASE_OFFSET_H</name>
                      <description>Phase offset has to be larger than -2 and smaller than +2. Depending on scale_mode this value is relative to input (UPSCALE) or output pixel (DOWNSCALE). A negative value shifts the image to the right, a positive one to the left.
(format is signed fix-point 2.19)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCALERSETUPV0</name>
                  <description>Phase interpolator setup.</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x80000</resetValue>
                  <resetMask>0xFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>SCALE_FACTOR_V</name>
                      <description>Scale factor is greater than 0.0 and less than or equal to 1.0. If scale_mode is UPSCALE then the inverse scale factor have to be programmed.
(format is unsigned fix-point 1.19)</description>
                      <bitRange>[19:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCALERSETUPV1</name>
                  <description>Phase interpolator setup, selected if input and output field polarity is 0.</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PHASE_OFFSET_V</name>
                      <description>Phase offset has to be larger than -2 and smaller than +2. Depending on scale_mode this value is relative to input (UPSCALE) or output pixel (DOWNSCALE). A negative value shifts the image to the bottom, a positive one to the top.
(format is signed fix-point 2.19)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCALERSETUPV2</name>
                  <description>Phase interpolator setup, selected if input field polarity is 1 and output field polarity is 0.</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PHASE_OFFSET_V1</name>
                      <description>Phase offset has to be larger than -2 and smaller than +2. Depending on scale_mode this value is relative to input (UPSCALE) or output pixel (DOWNSCALE). A negative value shifts the image to the bottom, a positive one to the top.
(format is signed fix-point 2.19)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCALERSETUPV3</name>
                  <description>Phase interpolator setup, selected if input field polarity is 0 and output field polarity is 1.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PHASE_OFFSET_V2</name>
                      <description>Phase offset has to be larger than -2 and smaller than +2. Depending on scale_mode this value is relative to input (UPSCALE) or output pixel (DOWNSCALE). A negative value shifts the image to the bottom, a positive one to the top.
(format is signed fix-point 2.19)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCALERSETUPV4</name>
                  <description>Phase interpolator setup, selected if input and output field polarity is 1.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PHASE_OFFSET_V3</name>
                      <description>Phase offset has to be larger than -2 and smaller than +2. Depending on scale_mode this value is relative to input (UPSCALE) or output pixel (DOWNSCALE). A negative value shifts the image to the bottom, a positive one to the top.
(format is signed fix-point 2.19)</description>
                      <bitRange>[20:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FILTERCONTROL</name>
                  <description>Filter operation control.</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFF33FF77</resetMask>
                  <fields>
                    <field>
                      <name>TAPS_H</name>
                      <description>Defines the horizontal size of the FIR filter between 1 and 15 with increment of 2. Only odd filter width is supported. To program this field following formula has to be used: (filter width - 1)/2
(format is unsigned integer)</description>
                      <bitRange>[2:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TAPS_V</name>
                      <description>Defines the vertical size of the FIR filter between 1 and 15 with increment of 2. Only odd filter width is supported. To program this field following formula has to be used: (filter height - 1)/2
(format is unsigned integer)</description>
                      <bitRange>[6:4]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>BYPASS_MODE_R</name>
                      <description>Bypass configuration for red color components of every pixel.
(format is unsigned integer)</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Red color is filtered.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE</name>
                          <description>Red color is not filtered, but is written to the line buffer.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>BYPASS_MODE_G</name>
                      <description>Bypass configuration for green color components of every pixel.
(format is unsigned integer)</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Green color is filtered.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE</name>
                          <description>Green color is not filtered, but is written to the line buffer.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>BYPASS_MODE_B</name>
                      <description>Bypass configuration for blue color components of every pixel.
(format is unsigned integer)</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Blue color is filtered.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE</name>
                          <description>Blue color is not filtered, but is written to the line buffer.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>BYPASS_MODE_A</name>
                      <description>Bypass configuration for alpha components of every pixel.
(format is unsigned integer)</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>NEUTRAL</name>
                          <description>Alpha is filtered.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ACTIVE</name>
                          <description>Alpha is not filtered, but is written to the line buffer.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>EXPONENT_FIR</name>
                      <description>FIR product sum is divided by 2**FIR_exponent and rounded.
(format is unsigned integer)</description>
                      <bitRange>[15:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILE_MODE</name>
                      <description>Selects the tile mode for pixels outside the source frame. In order to enable tiling tiling_at_begin_h or tiling_at_begin_v and the corresponding output frame dimension have to be set.
(format is unsigned integer)</description>
                      <bitRange>[17:16]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>TILE_FILL_ZERO</name>
                          <description>Use zero value.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_FILL_CONSTANT</name>
                          <description>Use constant color value from the field tile_color.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD</name>
                          <description>Use closest pixel from source frame.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>TILE_PAD_ZERO</name>
                          <description>Use closest pixel from source buffer but zero for alpha component.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>TILING_AT_BEGIN_H</name>
                      <description>If set to true, this bit enables tiling at the begin of the slice for horizontal direction. Tiling at the end occurs automatically by setting the corresponding output size.
(format is unsigned integer)</description>
                      <bitRange>[20:20]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILING_AT_BEGIN_V</name>
                      <description>If set to true, this bit enables tiling at the begin of the slice for vertical direction. Tiling at the end occurs automatically by setting the corresponding output size.
(format is unsigned integer)</description>
                      <bitRange>[21:21]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILE_COLOR_ALPHA</name>
                      <description>Sets the alpha value for pixels outside of the slice.
(format is unsigned integer)</description>
                      <bitRange>[31:24]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>TILECOLORRGB</name>
                  <description>Color for outside of the slice.</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>TILE_COLOR_RED</name>
                      <description>Sets the red color value for pixels outside of the slice.
(format is unsigned integer)</description>
                      <bitRange>[9:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILE_COLOR_GREEN</name>
                      <description>Sets the green color value for pixels outside of the slice.
(format is unsigned integer)</description>
                      <bitRange>[19:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>TILE_COLOR_BLUE</name>
                      <description>Sets the blue color value for pixels outside of the slice.
(format is unsigned integer)</description>
                      <bitRange>[29:20]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>COEFFICIENTSH0</name>
                  <description>Horizontal coefficients for filter_mode FIR.</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
