                  <resetValue>0x0</resetValue>
                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>C_XVAL</name>
                      <description>value of horizontal pixel counter, internal counter counting from max-1 to 0</description>
                      <bitRange>[15:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>C_YVAL</name>
                      <description>value of vertical line counter, internal counter counting from max-1 to 0</description>
                      <bitRange>[31:16]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LASTPIXELCNT</name>
