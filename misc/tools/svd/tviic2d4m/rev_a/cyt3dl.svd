            <register>
              <name>FPDLINKCFG</name>
              <description>FPDLink Configuration</description>
              <addressOffset>0x1C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>FPDLINKSEL</name>
