                    <field>
                      <name>TOTALHEIGHT</name>
                      <description>Frame height (programmed with -1).</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>OPERATIONSETUP</name>
                  <description>Setup for rendering operation.</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFF33</resetMask>
                  <fields>
                    <field>
                      <name>DESTINATIONSELECT</name>
                      <description>Select operation for destination buffer. In IBO the buffer is provided via the FETCHDST in LBO the buffer is provided via internal RGBA slice buffer.</description>
                      <bitRange>[1:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>Destination buffer is not read, used for FILL or COPY operations.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROP</name>
                          <description>Destination is connected to raster operation block (tertary). Only possible in IBO mode.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLEND</name>
                          <description>Destination is connected to blend operation block.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FETCHMASK</name>
                          <description>Destination fetch is connected to the external input of the fetch MASK, for planar YUV. Only possible in IBO mode.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>MASKSELECT</name>
                      <description>Select operation for mask buffer. In IBO the buffer is provided via the FETCHMASK; in LBO the buffer is provided via internal ALPHA slice buffer. If the value of both fields this and DestinationSelect is BLEND, OFF is used for this field.</description>
                      <bitRange>[5:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>OFF</name>
                          <description>Mask buffer is not read.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ROP</name>
                          <description>Mask is connected to raster operation block (secondary). Only possible in IBO mode.</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>BLEND</name>
                          <description>Mask is connected to blend operation block. Only possible in LBO mode.</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>FETCHSRC</name>
                          <description>Mask is connected to the fetch SRC.</description>
                          <value>3</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>BUFFERSELECT</name>
                      <description>Line buffer to render into. This field is ignored for IBO render mode.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>RGBA</name>
                          <description>RGBA buffer.</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>MASK</name>
                          <description>MASK buffer.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ENABLEROP</name>
                      <description>Set 1 to enable ROP module. This field is ignored for LBO render mode.</description>
                      <bitRange>[9:9]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ENABLECLUT</name>
                      <description>Set 1 to enable CLUT. This field is ignored for LBO render mode.</description>
                      <bitRange>[10:10]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ENABLEMATRIX</name>
                      <description>Set 1 to enable matrix.</description>
                      <bitRange>[11:11]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ENABLEGPSCALER</name>
                      <description>Set 1 enable GPScaler. This field is ignored for LBO render mode.</description>
                      <bitRange>[12:12]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ENABLEBLITBLEND</name>
                      <description>Set 1 enable the BlitBlend module. If this field is set</description>
                      <bitRange>[13:13]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CONSTANTCOLORFILL</name>
                      <description>If this field is set, the selected destination (BufferSelect) will be filled with constant color (ConstantColorRed, ConstantColorGreen, ConstantColorBlue, ConstantAlpha) not using any fetch pipeline. Only possible in LBO mode.</description>
                      <bitRange>[14:14]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>USECOPS</name>
                      <description>Cops are used for the next fetch operation. If the value is zero, CopsAddress is not evaluated. Only possible in LBO mode.</description>
                      <bitRange>[15:15]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>COPSADDRESS</name>
                      <description>Address to use in Current Object Processing State (COPS) memory (required for decode operations). Only possible in LBO mode.</description>
                      <bitRange>[23:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
