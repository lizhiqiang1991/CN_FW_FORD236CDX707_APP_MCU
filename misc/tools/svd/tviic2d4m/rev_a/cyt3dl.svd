                  </field>
                </fields>
              </register>
              <register>
                <name>INTR_VIDEOIO1_SAFETY_MASKED</name>
                <description>Interrupt masked register 1</description>
                <addressOffset>0x3C</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x0</resetMask>
                <fields>
                  <field>
                    <name>INTR_VIDEOIO1_SAFETY_MASKED</name>
                    <description>Status vector INTR_VIDEOIO1_SAFETY masked with INTR_MASK_SAFETY1.</description>
                    <bitRange>[27:0]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
            </cluster>
            <cluster>
              <name>FRAMEDUMP</name>
              <description>Frame Dump Unit</description>
              <addressOffset>0x00000400</addressOffset>
              <register>
                <name>CONTROL</name>
                <description>Control settings.</description>
                <addressOffset>0x0</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x3000001</resetMask>
                <fields>
                  <field>
                    <name>INPUTSELECT</name>
                    <description>Index of display stream that is dumped.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>SETFIELD</name>
                    <description>The field property of the generated frame is set to this value. If field toggle is used, this is the start value.</description>
                    <bitRange>[24:24]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>TOGGLEFIELD</name>
                    <description>Enable toggling of the field property from frame to frame. Set to '1' to enable.</description>
                    <bitRange>[25:25]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>FRAMESIZE</name>
                <description>Dump window size.</description>
                <addressOffset>0x4</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0xEF013F</resetValue>
                <resetMask>0x3FFF3FFF</resetMask>
                <fields>
                  <field>
                    <name>FRAMEWIDTH</name>
                    <description>Width of output frame of framedump, given minus one. Do not change during operation.</description>
                    <bitRange>[13:0]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>FRAMEHEIGHT</name>
                    <description>Height of output frame of framedump, given minus one. Do not change during operation.</description>
                    <bitRange>[29:16]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>INPUTSETUP</name>
                <description>Dump window position.</description>
                <addressOffset>0x8</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x3FFF3FFF</resetMask>
                <fields>
                  <field>
                    <name>INPUTCAPTUREXOFFSET</name>
                    <description>X offset of capture area. Note that capture windows must not overlap the last column of the input frame. Do not change during operation.</description>
                    <bitRange>[13:0]</bitRange>
                    <access>read-write</access>
                  </field>
                  <field>
                    <name>INPUTCAPTUREYOFFSET</name>
                    <description>Y offset of capture area. Note that capture windows must not overlap the last row of the input frame. Do not change during operation.</description>
                    <bitRange>[29:16]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>ENABLE</name>
                <description>Enable register.</description>
                <addressOffset>0xC</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x1</resetMask>
                <fields>
                  <field>
                    <name>DUMPEN</name>
                    <description>If this is set to 1, the framedump unit will continuously dump all input frames. If set to 0, DumpReq is the other option of triggering the dumping of an input frame.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>TRIGGER</name>
                <description>Trigger bits.</description>
                <addressOffset>0x10</addressOffset>
                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0x1</resetMask>
                <fields>
                  <field>
                    <name>DUMPREQ</name>
                    <description>Next frame is dumped when this field is set. It is reset by HW once dumping of frame data has started. It cannot be reset by SW.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>STATUS</name>
                <description>Status register.</description>
                <addressOffset>0x14</addressOffset>
                <size>32</size>
                <access>read-only</access>
                <resetValue>0x1</resetValue>
                <resetMask>0x1</resetMask>
                <fields>
                  <field>
                    <name>DUMPIDLE</name>
                    <description>If read as '1', the framedump unit is currently not dumping any frames. If read as '0' the framedump unit is currently dumping frames.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
            </cluster>
            <cluster>
              <name>CAPENG0</name>
              <description>Capture Engine</description>
              <addressOffset>0x00001000</addressOffset>
              <cluster>
                <name>FRAMECAP</name>
                <description>Frame Capture Unit</description>
                <addressOffset>0x00000400</addressOffset>
                <register>
                  <name>CAPTUREMODE</name>
                  <description>Capture mode configuration. FrameCap input mode configuration.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3</resetMask>
                  <fields>
                    <field>
                      <name>CAPTUREMODE</name>
                      <description>Selects a capture mode. Do not change during operation of FrameCap unit.</description>
                      <bitRange>[1:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>ENHSVS_32BIT</name>
                          <description>Capture of 32-bit parallel or MIPI_CSI2 pixel input data with dedicated frame synchronization signals</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU656_10BIT</name>
                          <description>Capture of ITU656 10 bit data</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ITU656_8BIT</name>
                          <description>Capture of ITU656 8 bit data</description>
                          <value>2</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CTR</name>
                  <description>FrameCap control register for starting the unit</description>
                  <addressOffset>0x4</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>CEN</name>
                      <description>CaptureEnable=1, enable bit for FrameCap unit. Capture starts with next frame sync signal.
CaptureEnable=0, disable bit for FrameCap unit. Current frame is completed before FrameCap is stopped.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SPR</name>
                  <description>FrameCap sync signal polarity configuration.</description>
                  <addressOffset>0x8</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7</resetMask>
                  <fields>
                    <field>
                      <name>POLEN</name>
                      <description>Change polarity of video signal de.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>HIGHACT</name>
                          <description>Signal is active high (default).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>LOWACT</name>
                          <description>Signal is active low.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>POLHS</name>
                      <description>Change polarity of video signal hsync.</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>LOWACT</name>
                          <description>Signal is active low (default).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>HIGHACT</name>
                          <description>Signal is active high.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>POLVS</name>
                      <description>Change polarity of video signal vsync.</description>
                      <bitRange>[2:2]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>LOWACT</name>
                          <description>Signal is active low (default).</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>HIGHACT</name>
                          <description>Signal is active high.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>MDR</name>
                  <description>FrameCap control register for starting the mode detection</description>
                  <addressOffset>0xC</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>MDR_EN</name>
                      <description>Mdr_en=1, enable bit for FrameCap mode detection and pixel frame rate measurement for the captured frame. Make sure that MdSts0.MdrCmrDone is 1 before starting it again.
Mdr_en=0, disable bit for FrameCap mode detection.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>FRAMET_OFFSET</name>
                      <description>Frame size tolerance which will not generate a mode detection size mismatch. Set an offset for frame time duration.</description>
                      <bitRange>[31:1]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FDR</name>
                  <description>Frame dimension (progressive frame and field 0).</description>
                  <addressOffset>0x10</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xEF013F</resetValue>
                  <resetMask>0x3FFF3FFF</resetMask>
                  <fields>
                    <field>
                      <name>WIDTH</name>
                      <description>Expected frame width of video frame (value is Width - 1). It could be configured after mode detection.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>HEIGHT</name>
                      <description>Expected frame height of video frames and fields with id 0 (value is Height - 1). It could be configured after mode detection.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FDR1</name>
                  <description>Frame dimension (field 1).</description>
                  <addressOffset>0x14</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0xEF0000</resetValue>
                  <resetMask>0x3FFF0000</resetMask>
                  <fields>
                    <field>
                      <name>HEIGHT1</name>
                      <description>Expected frame height of video fields with id 1 (value is Height - 1). It could be configured after mode detection.</description>
                      <bitRange>[29:16]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>KDR</name>
                  <description>FrameCap kick delay configuration register</description>
                  <addressOffset>0x18</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>KICKDEL</name>
                      <description>Delay after receiving last active pixel in frame (in video clock cycles) until the kick pulse is generated.
In any case the kick pulse is generated with first active pixel of next frame latest.</description>
                      <bitRange>[27:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>SCR</name>
                  <description>FrameCap Sync frame number configuration register</description>
                  <addressOffset>0x1C</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x2</resetValue>
                  <resetMask>0xF</resetMask>
                  <fields>
                    <field>
                      <name>FUS</name>
                      <description>Number of consecutive frames captured until synchronization state is reached (value of 0 is not allowed).
indicated by sts signal and register field Sts.SyncStat.</description>
                      <bitRange>[3:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CSVR</name>
                  <description>Framecap control register for capture clock supervision</description>
                  <addressOffset>0x20</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x22</resetValue>
                  <resetMask>0x7FF</resetMask>
                  <fields>
                    <field>
                      <name>CSVENABLE</name>
                      <description>CsvEnable=1, start a capture clock supervision.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>CSVTIMEOUT</name>
                      <description>setting a time limitation for waiting the recovery of capture clock. The value should be bigger than 11 or equal to 11, otherwise it reports fake clk_cap loss.</description>
                      <bitRange>[10:1]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>STSCLR</name>
                  <description>FrameCap status clear register. Clears the status bits of Sts register, Mdr_SizeChange and Csv_lost field.</description>
                  <addressOffset>0x24</addressOffset>
                  <size>32</size>
                  <access>write-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1</resetMask>
                  <fields>
                    <field>
                      <name>STATUSCLEAR</name>
                      <description>Clears status bits of Sts register.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>write-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>STS</name>
                  <description>FrameCap status register. Current status of the FrameCap module.</description>
                  <addressOffset>0x28</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x13F</resetMask>
                  <fields>
                    <field>
                      <name>FIFOFULL</name>
                      <description>Write Access to the full coupling FIFO (bit locked when 1, cleared by writing StatusClear field).</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>VSLATE</name>
                      <description>VSYNC is detected too late. The received frame is too big (bit locked when 1, cleared by writing StatusClear field).</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>VSEARLY</name>
                      <description>VSYNC is detected too early. The received frame is too small (bit locked when 1, cleared by writing StatusClear field).</description>
                      <bitRange>[2:2]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>CSV_LOST</name>
                      <description>Csv_Lost=1, capture clock is not available. Csv_Lost=0, capture clock is resumed.(bit locked when 1, cleared by writing StatusClear field).</description>
                      <bitRange>[3:3]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>MDR_SIZECHANGE</name>
                      <description>Mdr_SizeChange=1, frame size of the video frame detected is not consistent.
(bit locked when 1, clear by writing StatusClear field).
If frame size change, the clock measurement fails.</description>
                      <bitRange>[4:4]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>MDRCMRDONE</name>
                      <description>MdrCmrDone=1 means that the mode detection is completed and pixel clock measurement is done.
(bit locked when 1, clear by writing StatusClear field).</description>
                      <bitRange>[5:5]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>SYNCSTAT</name>
                      <description>Indicates the current state of synchronization (0 = out of sync, 1 = in sync).
Note: A loss of the video stream cannot be detected using this field.
Use the framegen status fields for this purpose.</description>
                      <bitRange>[8:8]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>MDSTS0</name>
                  <description>FrameCap mode detection status register for the active part of the video frames.(bit locked when MdrCmrDone=1).</description>
                  <addressOffset>0x2C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>ACTIVEWIDTH</name>
                      <description>Frame width of active part of the video frame detected by the mode detection. The status can be read when MdrCmrDone=1.</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>ACTIVEHEIGHT</name>
                      <description>Frame height of active part of the video frame detected by the mode detection. The status can be read when MdrCmrDone=1.</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>MDSTS1</name>
                  <description>FrameCap mode detection status register. The current (x,y) position of the capture stream (with respect to the output).</description>
                  <addressOffset>0x30</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x7FFF7FFF</resetMask>
                  <fields>
                    <field>
                      <name>POSITIONX</name>
                      <description>the current X position of the capture stream.</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>POSITIONY</name>
                      <description>the current Y position of the capture stream.</description>
                      <bitRange>[30:16]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRCNT</name>
                  <description>FrameCap frame counter register indicating the corresponding clk_axi cycles.</description>
                  <addressOffset>0x34</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>FRCOUNT</name>
                      <description>Shows frame counts of video input. It is updated every vsync (for debugging purposes only).</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>FRLINECOUNT</name>
                  <description>FrameCap line counter register.</description>
                  <addressOffset>0x38</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3F1F0000</resetMask>
                  <fields>
                    <field>
                      <name>FRLINECOUNT</name>
                      <description>Shows current line number of input timing. Incremented with leading edge of hsync signal, set to 0 with leading edge of vsync signal.</description>
                      <bitRange>[13:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>TOTWIDTHT_MSBS</name>
                      <description>MSBs of CmSts1.TotWidthT. Bit locked when MdrCmrDone=1.</description>
                      <bitRange>[20:16]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>ACTWIDTHT_MSBS</name>
                      <description>MSBs of CmSts1.ActWidthT.  Bit locked when MdrCmrDone=1.</description>
                      <bitRange>[29:24]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CMSTS1</name>
                  <description>clk_axi cycle number of a frame. (bit locked when MdrCmrDone=1).</description>
                  <addressOffset>0x3C</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>TOTAL_TIME</name>
                      <description>clk_axi cycle number of a frame starting from vsync to another vsync.</description>
                      <bitRange>[29:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>CMSTS2</name>
                  <description>clk_axi cycle number of totwidth and actwidth of a frame. (bit locked when MdrCmrDone=1).</description>
                  <addressOffset>0x40</addressOffset>
                  <size>32</size>
                  <access>read-only</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x1FFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>TOTWIDTHT</name>
                      <description>cycle number of the total part of a video frame line for calculating pixel frame rate. LSBs contained in this field, MSBs contained in FRLineCount.TotWidthT_MSBs.</description>
                      <bitRange>[14:0]</bitRange>
                      <access>read-only</access>
                    </field>
                    <field>
                      <name>ACTWIDTHT</name>
                      <description>cycle number of the active part of a video frame line for calculating pixel frame rate. LSBs contained in this field, MSBs contained in FRLineCount.ActWidthT_MSBs.</description>
                      <bitRange>[28:15]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>ITUSTS</name>
                  <description>ITU error status register.</description>
                  <addressOffset>0x44</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0x3</resetMask>
                  <fields>
                    <field>
                      <name>ITUPROTECTIONONEBITERROR</name>
                      <description>Set if a one bit error in the reference code of the ITU capture input 0 is found and corrected. Clear by writing a 1 to this field.</description>
                      <bitRange>[0:0]</bitRange>
                      <access>read-write</access>
                    </field>
                    <field>
                      <name>ITUPROTECTIONTWOBITERROR</name>
                      <description>Set if a two bit error in the reference code of the ITU capture input 0 is found. Two bit errors can only be detected, not corrected. Clear by writing a 1 to this field.</description>
                      <bitRange>[1:1]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
              </cluster>
            </cluster>
            <cluster>
              <name>COMPENG</name>
              <description>Composition Engine</description>
              <addressOffset>0x00010000</addressOffset>
              <cluster>
                <name>COMPENGCFG</name>
                <description>Top-Level</description>
                <addressOffset>0x00000000</addressOffset>
                <register>
                  <dim>1024</dim>
                  <dimIncrement>4</dimIncrement>
                  <name>PALETTE[%s]</name>
                  <description>Shared Color Palette Memory.</description>
                  <addressOffset>0x0</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
                  <resetValue>0x0</resetValue>
                  <resetMask>0xFFFFFF</resetMask>
                  <fields>
                    <field>
                      <name>PALETTEENTRY</name>
                      <description>Shared palette entry with 24-bit. Color format can be defined by Fetch configuration.</description>
                      <bitRange>[23:0]</bitRange>
                      <access>read-write</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>EXTDST0_SAFETYMASK</name>
                  <description>Safety mask for extdst0</description>
                  <addressOffset>0x1000</addressOffset>
                  <size>32</size>
                  <access>read-write</access>
