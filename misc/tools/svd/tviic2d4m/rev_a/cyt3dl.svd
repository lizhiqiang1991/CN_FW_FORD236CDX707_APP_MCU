                        <enumeratedValue>
                          <name>BLEND</name>
                          <description>Module is in blending mode.</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAMASKENABLE</name>
                      <description>Enables Alpha Mask feature. This will limit possible output alpha values to 0 and 255. Generation of this alpha value will depend on the AlphaMaskMode field.</description>
                      <bitRange>[2:2]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>DISABLE</name>
                          <description>AlphaMask feature disabled</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>ENABLE</name>
                          <description>AlphaMask feature enabled</description>
                          <value>1</value>
                        </enumeratedValue>
                      </enumeratedValues>
                    </field>
                    <field>
                      <name>ALPHAMASKMODE</name>
                      <description>AlphaMaskMode determines how the output alpha is generated when AlphaMaskEnable is set to ENABLE</description>
                      <bitRange>[6:4]</bitRange>
                      <access>read-write</access>
                      <enumeratedValues>
                        <enumeratedValue>
                          <name>PRIM</name>
                          <description>Areas with primary input alpha &gt; 128 will be mapped to 255 and the rest will have an alpha value of 0</description>
                          <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SEC</name>
                          <description>The area of the secondary input will get an alpha value of 255 and the rest will be 0</description>
                          <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_OR_SEC</name>
                          <description>Behaves as if the output of modes PRIM and SEC would be ORed together</description>
                          <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_AND_SEC</name>
                          <description>Behaves as if the output of modes PRIM and SEC would be ANDed together</description>
                          <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_INV</name>
                          <description>Behaves as if the output of mode PRIM would be inverted</description>
                          <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>SEC_INV</name>
                          <description>Behaves as if the output of mode SEC would be inverted</description>
                          <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                          <name>PRIM_OR_SEC_INV</name>
                          <description>Behaves as if the output of modes PRIM and SEC_INV would be ORed together</description>
