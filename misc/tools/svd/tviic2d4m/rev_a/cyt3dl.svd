                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DIV1</name>
                      <description>No division</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DIV2</name>
                      <description>Divide by 2</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DIV4</name>
                      <description>Divide by 4</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DIV8</name>
                      <description>Divide by 8</description>
                      <value>3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TTLCLKINV0</name>
                  <description>Enable bit for pixel clock inversion on TTL display output interface 0. If enabled, pixel data changes with falling instead of rising clock edge (180 deg phase shift).</description>
                  <bitRange>[4:4]</bitRange>
                  <access>read-write</access>
