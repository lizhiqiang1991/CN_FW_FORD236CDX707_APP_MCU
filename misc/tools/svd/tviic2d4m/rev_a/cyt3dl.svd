                  <resetMask>0x0</resetMask>
                  <fields>
                    <field>
                      <name>LBOSOURCEPIXELRGBACOUNTER</name>
                      <description>Provides the number of processed source RGBA pixels which should be multiplied by 256. Only active in LBO and when LBOSourcePixelMeasurementEn is set. This field is updated with SaveAndResetMeasurements pulse and internal counter is reset.</description>
                      <bitRange>[31:0]</bitRange>
                      <access>read-only</access>
                    </field>
                  </fields>
                </register>
                <register>
                  <name>LBOSOURCEPIXELALPHACOUNTER</name>
